<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/users' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Kelola User',
            pageSubtitle: 'Pengelolaan akun internal, penugasan peran, dan wilayah kerja operasional.',
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/dashboard/super-admin" class="btn btn-outline-secondary">Dashboard</a>
                <a href="/users/create" class="btn btn-primary">Tambah User</a>
              </div>
            `
          }) %>

          <div class="card app-card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <strong>Daftar Pengguna Sistem</strong>
                <div class="text-muted small">Kelola status dan hak akses akun secara terpusat.</div>
              </div>
              <span class="badge text-bg-light border">Total: <%= (users || []).length %> user</span>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th class="app-col-user-id">ID</th>
                      <th>Nama Lengkap</th>
                      <th>Username</th>
                      <th class="app-col-role">Peran (Role)</th>
                      <th class="app-col-district">District</th>
                      <th class="app-col-status">Status Akun</th>
                      <th class="app-col-user-actions">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!users || users.length === 0) { %>
                      <tr>
                        <td colspan="7" class="text-center text-muted py-4">Belum ada data user terdaftar.</td>
                      </tr>
                    <% } %>

                    <% if (users && users.length > 0) { %>
                      <% users.forEach(user => { %>
                        <tr>
                          <td class="app-col-user-id font-monospace small text-muted"><%= user.id %></td>
                          <td class="fw-semibold text-dark"><%= user.full_name %></td>
                          <td><span class="font-monospace small text-secondary"><%= user.username %></span></td>
                          <td class="app-col-role">
                            <%- include('../partials/status-badge', { type: 'role', value: user.role_name }) %>
                          </td>
                          <td class="app-col-district">
                            <% if (user.region_code) { %>
                              <span class="badge text-bg-light border"><%= user.region_code %></span>
                            <% } else { %>
                              <span class="text-muted small">-</span>
                            <% } %>
                          </td>
                          <td class="app-col-status">
                            <%- include('../partials/status-badge', { type: 'user_status', value: user.is_active }) %>
                          </td>
                          <td class="app-col-user-actions">
                            <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
