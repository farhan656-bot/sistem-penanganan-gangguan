<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/users' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Kelola User',
            pageSubtitle: 'Kelola akun internal secara terpusat.',
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/dashboard/super-admin" class="btn btn-outline-secondary">Dashboard</a>
                <a href="/users/create" class="btn btn-primary">Tambah User</a>
              </div>
            `
          }) %>

          <div class="card app-card">
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 72px">ID</th>
                      <th>Nama Lengkap</th>
                      <th>Username</th>
                      <th style="width: 170px">Role</th>
                      <th style="width: 140px">District</th>
                      <th style="width: 130px">Status</th>
                      <th style="width: 120px" class="text-center">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!users || users.length === 0) { %>
                      <tr>
                        <td colspan="7" class="text-center text-muted py-4">Belum ada data user.</td>
                      </tr>
                    <% } %>

                    <% if (users && users.length > 0) { %>
                      <% users.forEach(user => { %>
                        <tr>
                          <td class="text-muted"><%= user.id %></td>
                          <td class="fw-semibold"><%= user.full_name %></td>
                          <td><span class="text-muted"><%= user.username %></span></td>
                          <td>
                            <%- include('../partials/status-badge', { type: 'role', value: user.role_name }) %>
                          </td>
                          <td><%= user.region_code || '-' %></td>
                          <td>
                            <%- include('../partials/status-badge', { type: 'user_status', value: user.is_active }) %>
                          </td>
                          <td class="text-center">
                            <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
