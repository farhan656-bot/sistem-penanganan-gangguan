<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/users/create' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Tambah User',
            pageSubtitle: 'Tambahkan akun internal sesuai role dan wilayah kerja.',
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/users" class="btn btn-outline-secondary">Kembali</a>
              </div>
            `
          }) %>

          <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
              <div class="card app-card">
                <div class="card-body">
                  <form action="/users" method="POST">
                    <div class="row g-3">
                      <div class="col-12">
                        <div class="fw-semibold">Informasi Akun</div>
                        <div class="text-muted small">Pastikan username unik dan password disimpan dengan aman.</div>
                        <hr class="my-3">
                      </div>

                      <div class="col-md-6">
                        <label class="form-label">Nama Lengkap <span class="app-required">*</span></label>
                        <input
                          type="text"
                          name="full_name"
                          class="form-control"
                          value="<%= formData.full_name %>"
                          required
                        >
                      </div>

                      <div class="col-md-6">
                        <label class="form-label">Username <span class="app-required">*</span></label>
                        <input
                          type="text"
                          name="username"
                          class="form-control"
                          value="<%= formData.username %>"
                          required
                        >
                        <div class="form-text">Gunakan format singkat dan konsisten (contoh: nama.tlkm).</div>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label">Password <span class="app-required">*</span></label>
                        <input type="password" name="password" class="form-control" required>
                        <div class="form-text">Minimal 1 karakter sesuai aturan existing. Disarankan gunakan password kuat.</div>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label">Role <span class="app-required">*</span></label>
                        <select name="role_id" class="form-select" required>
                          <option value="">Pilih role</option>
                          <% roles.forEach(role => { %>
                            <option
                              value="<%= role.id %>"
                              <%= String(formData.role_id) === String(role.id) ? 'selected' : '' %>
                            >
                              <%= role.name %>
                            </option>
                          <% }) %>
                        </select>
                        <div class="form-text">Pastikan role sesuai kebutuhan operasional.</div>
                      </div>

                      <div class="col-12">
                        <div class="fw-semibold mt-2">Wilayah Kerja</div>
                        <div class="text-muted small">Wilayah digunakan untuk pembatasan akses eksekutor.</div>
                        <hr class="my-3">
                      </div>

                      <div class="col-md-8">
                        <label class="form-label">District/Region</label>
                        <select name="region_id" class="form-select">
                          <option value="">Tidak dipilih</option>
                          <% regions.forEach(region => { %>
                            <option
                              value="<%= region.id %>"
                              <%= String(formData.region_id) === String(region.id) ? 'selected' : '' %>
                            >
                              <%= region.code %> - <%= region.name %>
                            </option>
                          <% }) %>
                        </select>
                        <div class="form-text">Wajib untuk role <span class="fw-semibold">eksekutor</span>. Untuk role lain, biarkan kosong.</div>
                      </div>
                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                      <button type="submit" class="btn btn-primary">Simpan User</button>
                      <a href="/users" class="btn btn-outline-secondary">Batal</a>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
