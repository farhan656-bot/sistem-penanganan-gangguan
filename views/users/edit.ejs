<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/users' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Edit User',
            pageSubtitle: `Perbarui data akun internal (ID: ${user && user.id ? user.id : '-' }).`,
            pageActions: `
              <a href="/users" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
              <div class="card app-card">
                <div class="card-body">
                  <form action="/users/<%= user.id %>/update" method="POST">
                    <div class="row g-3">
                      <div class="col-12">
                        <div class="fw-semibold">Informasi Akun</div>
                        <div class="text-muted small">Password baru bersifat opsional. Jika kosong, password tidak berubah.</div>
                        <hr class="my-3">
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">Nama Lengkap <span class="app-required">*</span></label>
                        <input type="text" name="full_name" class="form-control" value="<%= user.full_name %>" required>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">Username <span class="app-required">*</span></label>
                        <input type="text" name="username" class="form-control" value="<%= user.username %>" required>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">Password Baru (opsional)</label>
                        <input type="password" name="password" class="form-control">
                        <div class="form-text">Biarkan kosong jika tidak ingin mengubah password.</div>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">Role <span class="app-required">*</span></label>
                        <select name="role_id" class="form-select" required>
                          <% roles.forEach(role => { %>
                            <option
                              value="<%= role.id %>"
                              <%= Number(user.role_id) === Number(role.id) ? 'selected' : '' %>
                            >
                              <%= role.name %>
                            </option>
                          <% }) %>
                        </select>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">District/Region</label>
                        <select name="region_id" class="form-select">
                          <option value="">Tidak dipilih</option>
                          <% regions.forEach(region => { %>
                            <option
                              value="<%= region.id %>"
                              <%= Number(user.region_id) === Number(region.id) ? 'selected' : '' %>
                            >
                              <%= region.code %> - <%= region.name %>
                            </option>
                          <% }) %>
                        </select>
                        <div class="form-text">Wajib untuk role eksekutor.</div>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label">Status Akun <span class="app-required">*</span></label>
                        <select name="is_active" class="form-select" required>
                          <option value="1" <%= Number(user.is_active) === 1 ? 'selected' : '' %>>Aktif</option>
                          <option value="0" <%= Number(user.is_active) === 0 ? 'selected' : '' %>>Nonaktif</option>
                        </select>
                      </div>
                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                      <a href="/users" class="btn btn-outline-secondary">Batal</a>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
