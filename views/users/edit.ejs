<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/users' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Edit Data User',
            pageSubtitle: `Perbarui konfigurasi akun, peran, dan status akses untuk User ID: ${user && user.id ? user.id : '-'}.`,
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/users" class="btn btn-outline-secondary">Kembali</a>
              </div>
            `
          }) %>

          <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
              <div class="card app-card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <strong>Form Pembaruan Akun</strong>
                    <div class="text-muted small">ID Pengguna: <%= user && user.id ? user.id : '-' %></div>
                  </div>
                  <div>
                    <%- include('../partials/status-badge', { type: 'user_status', value: user.is_active }) %>
                  </div>
                </div>
                <div class="card-body">
                  <form action="/users/<%= user.id %>/update" method="POST">
                    <div class="row g-3">
                      <!-- Subseksi 1: Kredensial & Identitas -->
                      <div class="col-12">
                        <div class="fw-semibold text-dark">Informasi Akun & Kredensial</div>
                        <div class="text-muted small">Pembaruan password bersifat opsional. Biarkan kosong jika tidak diubah.</div>
                        <hr class="my-2">
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="fullNameInput">
                          Nama Lengkap <span class="app-required">*</span>
                        </label>
                        <input
                          type="text"
                          id="fullNameInput"
                          name="full_name"
                          class="form-control"
                          value="<%= user.full_name %>"
                          required
                        >
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="usernameInput">
                          Username <span class="app-required">*</span>
                        </label>
                        <input
                          type="text"
                          id="usernameInput"
                          name="username"
                          class="form-control font-monospace"
                          value="<%= user.username %>"
                          required
                        >
                        <div class="form-text">Username digunakan saat login ke aplikasi.</div>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="passwordInput">
                          Password Baru (Opsional)
                        </label>
                        <input
                          type="password"
                          id="passwordInput"
                          name="password"
                          class="form-control"
                          placeholder="Kosongkan jika tidak diubah"
                        >
                        <div class="form-text">Biarkan kosong jika tidak ingin mengubah password lama.</div>
                      </div>

                      <!-- Subseksi 2: Otorisasi & Status Akun -->
                      <div class="col-12 mt-4">
                        <div class="fw-semibold text-dark">Otorisasi & Status Akses</div>
                        <div class="text-muted small">Atur hak akses peran, wilayah penugasan, dan keaktifan akun.</div>
                        <hr class="my-2">
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="roleIdSelect">
                          Peran (Role) <span class="app-required">*</span>
                        </label>
                        <select id="roleIdSelect" name="role_id" class="form-select" required>
                          <% roles.forEach(role => { %>
                            <option
                              value="<%= role.id %>"
                              <%= Number(user.role_id) === Number(role.id) ? 'selected' : '' %>
                            >
                              <%= role.name %>
                            </option>
                          <% }) %>
                        </select>
                        <div class="form-text">Peran menentukan menu dan aksi operasional tiket.</div>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="regionIdSelect">
                          District / Wilayah Kerja
                        </label>
                        <select id="regionIdSelect" name="region_id" class="form-select">
                          <option value="">Tidak dipilih (Umum / Non-Eksekutor)</option>
                          <% regions.forEach(region => { %>
                            <option
                              value="<%= region.id %>"
                              <%= Number(user.region_id) === Number(region.id) ? 'selected' : '' %>
                            >
                              <%= region.code %> - <%= region.name %>
                            </option>
                          <% }) %>
                        </select>
                        <div class="form-text">
                          Wajib untuk peran <span class="fw-semibold text-dark">eksekutor</span>.
                        </div>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="isActiveSelect">
                          Status Akun <span class="app-required">*</span>
                        </label>
                        <select id="isActiveSelect" name="is_active" class="form-select" required>
                          <option value="1" <%= Number(user.is_active) === 1 ? 'selected' : '' %>>Aktif</option>
                          <option value="0" <%= Number(user.is_active) === 0 ? 'selected' : '' %>>Nonaktif</option>
                        </select>
                        <div class="form-text">Akun nonaktif tidak diizinkan untuk login ke sistem.</div>
                      </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                      <a href="/users" class="btn btn-outline-secondary">Batal</a>
                      <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
