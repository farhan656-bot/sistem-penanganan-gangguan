<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const reportStatusOptions = Array.isArray(reportStatuses) ? reportStatuses : [];
    const safeReportStatusOptions = reportStatusOptions.filter((st) => String(st || '').toLowerCase() !== 'baru');
    function statusLabel(value) {
      if (String(value || '').toLowerCase() === 'baru') return '-';
      return (statusLabelMap && statusLabelMap[value]) ? statusLabelMap[value] : (value || '-');
    }

    const selectedFilters = filters || {};
    const periodLabelMap = {
      all: 'Semua',
      today: 'Hari ini',
      this_week: 'Minggu ini',
      last_7_days: '7 hari terakhir',
      this_month: 'Bulan ini',
      custom: 'Custom'
    };

    const selectedRegion = (regions || []).find((r) => String(r.id) === String(selectedFilters.regionId));
    const activePeriodLabel = periodLabelMap[selectedFilters.period] || 'Semua';
    const activeRegionLabel = selectedRegion ? `${selectedRegion.code} - ${selectedRegion.name}` : 'Semua District';
    const activeStatusLabel = (selectedFilters.status && selectedFilters.status !== 'all')
      ? statusLabel(selectedFilters.status)
      : 'Semua Status';
    const showCustomRange = selectedFilters.period === 'custom' && (selectedFilters.startDate || selectedFilters.endDate);
  %>

  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/supervisor' }) %>

    <div class="app-main">
      <% const realAttentionCount = (Number(summary.total_follow_up) || 0) + (Number(summary.total_escalated) || 0); %>
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Supervisor', attentionTicketsCount: realAttentionCount }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Supervisor',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}.`
          }) %>

          <!-- Section 1: Dashboard Ringkasan & Metrik SLA -->
          <section id="dashboard-ringkasan" class="supervisor-section app-anchor-section" aria-hidden="false">
            <!-- Filter Card -->
            <div class="card app-card mb-3">
              <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 pb-2 border-bottom">
                  <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                    <i class="bi bi-funnel text-primary"></i>
                    <span>Filter Pemantauan Operasional</span>
                  </div>
                  <% if (selectedFilters.period !== 'all' || selectedFilters.regionId || (selectedFilters.status && selectedFilters.status !== 'all')) { %>
                    <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">Filter Kustom Aktif</span>
                  <% } else { %>
                    <span class="badge text-bg-light border text-secondary" style="font-size: 0.7rem;">Semua Data</span>
                  <% } %>
                </div>

                <form class="row g-2 align-items-end" method="GET" action="/dashboard/supervisor">
                  <div class="col-12 col-sm-6 col-xl-2">
                    <label class="form-label small fw-semibold text-secondary mb-1" for="filterPeriod">Periode</label>
                    <select class="form-select form-select-sm" name="period" id="filterPeriod">
                      <option value="all" <%= selectedFilters.period === 'all' ? 'selected' : '' %>>Semua Periode</option>
                      <option value="today" <%= selectedFilters.period === 'today' ? 'selected' : '' %>>Hari ini</option>
                      <option value="this_week" <%= selectedFilters.period === 'this_week' ? 'selected' : '' %>>Minggu ini</option>
                      <option value="last_7_days" <%= selectedFilters.period === 'last_7_days' ? 'selected' : '' %>>7 hari terakhir</option>
                      <option value="this_month" <%= selectedFilters.period === 'this_month' ? 'selected' : '' %>>Bulan ini</option>
                      <option value="custom" <%= selectedFilters.period === 'custom' ? 'selected' : '' %>>Custom Tanggal</option>
                    </select>
                  </div>

                  <div class="col-6 col-sm-3 col-xl-2">
                    <label class="form-label small fw-semibold text-secondary mb-1" for="filterStartDate">Mulai</label>
                    <input type="date" class="form-control form-control-sm" name="startDate" id="filterStartDate" value="<%= selectedFilters.startDate || '' %>">
                  </div>

                  <div class="col-6 col-sm-3 col-xl-2">
                    <label class="form-label small fw-semibold text-secondary mb-1" for="filterEndDate">Sampai</label>
                    <input type="date" class="form-control form-control-sm" name="endDate" id="filterEndDate" value="<%= selectedFilters.endDate || '' %>">
                  </div>

                  <div class="col-12 col-sm-6 col-xl-2">
                    <label class="form-label small fw-semibold text-secondary mb-1" for="filterRegionId">Wilayah (District)</label>
                    <select class="form-select form-select-sm" name="regionId" id="filterRegionId">
                      <option value="">Semua District</option>
                      <% (regions || []).forEach(region => { %>
                        <option value="<%= region.id %>" <%= String(selectedFilters.regionId) === String(region.id) ? 'selected' : '' %>>
                          <%= region.code %> - <%= region.name %>
                        </option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="col-12 col-sm-6 col-xl-2">
                    <label class="form-label small fw-semibold text-secondary mb-1" for="filterStatus">Status Tiket</label>
                    <select class="form-select form-select-sm" name="status" id="filterStatus">
                      <option value="all" <%= (selectedFilters.status || 'all') === 'all' ? 'selected' : '' %>>Semua Status</option>
                      <% safeReportStatusOptions.forEach(st => { %>
                        <option value="<%= st %>" <%= (selectedFilters.status || 'all') === st ? 'selected' : '' %>>
                          <%= statusLabel(st) %>
                        </option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="col-12 col-xl-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                      <i class="bi bi-funnel-fill"></i>Terapkan
                    </button>
                    <a href="/dashboard/supervisor" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-3" title="Reset filter">
                      <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                  </div>
                </form>
              </div>
            </div>

            <!-- Group A: Prioritas Kinerja Penanganan Gangguan (SLA & Efektivitas) -->
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Rata-rata Waktu Respons</span>
                      <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle font-monospace" title="Mean Time to Acknowledge">MTTA</span>
                    </div>
                    <div class="fs-4 fw-bold text-dark mb-1"><%= summary.avg_response %></div>
                    <div class="supervisor-kpi-subtext text-muted small">Waktu penerimaan hingga penanganan</div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-sm-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Rata-rata Waktu Penyelesaian</span>
                      <span class="badge text-bg-success-subtle text-success border border-success-subtle font-monospace" title="Mean Time to Resolve">MTTR</span>
                    </div>
                    <div class="fs-4 fw-bold text-dark mb-1"><%= summary.avg_resolution %></div>
                    <div class="supervisor-kpi-subtext text-muted small">Waktu penanganan hingga tiket selesai</div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-sm-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Tingkat Penyelesaian</span>
                      <span class="badge text-bg-success-subtle text-success border border-success-subtle">Rasio</span>
                    </div>
                    <div class="fs-4 fw-bold text-status-completed mb-1"><%= Number(summary.completion_rate || 0).toFixed(2) %>%</div>
                    <div class="supervisor-kpi-subtext text-muted small">Persentase tiket berstatus selesai</div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-sm-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Backlog Aktif</span>
                      <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle">Antrean</span>
                    </div>
                    <div class="fs-4 fw-bold text-dark mb-1"><%= summary.active_backlog %></div>
                    <div class="supervisor-kpi-subtext text-muted small">Tersedia + Diproses + TL + Eskalasi</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Group B: Distribusi Volume dan Status Operasional (Konsol Terpadu) -->
            <div class="card app-card mb-3">
              <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                  <i class="bi bi-stack text-primary"></i>
                  <span>Distribusi Volume Status Laporan</span>
                </div>
                <span class="badge text-bg-light border text-secondary font-monospace" style="font-size: 0.72rem;">Total: <%= summary.total_reports %> Tiket</span>
              </div>
              <div class="card-body p-0">
                <div class="row g-0 text-center">
                  <div class="col-6 col-sm-4 col-xl-2 border-end border-bottom border-xl-bottom-0">
                    <a href="/reports?work_status=all" class="app-kpi-item" title="Buka seluruh antrean laporan">
                      <span class="app-kpi-label">Total Laporan</span>
                      <span class="app-kpi-value text-dark"><%= summary.total_reports %></span>
                      <span class="app-kpi-subtext">Semua status</span>
                    </a>
                  </div>

                  <div class="col-6 col-sm-4 col-xl-2 border-end-0 border-sm-end border-bottom border-xl-bottom-0">
                    <a href="/reports?work_status=available" class="app-kpi-item" title="Buka tiket tersedia">
                      <span class="app-kpi-label">Tersedia</span>
                      <span class="app-kpi-value text-status-available"><%= summary.total_available %></span>
                      <span class="app-kpi-subtext">Menunggu tim</span>
                    </a>
                  </div>

                  <div class="col-6 col-sm-4 col-xl-2 border-end border-sm-end-0 border-xl-end border-bottom border-xl-bottom-0">
                    <a href="/reports?work_status=in_progress" class="app-kpi-item" title="Buka tiket sedang ditangani">
                      <span class="app-kpi-label">Sedang Ditangani</span>
                      <span class="app-kpi-value text-status-in-progress"><%= summary.total_in_progress %></span>
                      <span class="app-kpi-subtext">Diambil / delegasi</span>
                    </a>
                  </div>

                  <div class="col-6 col-sm-4 col-xl-2 border-end-0 border-sm-end border-bottom border-sm-bottom-0 border-xl-bottom-0">
                    <a href="/reports?work_status=completed" class="app-kpi-item" title="Buka tiket selesai">
                      <span class="app-kpi-label">Selesai</span>
                      <span class="app-kpi-value text-status-completed"><%= summary.total_completed %></span>
                      <span class="app-kpi-subtext">Tuntas ditangani</span>
                    </a>
                  </div>

                  <div class="col-6 col-sm-4 col-xl-2 border-end border-bottom border-sm-bottom-0 border-xl-bottom-0">
                    <a href="/reports?work_status=follow_up" class="app-kpi-item" title="Buka tiket perlu tindak lanjut">
                      <span class="app-kpi-label">Tindak Lanjut</span>
                      <span class="app-kpi-value text-status-follow-up"><%= summary.total_follow_up %></span>
                      <span class="app-kpi-subtext">Perlu perbaikan</span>
                    </a>
                  </div>

                  <div class="col-6 col-sm-4 col-xl-2">
                    <a href="/reports?work_status=escalated" class="app-kpi-item" title="Buka tiket eskalasi">
                      <span class="app-kpi-label">Eskalasi</span>
                      <span class="app-kpi-value text-status-escalated"><%= summary.total_escalated %></span>
                      <span class="app-kpi-subtext">Kendala DIIT</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Group C: Visualisasi Grafik Chart.js -->
            <div class="row g-3 mb-3">
              <div class="col-12 col-xl-5">
                <div class="card app-card h-100">
                  <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                    <strong class="text-dark small fw-semibold">
                      <i class="bi bi-pie-chart text-primary me-1"></i>Grafik Status Tiket
                    </strong>
                    <span class="badge text-bg-light border text-secondary" style="font-size: 0.72rem;">Proporsi</span>
                  </div>
                  <div class="card-body d-flex flex-column p-3">
                    <div class="supervisor-chart-container flex-grow-1">
                      <canvas id="statusChart"></canvas>
                    </div>
                    <% if (!charts || !charts.status || !charts.status.labels || charts.status.labels.length === 0) { %>
                      <div class="text-muted small text-center py-2">Belum ada data untuk ditampilkan.</div>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="col-12 col-xl-7">
                <div class="card app-card h-100">
                  <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                    <strong class="text-dark small fw-semibold">
                      <i class="bi bi-graph-up text-danger me-1"></i>Grafik Tren Laporan (Harian)
                    </strong>
                    <span class="badge text-bg-light border text-secondary" style="font-size: 0.72rem;">Aktivitas Masuk</span>
                  </div>
                  <div class="card-body d-flex flex-column p-3">
                    <div class="supervisor-chart-container flex-grow-1">
                      <canvas id="trendChart"></canvas>
                    </div>
                    <% if (!charts || !charts.trend || !charts.trend.labels || charts.trend.labels.length === 0) { %>
                      <div class="text-muted small text-center py-2">Belum ada data untuk ditampilkan.</div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 2: Analisis Wilayah -->
          <section id="analisis-wilayah" class="supervisor-section app-anchor-section d-none" aria-hidden="true">
            <!-- Filter Bar Analisis Wilayah: Hari Ini, Minggu Ini, Bulan Ini, Custom -->
            <div class="card app-card mb-3">
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <strong class="text-dark small fw-semibold">Rentang Waktu:</strong>
                    <span class="badge text-bg-light border text-secondary font-monospace" style="font-size: 0.72rem;">
                      <%= activePeriodLabel %><%= showCustomRange ? ` (${selectedFilters.startDate} s/d ${selectedFilters.endDate})` : '' %>
                    </span>
                  </div>
                  <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Filter Periode Analisis Wilayah">
                      <a href="/dashboard/supervisor?period=today#analisis-wilayah" class="btn btn-outline-secondary <%= selectedFilters.period === 'today' ? 'active fw-semibold' : '' %>">
                        Hari Ini
                      </a>
                      <a href="/dashboard/supervisor?period=this_week#analisis-wilayah" class="btn btn-outline-secondary <%= (selectedFilters.period === 'this_week' || selectedFilters.period === 'last_7_days') ? 'active fw-semibold' : '' %>">
                        Minggu Ini
                      </a>
                      <a href="/dashboard/supervisor?period=this_month#analisis-wilayah" class="btn btn-outline-secondary <%= selectedFilters.period === 'this_month' ? 'active fw-semibold' : '' %>">
                        Bulan Ini
                      </a>
                      <button type="button" class="btn btn-outline-secondary <%= selectedFilters.period === 'custom' ? 'active fw-semibold' : '' %>" data-bs-toggle="collapse" data-bs-target="#customDateFilterCollapseWilayah" aria-expanded="<%= selectedFilters.period === 'custom' ? 'true' : 'false' %>">
                        <i class="bi bi-calendar-range me-1"></i>Custom
                      </button>
                    </div>
                    <% if (selectedFilters.period && selectedFilters.period !== 'all') { %>
                      <a href="/dashboard/supervisor?period=all#analisis-wilayah" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Tampilkan Semua Periode" style="font-size: 0.75rem;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Semua
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Collapse Panel untuk Filter Tanggal Custom -->
              <div class="collapse <%= selectedFilters.period === 'custom' ? 'show' : '' %> bg-light border-top px-3 py-2" id="customDateFilterCollapseWilayah">
                <form action="/dashboard/supervisor#analisis-wilayah" method="GET" class="row g-2 align-items-center" id="customPeriodFormWilayah">
                  <input type="hidden" name="period" value="custom">
                  <% if (selectedFilters.status && selectedFilters.status !== 'all') { %>
                    <input type="hidden" name="status" value="<%= selectedFilters.status %>">
                  <% } %>
                  <div class="col-auto">
                    <label for="startDateInputWilayah" class="col-form-label col-form-label-sm fw-medium text-secondary">Mulai:</label>
                  </div>
                  <div class="col-auto">
                    <input type="date" id="startDateInputWilayah" name="startDate" class="form-control form-control-sm" value="<%= selectedFilters.startDate || '' %>" required>
                  </div>
                  <div class="col-auto">
                    <label for="endDateInputWilayah" class="col-form-label col-form-label-sm fw-medium text-secondary">Sampai:</label>
                  </div>
                  <div class="col-auto">
                    <input type="date" id="endDateInputWilayah" name="endDate" class="form-control form-control-sm" value="<%= selectedFilters.endDate || '' %>" required>
                  </div>
                  <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
                      <i class="bi bi-funnel-fill"></i>Terapkan
                    </button>
                    <a href="/dashboard/supervisor?period=all#analisis-wilayah" class="btn btn-sm btn-outline-secondary">
                      Batal
                    </a>
                  </div>
                </form>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-xl-5">
                <div class="card app-card h-100">
                  <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-bar-chart-steps text-primary"></i>
                      <strong class="text-dark small fw-semibold">Grafik Perbandingan District</strong>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Mode Tampilan Grafik">
                      <button type="button" class="btn btn-sm btn-outline-secondary active py-0 px-2" id="btnRegionTotal" style="font-size: 0.75rem;">
                        <i class="bi bi-bar-chart me-1"></i>Total Volume
                      </button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btnRegionStatus" style="font-size: 0.75rem;">
                        <i class="bi bi-stack me-1"></i>Komposisi Status
                      </button>
                    </div>
                  </div>
                  <div class="card-body d-flex flex-column p-3">
                    <%
                      const sortedRegionsByVolume = (regionSummary || []).slice().sort((a, b) => (Number(b.total_reports) || 0) - (Number(a.total_reports) || 0));
                      const topRegion = sortedRegionsByVolume[0];
                    %>
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom text-muted small">
                      <span><i class="bi bi-geo-alt text-primary me-1"></i>Wilayah Tertinggi: <strong class="text-dark"><%= topRegion ? ((topRegion.region_name || topRegion.region_code) + ' (' + topRegion.total_reports + ' tiket)') : '-' %></strong></span>
                      <span>Total: <strong class="text-dark"><%= summary.total_reports %> Tiket</strong></span>
                    </div>
                    <div class="supervisor-chart-container flex-grow-1" style="min-height: 220px;">
                      <canvas id="regionComparisonChart"></canvas>
                    </div>
                    <% if (!charts || !charts.regionComparison || !charts.regionComparison.labels || charts.regionComparison.labels.length === 0) { %>
                      <div class="text-muted small text-center py-2">Belum ada data untuk ditampilkan.</div>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="col-12 col-xl-7">
                <div class="card app-card h-100">
                  <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                    <strong class="text-dark small fw-semibold">
                      <i class="bi bi-table text-primary me-1"></i>Rekap per Wilayah
                    </strong>
                    <span class="badge text-bg-light border text-secondary" style="font-size: 0.72rem;">Agregat Status</span>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                          <tr>
                            <th>Wilayah</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Tersedia</th>
                            <th class="text-center">Diproses</th>
                            <th class="text-center">Selesai</th>
                            <th class="text-center">Tindak Lanjut</th>
                            <th class="text-center">Eskalasi</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (regionSummary.length === 0) { %>
                            <tr>
                              <td colspan="7" class="text-center text-muted py-4">Belum ada data rekap per wilayah.</td>
                            </tr>
                          <% } %>

                          <% regionSummary.forEach(region => { %>
                            <tr>
                              <td class="fw-semibold">
                                <span><%= region.region_code %></span>
                                <% if (region.region_name) { %>
                                  <span class="text-muted fw-normal small ms-1">(<%= region.region_name %>)</span>
                                <% } %>
                              </td>
                              <td class="text-center fw-bold"><%= region.total_reports %></td>
                              <td class="text-center text-status-available fw-semibold"><%= region.total_available %></td>
                              <td class="text-center text-status-in-progress fw-semibold"><%= region.total_in_progress %></td>
                              <td class="text-center text-status-completed fw-semibold"><%= region.total_completed %></td>
                              <td class="text-center text-status-follow-up fw-semibold"><%= region.total_follow_up %></td>
                              <td class="text-center text-status-escalated fw-semibold"><%= region.total_escalated %></td>
                            </tr>
                          <% }) %>
                        </tbody>
                        <tfoot class="table-light fw-semibold small">
                          <tr>
                            <td>Total Seluruh Wilayah</td>
                            <td class="text-center text-dark fw-bold"><%= summary.total_reports %></td>
                            <td class="text-center text-status-available"><%= summary.total_available %></td>
                            <td class="text-center text-status-in-progress"><%= summary.total_in_progress %></td>
                            <td class="text-center text-status-completed"><%= summary.total_completed %></td>
                            <td class="text-center text-status-follow-up"><%= summary.total_follow_up %></td>
                            <td class="text-center text-status-escalated"><%= summary.total_escalated %></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 3: Kinerja Eksekutor -->
          <section id="kinerja-eksekutor" class="supervisor-section app-anchor-section d-none" aria-hidden="true">
            <div class="row g-3">
              <div class="col-12">
                <div class="card app-card">
                  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <div>
                      <strong class="text-dark">Rekap Kinerja Pegawai Eksekutor</strong>
                      <div class="text-muted small">Produktivitas dan rata-rata waktu penyelesaian</div>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                      <!-- Button Region Filter: Semua, PDG, BKT -->
                      <div class="btn-group btn-group-sm" role="group" aria-label="Filter Wilayah Eksekutor">
                        <button type="button" class="btn btn-outline-secondary active" data-eksekutor-region-filter="all" id="btnEksekutorRegionAll">
                          Semua
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-eksekutor-region-filter="PDG" id="btnEksekutorRegionPDG">
                          PDG
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-eksekutor-region-filter="BKT" id="btnEksekutorRegionBKT">
                          BKT
                        </button>
                      </div>

                      <!-- Search Input: Nama Pegawai -->
                      <div class="input-group input-group-sm" style="max-width: 240px;">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                          <i class="bi bi-search"></i>
                        </span>
                        <input
                          type="text"
                          class="form-control form-control-sm border-start-0"
                          id="searchEksekutorInput"
                          placeholder="Cari nama pegawai..."
                          autocomplete="off"
                          aria-label="Cari nama pegawai eksekutor"
                        >
                        <button class="btn btn-outline-secondary d-none" type="button" id="clearSearchEksekutorBtn" title="Reset pencarian" aria-label="Reset pencarian">
                          <i class="bi bi-x-lg" style="font-size: 0.75rem;"></i>
                        </button>
                      </div>

                      <!-- Count Badge -->
                      <span class="badge text-bg-light border text-secondary font-monospace" id="eksekutorCountBadge" style="font-size: 0.72rem;">
                        <%= userPerformance.length %> Pegawai
                      </span>
                    </div>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0" id="eksekutorPerformanceTable">
                        <thead>
                          <tr>
                            <th class="app-col-num">No</th>
                            <th>Nama Pegawai</th>
                            <th>Wilayah</th>
                            <th class="text-center">Total Ditangani</th>
                            <th class="text-center">Total Selesai</th>
                            <th>Rata-rata Waktu Penyelesaian</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (userPerformance.length === 0) { %>
                            <tr id="emptyEksekutorRow">
                              <td colspan="6" class="text-center text-muted py-4">Belum ada data kinerja pegawai eksekutor.</td>
                            </tr>
                          <% } %>

                          <% userPerformance.forEach((user, index) => { %>
                            <tr class="eksekutor-row" data-name="<%= (user.full_name || '').toLowerCase() %>" data-region="<%= (user.region_code || '').toUpperCase() %>">
                              <td class="app-col-num text-muted"><%= index + 1 %></td>
                              <td class="fw-semibold text-dark"><%= user.full_name %></td>
                              <td><span class="badge text-bg-light border font-monospace"><%= user.region_code || '-' %></span></td>
                              <td class="text-center"><%= user.total_handled %></td>
                              <td class="text-center text-status-completed fw-semibold"><%= user.total_completed %></td>
                              <td><span class="text-secondary"><%= formatMinutes(user.avg_resolution_minutes) %></span></td>
                            </tr>
                          <% }) %>

                          <tr id="noMatchEksekutorRow" class="d-none">
                            <td colspan="6" class="text-center text-muted py-4">
                              <div class="d-flex flex-column align-items-center gap-1">
                                <i class="bi bi-person-x text-muted fs-3"></i>
                                <span>Pegawai dengan kriteria "<strong id="noMatchQuery"></strong>" tidak ditemukan.</span>
                              </div>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div class="card-footer bg-white border-top p-0" id="eksekutorPaginationFooter">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 p-3 pt-2">
                      <div class="small text-muted" id="eksekutorPaginationInfo">
                        Menampilkan <strong>1&ndash;10</strong> dari <strong><%= (userPerformance || []).length %></strong> pegawai
                      </div>
                      <nav aria-label="Navigasi halaman rekap kinerja eksekutor">
                        <ul class="pagination pagination-sm mb-0 flex-wrap" id="eksekutorPaginationList">
                          <!-- Terisi otomatis oleh JavaScript -->
                        </ul>
                      </nav>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 4: Tiket Perlu Perhatian -->
          <section id="tiket-perlu-perhatian" class="supervisor-section app-anchor-section d-none" aria-hidden="true">
            <div class="row g-3">
              <div class="col-12">
                <div class="card app-card">
                  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <div>
                      <strong class="text-dark">Tiket Perlu Perhatian</strong>
                      <div class="text-muted small">Prioritas pengawasan: tiket berstatus Perlu Tindak Lanjut &amp; Eskalasi (read-only)</div>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                      <!-- Button Region Filter: Semua, PDG, BKT -->
                      <div class="btn-group btn-group-sm" role="group" aria-label="Filter Wilayah Tiket Perlu Perhatian">
                        <button type="button" class="btn btn-outline-secondary active" data-attention-region-filter="all" id="btnAttentionRegionAll">
                          Semua
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-attention-region-filter="PDG" id="btnAttentionRegionPDG">
                          PDG
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-attention-region-filter="BKT" id="btnAttentionRegionBKT">
                          BKT
                        </button>
                      </div>

                      <!-- Count Badge -->
                      <span class="badge text-bg-light border text-secondary font-monospace" id="attentionTicketsCountBadge" style="font-size: 0.72rem;">
                        Total: <%= (attentionTickets || []).length %> Tiket
                      </span>
                    </div>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0" id="attentionTicketsTable">
                        <thead class="table-light">
                          <tr>
                            <th class="app-col-num">No</th>
                            <th>Ticket ID</th>
                            <th>Order ID</th>
                            <th>Ringkasan</th>
                            <th>Wilayah</th>
                            <th>Status</th>
                            <th>Eksekutor</th>
                            <th class="app-col-time">Diterima</th>
                            <th class="app-table-actions">Aksi</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr id="emptyAttentionRow" style="<%= (!attentionTickets || attentionTickets.length === 0) ? '' : 'display: none;' %>">
                            <td colspan="9" class="text-center text-muted py-4">Tidak ada tiket perlu perhatian pada filter ini.</td>
                          </tr>

                          <tr id="noMatchAttentionRow" class="d-none">
                            <td colspan="9" class="text-center text-muted py-4">
                              <i class="bi bi-funnel me-1"></i> Tidak ada tiket perlu perhatian untuk wilayah yang dipilih.
                            </td>
                          </tr>

                          <% (attentionTickets || []).forEach((ticket, index) => { %>
                            <tr class="attention-ticket-row" data-region="<%= (ticket.region_code || '').toUpperCase() %>">
                              <td class="app-col-num text-muted"><%= index + 1 %></td>
                              <td><span class="font-monospace small fw-semibold"><%= ticket.ticket_id || '-' %></span></td>
                              <td><span class="font-monospace small text-muted"><%= ticket.order_id || '-' %></span></td>
                              <td>
                                <div class="app-truncate-lg" title="<%= ticket.summary || '-' %>">
                                  <%= ticket.summary || '-' %>
                                </div>
                              </td>
                              <td><span class="badge text-bg-light border font-monospace"><%= ticket.region_code || '-' %></span></td>
                              <td>
                                <%- include('../partials/status-badge', { type: 'ticket', value: ticket.status_internal }) %>
                              </td>
                              <td><%= ticket.assigned_user_name || '-' %></td>
                              <td class="app-col-time text-muted small"><%= formatDateTime(ticket.received_at) %></td>
                              <td class="app-table-actions">
                                <a
                                  href="/reports/<%= ticket.ticket_id %>"
                                  class="btn btn-sm btn-outline-secondary"
                                  data-report-detail-url="/reports/<%= ticket.ticket_id %>/detail-json"
                                >Detail</a>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div class="card-footer bg-white border-top p-0" id="attentionPaginationFooter">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 p-3 pt-2">
                      <div class="small text-muted" id="attentionPaginationInfo">
                        Menampilkan <strong>1&ndash;10</strong> dari <strong><%= (attentionTickets || []).length %></strong> tiket
                      </div>
                      <nav aria-label="Navigasi halaman tiket perlu perhatian">
                        <ul class="pagination pagination-sm mb-0 flex-wrap" id="attentionPaginationList">
                          <!-- Terisi otomatis oleh JavaScript -->
                        </ul>
                      </nav>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 5: Riwayat Region Switch -->
          <section id="riwayat-region-switch" class="supervisor-section app-anchor-section d-none" aria-hidden="true">
            <div class="row g-3">
              <div class="col-12">
                <div class="card app-card">
                  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <div>
                      <strong class="text-dark">Riwayat Temporary Region Switch</strong>
                      <div class="text-muted small">Informasi pemantauan perbantuan teknisi lintas wilayah</div>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                      <!-- Filter Button Region: Semua, PDG, BKT -->
                      <div class="btn-group btn-group-sm" role="group" aria-label="Filter Wilayah Switch">
                        <button type="button" class="btn btn-outline-secondary active" data-region-switch-filter="all" id="btnRegionSwitchAll">
                          Semua
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-region-switch-filter="PDG" id="btnRegionSwitchPDG">
                          PDG
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-region-switch-filter="BKT" id="btnRegionSwitchBKT">
                          BKT
                        </button>
                      </div>

                      <!-- Search Input: Nama Pegawai -->
                      <div class="input-group input-group-sm" style="max-width: 240px;">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                          <i class="bi bi-search"></i>
                        </span>
                        <input
                          type="text"
                          class="form-control form-control-sm border-start-0"
                          id="searchRegionSwitchInput"
                          placeholder="Cari nama pegawai..."
                          autocomplete="off"
                          aria-label="Cari nama pegawai eksekutor"
                        >
                        <button class="btn btn-outline-secondary d-none" type="button" id="clearSearchRegionSwitchBtn" title="Reset pencarian" aria-label="Reset pencarian">
                          <i class="bi bi-x-lg" style="font-size: 0.75rem;"></i>
                        </button>
                      </div>

                      <!-- Count Badge -->
                      <span class="badge text-bg-light border text-secondary font-monospace" id="regionSwitchCountBadge" style="font-size: 0.72rem;">
                        Total: <%= (regionSwitchHistory || []).length %> Riwayat
                      </span>
                    </div>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0" id="regionSwitchTable">
                        <thead class="table-light">
                          <tr>
                            <th class="app-col-num">No</th>
                            <th>Eksekutor</th>
                            <th>Asal</th>
                            <th>Tujuan</th>
                            <th>Status</th>
                            <th>Alasan / Keterangan</th>
                            <th class="app-col-time">Diajukan</th>
                            <th class="app-col-time">Disetujui</th>
                            <th class="app-col-time">Berakhir</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr id="emptyRegionSwitchRow" style="<%= (!regionSwitchHistory || regionSwitchHistory.length === 0) ? '' : 'display: none;' %>">
                            <td colspan="9" class="text-center text-muted py-4">Belum ada data riwayat Region Switch.</td>
                          </tr>

                          <tr id="noMatchRegionSwitchRow" class="d-none">
                            <td colspan="9" class="text-center text-muted py-4">
                              <i class="bi bi-search me-1"></i> Tidak ditemukan riwayat Region Switch yang sesuai kriteria pencarian/filter.
                            </td>
                          </tr>

                          <% (regionSwitchHistory || []).forEach((item, index) => { %>
                            <tr class="region-switch-row"
                                data-name="<%= (item.requester_name || '').toLowerCase() %>"
                                data-home="<%= (item.home_region_code || '').toUpperCase() %>"
                                data-target="<%= (item.target_region_code || '').toUpperCase() %>">
                              <td class="app-col-num text-muted"><%= index + 1 %></td>
                              <td class="fw-semibold text-dark"><%= item.requester_name || '-' %></td>
                              <td><span class="badge text-bg-light border font-monospace"><%= item.home_region_code || '-' %></span></td>
                              <td><span class="badge text-bg-primary-subtle text-primary border border-primary-subtle font-monospace"><%= item.target_region_code || '-' %></span></td>
                              <td>
                                <%- include('../partials/status-badge', { type: 'region_switch', value: item.status }) %>
                              </td>
                              <td>
                                <% if (item.status === 'rejected') { %>
                                  <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle text-wrap text-start fw-normal" style="max-width: 280px; line-height: 1.3;">
                                    <i class="bi bi-x-circle me-1"></i><%= item.rejection_reason || 'Ditolak tanpa catatan' %>
                                  </span>
                                <% } else if (item.reason) { %>
                                  <span class="text-muted small text-truncate d-inline-block" style="max-width: 240px;" title="<%= item.reason %>">
                                    <%= item.reason %>
                                  </span>
                                <% } else { %>
                                  <span class="text-muted small">-</span>
                                <% } %>
                              </td>
                              <td class="app-col-time text-muted small"><%= formatDateTime(item.requested_at) %></td>
                              <td class="app-col-time text-muted small">
                                <%= item.status === 'rejected' ? '-' : (formatDateTime(item.approved_at) || '-') %>
                              </td>
                              <td class="app-col-time text-muted small">
                                <%= item.status === 'rejected' ? '-' : (formatDateTime(item.end_at) || '-') %>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div class="card-footer bg-white border-top p-0" id="regionSwitchPaginationFooter">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 p-3 pt-2">
                      <div class="small text-muted" id="regionSwitchPaginationInfo">
                        Menampilkan <strong>1&ndash;10</strong> dari <strong><%= (regionSwitchHistory || []).length %></strong> riwayat
                      </div>
                      <nav aria-label="Navigasi halaman riwayat region switch">
                        <ul class="pagination pagination-sm mb-0 flex-wrap" id="regionSwitchPaginationList">
                          <!-- Terisi otomatis oleh JavaScript -->
                        </ul>
                      </nav>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/report-detail-modal') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f025-telegram-sender-identity"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script id="supervisor-dashboard-data" type="application/json"><%- JSON.stringify({ charts: charts || {}, regionSummary: regionSummary || [] }) %></script>
  <script id="supervisor-dashboard-filters" type="application/json"><%- JSON.stringify(filters || {}) %></script>
  <script>
    (function () {
      function parseJsonPayload(id) {
        var el = document.getElementById(id);
        if (!el) return {};
        try {
          return JSON.parse(el.textContent || '{}');
        } catch (e) {
          return {};
        }
      }

      window.SUPERVISOR_DASHBOARD_DATA = parseJsonPayload('supervisor-dashboard-data');
      window.SUPERVISOR_DASHBOARD_FILTERS = parseJsonPayload('supervisor-dashboard-filters');
    })();
  </script>
  <script src="/js/supervisor-dashboard.js?v=analisis-wilayah-filter-1"></script>
</body>
</html>
