<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const reportStatusOptions = Array.isArray(reportStatuses) ? reportStatuses : [];
    const safeReportStatusOptions = reportStatusOptions.filter((st) => String(st || '').toLowerCase() !== 'baru');
    function statusLabel(value) {
      if (String(value || '').toLowerCase() === 'baru') return '-';
      return (statusLabelMap && statusLabelMap[value]) ? statusLabelMap[value] : (value || '-');
    }

    const selectedFilters = filters || {};
  %>

  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/supervisor' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Supervisor' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Supervisor',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}. Hak akses: read-only (tanpa aksi operasional).`
          }) %>

          <section id="dashboard-ringkasan" class="app-anchor-section">
          <div class="card app-card mb-3">
            <div class="card-body">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div>
                  <div class="fw-semibold">Filter Dashboard</div>
                  <div class="text-muted small">Periode memakai tanggal masuk (received_at).</div>
                </div>
              </div>

              <form class="row g-2" method="GET" action="/dashboard/supervisor">
          <div class="col-12 col-md-3">
            <label class="form-label">Periode</label>
            <select class="form-select" name="period" id="filterPeriod">
              <option value="all" <%= selectedFilters.period === 'all' ? 'selected' : '' %>>Semua</option>
              <option value="today" <%= selectedFilters.period === 'today' ? 'selected' : '' %>>Hari ini</option>
              <option value="last_7_days" <%= selectedFilters.period === 'last_7_days' ? 'selected' : '' %>>7 hari terakhir</option>
              <option value="this_month" <%= selectedFilters.period === 'this_month' ? 'selected' : '' %>>Bulan ini</option>
              <option value="custom" <%= selectedFilters.period === 'custom' ? 'selected' : '' %>>Custom</option>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label">Mulai</label>
            <input type="date" class="form-control" name="startDate" id="filterStartDate" value="<%= selectedFilters.startDate || '' %>">
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label">Sampai</label>
            <input type="date" class="form-control" name="endDate" id="filterEndDate" value="<%= selectedFilters.endDate || '' %>">
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label">District</label>
            <select class="form-select" name="regionId">
              <option value="">Semua District</option>
              <% (regions || []).forEach(region => { %>
                <option value="<%= region.id %>" <%= String(selectedFilters.regionId) === String(region.id) ? 'selected' : '' %>>
                  <%= region.code %> - <%= region.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
              <option value="all" <%= (selectedFilters.status || 'all') === 'all' ? 'selected' : '' %>>Semua Status</option>
              <% safeReportStatusOptions.forEach(st => { %>
                <option value="<%= st %>" <%= (selectedFilters.status || 'all') === st ? 'selected' : '' %>>
                  <%= statusLabel(st) %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-6 d-flex align-items-end justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Terapkan Filter</button>
            <a href="/dashboard/supervisor" class="btn btn-outline-secondary">Reset</a>
          </div>
        </form>

        <%
          const periodLabelMap = {
            all: 'Semua',
            today: 'Hari ini',
            last_7_days: '7 hari terakhir',
            this_month: 'Bulan ini',
            custom: 'Custom'
          };

          const selectedRegion = (regions || []).find((r) => String(r.id) === String(selectedFilters.regionId));
          const activePeriodLabel = periodLabelMap[selectedFilters.period] || 'Semua';
          const activeRegionLabel = selectedRegion ? `${selectedRegion.code} - ${selectedRegion.name}` : 'Semua District';
          const activeStatusLabel = (selectedFilters.status && selectedFilters.status !== 'all')
            ? statusLabel(selectedFilters.status)
            : 'Semua Status';
          const showCustomRange = selectedFilters.period === 'custom' && (selectedFilters.startDate || selectedFilters.endDate);
        %>

              <div class="mt-3">
                <div class="text-muted small mb-2">Filter aktif:</div>
                <div class="d-flex flex-wrap gap-2">
                  <span class="badge text-bg-light border">Periode: <%= activePeriodLabel %></span>
                  <% if (showCustomRange) { %>
                    <span class="badge text-bg-light border">Tanggal: <%= selectedFilters.startDate || '-' %> s/d <%= selectedFilters.endDate || '-' %></span>
                  <% } %>
                  <span class="badge text-bg-light border">District: <%= activeRegionLabel %></span>
                  <span class="badge text-bg-light border">Status: <%= activeStatusLabel %></span>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Total Laporan</div>
            <h3 class="mb-0"><%= summary.total_reports %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Tersedia</div>
            <h3 class="mb-0 text-primary"><%= summary.total_available %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Sedang Ditangani</div>
            <h3 class="mb-0 text-warning"><%= summary.total_in_progress %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Selesai</div>
            <h3 class="mb-0 text-success"><%= summary.total_completed %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Perlu Tindak Lanjut</div>
            <h3 class="mb-0 text-warning"><%= summary.total_follow_up %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Eskalasi</div>
            <h3 class="mb-0 text-danger"><%= summary.total_escalated %></h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Rata-rata Waktu Respons</div>
            <h6 class="mb-0"><%= summary.avg_response %></h6>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Rata-rata Waktu Penyelesaian</div>
            <h6 class="mb-0"><%= summary.avg_resolution %></h6>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Tingkat Penyelesaian</div>
            <h3 class="mb-0"><%= Number(summary.completion_rate || 0).toFixed(2) %>%</h3>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-card h-100">
          <div class="card-body">
            <div class="text-muted small">Backlog Aktif</div>
            <h3 class="mb-0"><%= summary.active_backlog %></h3>
            <div class="small text-muted">Tersedia + Diproses + TL + Eskalasi</div>
          </div>
        </div>
      </div>
    </div>

          <div class="row g-3 mb-3">
      <div class="col-lg-4">
        <div class="card app-card h-100">
          <div class="card-header"><strong>Grafik Status Tiket</strong></div>
          <div class="card-body d-flex flex-column">
            <div class="flex-grow-1">
              <canvas id="statusChart" height="160"></canvas>
            </div>
            <% if (!charts || !charts.status || !charts.status.labels || charts.status.labels.length === 0) { %>
              <div class="text-muted small mt-2">Tidak ada data untuk grafik status.</div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card app-card h-100">
          <div class="card-header"><strong>Grafik Tren Laporan (Harian)</strong></div>
          <div class="card-body d-flex flex-column">
            <div class="flex-grow-1">
              <canvas id="trendChart" height="160"></canvas>
            </div>
            <% if (!charts || !charts.trend || !charts.trend.labels || charts.trend.labels.length === 0) { %>
              <div class="text-muted small mt-2">Tidak ada data untuk grafik tren.</div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card app-card h-100">
          <div class="card-header"><strong>Grafik Perbandingan District</strong></div>
          <div class="card-body d-flex flex-column">
            <div class="flex-grow-1">
              <canvas id="regionComparisonChart" height="160"></canvas>
            </div>
            <% if (!charts || !charts.regionComparison || !charts.regionComparison.labels || charts.regionComparison.labels.length === 0) { %>
              <div class="text-muted small mt-2">Tidak ada data untuk grafik perbandingan.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

          </section>

          <div class="row g-3">
      <div class="col-lg-7 app-anchor-section" id="analisis-wilayah">
        <div class="card app-card">
          <div class="card-header"><strong>Rekap per Wilayah</strong></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Wilayah</th>
                    <th>Total</th>
                    <th>Tersedia</th>
                    <th>Diproses</th>
                    <th>Selesai</th>
                    <th>Tindak Lanjut</th>
                    <th>Eskalasi</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (regionSummary.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">Belum ada data.</td>
                    </tr>
                  <% } %>

                  <% regionSummary.forEach(region => { %>
                    <tr>
                      <td><%= region.region_code %></td>
                      <td><%= region.total_reports %></td>
                      <td><%= region.total_available %></td>
                      <td><%= region.total_in_progress %></td>
                      <td><%= region.total_completed %></td>
                      <td><%= region.total_follow_up %></td>
                      <td><%= region.total_escalated %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5 app-anchor-section" id="kinerja-eksekutor">
        <div class="card app-card">
          <div class="card-header"><strong>Rekap Kinerja Pegawai Eksekutor</strong></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>No</th>
                    <th>Nama Pegawai</th>
                    <th>Wilayah</th>
                    <th>Total Ditangani</th>
                    <th>Total Selesai</th>
                    <th>Rata-rata Waktu Penyelesaian</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (userPerformance.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center text-muted py-4">Belum ada data.</td>
                    </tr>
                  <% } %>

                  <% userPerformance.forEach((user, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= user.full_name %></td>
                      <td><%= user.region_code || '-' %></td>
                      <td><%= user.total_handled %></td>
                      <td><%= user.total_completed %></td>
                      <td><%= formatMinutes(user.avg_resolution_minutes) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

          </div>

          <div class="row g-3 mt-1">
      <div class="col-lg-7 app-anchor-section" id="tiket-perlu-perhatian">
        <div class="card app-card">
          <div class="card-header">
            <strong>Tiket Perlu Perhatian</strong>
            <div class="text-muted small">Prioritas: perlu tindak lanjut & eskalasi (read-only)</div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>No</th>
                    <th>Ticket ID</th>
                    <th>Order ID</th>
                    <th>Ringkasan</th>
                    <th>Wilayah</th>
                    <th>Status</th>
                    <th>Eksekutor</th>
                    <th>Diterima</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!attentionTickets || attentionTickets.length === 0) { %>
                    <tr>
                      <td colspan="8" class="text-center text-muted py-4">Tidak ada tiket perlu perhatian pada filter ini.</td>
                    </tr>
                  <% } %>

                  <% (attentionTickets || []).forEach((ticket, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= ticket.ticket_id || '-' %></td>
                      <td><%= ticket.order_id || '-' %></td>
                      <td>
                        <div class="app-truncate-lg" title="<%= ticket.summary || '-' %>">
                          <%= ticket.summary || '-' %>
                        </div>
                      </td>
                      <td><%= ticket.region_code || '-' %></td>
                      <td>
                        <%- include('../partials/status-badge', { type: 'ticket', value: ticket.status_internal }) %>
                      </td>
                      <td><%= ticket.assigned_user_name || '-' %></td>
                      <td><span class="text-muted"><%= formatDateTime(ticket.received_at) %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5 app-anchor-section" id="riwayat-region-switch">
        <div class="card app-card">
          <div class="card-header">
            <strong>Riwayat Region Switch F007</strong>
            <div class="text-muted small">Informasi read-only (tanpa approve/reject)</div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>No</th>
                    <th>Eksekutor</th>
                    <th>Asal</th>
                    <th>Tujuan</th>
                    <th>Status</th>
                    <th>Diajukan</th>
                    <th>Disetujui</th>
                    <th>Berakhir</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!regionSwitchHistory || regionSwitchHistory.length === 0) { %>
                    <tr>
                      <td colspan="8" class="text-center text-muted py-4">Belum ada data Region Switch.</td>
                    </tr>
                  <% } %>

                  <% (regionSwitchHistory || []).forEach((item, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= item.requester_name || '-' %></td>
                      <td><%= item.home_region_code || '-' %></td>
                      <td><%= item.target_region_code || '-' %></td>
                      <td>
                        <%- include('../partials/status-badge', { type: 'region_switch', value: item.status }) %>
                      </td>
                      <td><span class="text-muted"><%= formatDateTime(item.requested_at) %></span></td>
                      <td><span class="text-muted"><%= formatDateTime(item.approved_at) %></span></td>
                      <td><span class="text-muted"><%= formatDateTime(item.end_at) %></span></td>
                    </tr>
                    <% if (item.rejection_reason) { %>
                      <tr>
                        <td></td>
                        <td colspan="7" class="text-muted small bg-light">
                          Alasan penolakan: <%= item.rejection_reason %>
                        </td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script>
    window.SUPERVISOR_DASHBOARD_DATA = <%- JSON.stringify({ charts: charts || {} }) %>;
    window.SUPERVISOR_DASHBOARD_FILTERS = <%- JSON.stringify(filters || {}) %>;
  </script>
  <script src="/js/supervisor-dashboard.js"></script>
</body>
</html>
