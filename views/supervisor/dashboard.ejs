<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="mb-1">Dashboard Supervisor</h3>
        <p class="mb-0">
          Selamat datang, <strong><%= currentUser.full_name %></strong>
        </p>
        <small class="text-muted">Hak akses: read-only</small>
      </div>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="btn btn-outline-danger">Logout</button>
      </form>
    </div>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg[0] %></div>
    <% } %>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg[0] %></div>
    <% } %>

    <div class="row g-3 mb-4">
      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Total Laporan</div>
            <h3 class="mb-0"><%= summary.total_reports %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Tersedia</div>
            <h3 class="mb-0 text-primary"><%= summary.total_available %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Sedang Ditangani</div>
            <h3 class="mb-0 text-warning"><%= summary.total_in_progress %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Selesai</div>
            <h3 class="mb-0 text-success"><%= summary.total_completed %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Rata-rata Waktu Respons</div>
            <h6 class="mb-0"><%= summary.avg_response %></h6>
          </div>
        </div>
      </div>

      <div class="col-md-2">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small">Rata-rata Waktu Penyelesaian</div>
            <h6 class="mb-0"><%= summary.avg_resolution %></h6>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-header">
            <strong>Rekap per Wilayah</strong>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-bordered align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Wilayah</th>
                    <th>Total</th>
                    <th>Tersedia</th>
                    <th>Diproses</th>
                    <th>Selesai</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (regionSummary.length === 0) { %>
                    <tr>
                      <td colspan="5" class="text-center text-muted">Belum ada data.</td>
                    </tr>
                  <% } %>

                  <% regionSummary.forEach(region => { %>
                    <tr>
                      <td><%= region.region_code %></td>
                      <td><%= region.total_reports %></td>
                      <td><%= region.total_available %></td>
                      <td><%= region.total_in_progress %></td>
                      <td><%= region.total_completed %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="card shadow-sm">
          <div class="card-header">
            <strong>Rekap Kinerja Pegawai Eksekutor</strong>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-bordered align-middle">
                <thead class="table-light">
                  <tr>
                    <th>No</th>
                    <th>Nama Pegawai</th>
                    <th>Wilayah</th>
                    <th>Total Ditangani</th>
                    <th>Total Selesai</th>
                    <th>Rata-rata Waktu Penyelesaian</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (userPerformance.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center text-muted">Belum ada data.</td>
                    </tr>
                  <% } %>

                  <% userPerformance.forEach((user, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= user.full_name %></td>
                      <td><%= user.region_code || '-' %></td>
                      <td><%= user.total_handled %></td>
                      <td><%= user.total_completed %></td>
                      <td><%= formatMinutes(user.avg_resolution_minutes) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</body>
</html>