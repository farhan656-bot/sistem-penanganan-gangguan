<div class="modal fade" id="reportDetailModal" tabindex="-1" aria-labelledby="reportDetailModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header d-flex justify-content-between align-items-start">
        <div>
          <h2 class="modal-title fs-5 fw-bold" id="reportDetailModalTitle">Detail Laporan</h2>
          <div class="small text-muted font-monospace" data-report-detail-subtitle>Memuat data laporan...</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>

      <div class="modal-body">
        <div class="d-flex align-items-center gap-2 text-muted" data-report-detail-loading>
          <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
          <span>Memuat detail laporan...</span>
        </div>

        <div class="alert alert-danger d-none mb-0" data-report-detail-error>
          Gagal memuat detail laporan.
        </div>

        <div class="d-none" data-report-detail-content>
          <ul class="nav nav-tabs report-detail-tabs flex-nowrap overflow-x-auto overflow-y-hidden" id="reportDetailTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="report-detail-info-tab"
                data-bs-toggle="tab"
                data-bs-target="#report-detail-info-pane"
                type="button"
                role="tab"
                aria-controls="report-detail-info-pane"
                aria-selected="true"
                data-report-detail-info-tab
              >Informasi Tiket</button>
            </li>
            <!-- TAB PENGERJAAN TIKET: Tampil di sebelah Informasi Tiket saat Eksekutor / Koordinator berwenang -->
            <li class="nav-item d-none" role="presentation" data-report-detail-action-tab-item>
              <button
                class="nav-link"
                id="report-detail-action-tab"
                data-bs-toggle="tab"
                data-bs-target="#report-detail-action-pane"
                type="button"
                role="tab"
                aria-controls="report-detail-action-pane"
                aria-selected="false"
                data-report-detail-action-tab
              ><i class="bi bi-tools me-1"></i>Pengerjaan Tiket</button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="report-detail-proof-tab"
                data-bs-toggle="tab"
                data-bs-target="#report-detail-proof-pane"
                type="button"
                role="tab"
                aria-controls="report-detail-proof-pane"
                aria-selected="false"
              >Bukti Penanganan (Sistem)</button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="report-detail-telegram-tab"
                data-bs-toggle="tab"
                data-bs-target="#report-detail-telegram-pane"
                type="button"
                role="tab"
                aria-controls="report-detail-telegram-pane"
                aria-selected="false"
              >Bukti Pelapor (Telegram)</button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="report-detail-activity-tab"
                data-bs-toggle="tab"
                data-bs-target="#report-detail-activity-pane"
                type="button"
                role="tab"
                aria-controls="report-detail-activity-pane"
                aria-selected="false"
              >Riwayat Aktivitas</button>
            </li>
          </ul>

          <div class="tab-content pt-3" id="reportDetailTabContent">
            <div
              class="tab-pane fade show active"
              id="report-detail-info-pane"
              role="tabpanel"
              aria-labelledby="report-detail-info-tab"
              tabindex="0"
              data-report-detail-info-pane
            ></div>
            <!-- ACTION PANE FOR IN-PROGRESS & RESOLUTION -->
            <div
              class="tab-pane fade"
              id="report-detail-action-pane"
              role="tabpanel"
              aria-labelledby="report-detail-action-tab"
              tabindex="0"
              data-report-detail-action-pane
            ></div>
            <div
              class="tab-pane fade"
              id="report-detail-proof-pane"
              role="tabpanel"
              aria-labelledby="report-detail-proof-tab"
              tabindex="0"
              data-report-detail-proof-pane
            ></div>
            <div
              class="tab-pane fade"
              id="report-detail-telegram-pane"
              role="tabpanel"
              aria-labelledby="report-detail-telegram-tab"
              tabindex="0"
              data-report-detail-telegram-pane
            ></div>
            <div
              class="tab-pane fade"
              id="report-detail-activity-pane"
              role="tabpanel"
              aria-labelledby="report-detail-activity-tab"
              tabindex="0"
              data-report-detail-activity-pane
            ></div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
</div>
