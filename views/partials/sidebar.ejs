<%
  const user = (typeof currentUser !== 'undefined') ? currentUser : null;
  const role = user && user.role ? String(user.role) : null;
  const currentPath = (typeof activePath !== 'undefined' && activePath) ? String(activePath) : '';

  function isActive(href) {
    if (!currentPath) return false;
    if (currentPath === href) return true;
    return currentPath.startsWith(href + '/');
  }
%>

<% if (user && role) { %>
  <aside class="app-sidebar">
    <div class="app-sidebar-inner">
      <div class="app-brand">
        <div class="app-brand-mark">
          <img
            src="/images/telkom-logo.png"
            alt="Telkom"
            class="app-brand-logo"
            onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
          >
          <span class="app-brand-fallback" hidden>Telkom</span>
        </div>
        <div>
          <div class="fw-semibold">Sistem Tiket Gangguan</div>
          <div class="text-muted small">Dashboard Operasional</div>
        </div>
      </div>

      <nav class="nav nav-pills flex-column gap-1">
        <% if (role === 'super_admin') { %>
          <div class="app-sidebar-section-title">Menu Utama</div>
          <a class="nav-link <%= isActive('/dashboard/super-admin') ? 'active' : '' %>" href="/dashboard/super-admin">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
          <a class="nav-link <%= isActive('/users') ? 'active' : '' %>" href="/users">
            <i class="bi bi-people"></i>
            <span>Kelola User</span>
          </a>

          <div class="app-sidebar-section-title mt-2">Operasional Tiket</div>
          <a class="nav-link <%= isActive('/reports') ? 'active' : '' %>" href="/reports">
            <i class="bi bi-ticket-perforated"></i>
            <span>Antrean Laporan</span>
          </a>
          <a class="nav-link <%= isActive('/manual-reports') ? 'active' : '' %>" href="/manual-reports">
            <i class="bi bi-pencil-square"></i>
            <span>Laporan Manual</span>
          </a>
        <% } %>

        <% if (role === 'supervisor') { %>
          <div class="app-sidebar-section-title">Monitoring & KPI</div>
          <a class="nav-link" href="/dashboard/supervisor#dashboard-ringkasan">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard Ringkasan</span>
          </a>
          <a class="nav-link <%= isActive('/reports') ? 'active' : '' %>" href="/reports">
            <i class="bi bi-ticket-perforated"></i>
            <span>Daftar Antrean Kerja</span>
          </a>
          <a class="nav-link" href="/dashboard/supervisor#analisis-wilayah">
            <i class="bi bi-geo-alt"></i>
            <span>Analisis Wilayah</span>
          </a>
          <a class="nav-link" href="/dashboard/supervisor#kinerja-eksekutor">
            <i class="bi bi-person-lines-fill"></i>
            <span>Kinerja Eksekutor</span>
          </a>
          <a class="nav-link" href="/dashboard/supervisor#tiket-perlu-perhatian">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Tiket Perlu Perhatian</span>
          </a>
          <a class="nav-link" href="/dashboard/supervisor#riwayat-region-switch">
            <i class="bi bi-clock-history"></i>
            <span>Riwayat Region Switch</span>
          </a>
        <% } %>

        <% if (role === 'eksekutor') { %>
          <div class="app-sidebar-section-title">Menu Operasional</div>
          <a class="nav-link <%= isActive('/dashboard/eksekutor') ? 'active' : '' %>" href="/dashboard/eksekutor">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
          <a class="nav-link <%= isActive('/reports') ? 'active' : '' %>" href="/reports">
            <i class="bi bi-ticket-perforated"></i>
            <span>Daftar Antrean Kerja</span>
          </a>
          <a class="nav-link <%= isActive('/manual-reports') ? 'active' : '' %>" href="/manual-reports">
            <i class="bi bi-pencil-square"></i>
            <span>Laporan Manual</span>
          </a>

          <div class="app-sidebar-section-title mt-2">Akses Wilayah</div>
          <a class="nav-link <%= isActive('/region-switch/my') ? 'active' : '' %>" href="/region-switch/my">
            <i class="bi bi-arrow-left-right"></i>
            <span>Pengajuan Switch Region</span>
          </a>
        <% } %>

        <% if (role === 'koordinator') { %>
          <div class="app-sidebar-section-title">Menu Operasional</div>
          <a class="nav-link <%= isActive('/dashboard/koordinator') ? 'active' : '' %>" href="/dashboard/koordinator">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
          <a class="nav-link <%= isActive('/reports') ? 'active' : '' %>" href="/reports">
            <i class="bi bi-ticket-perforated"></i>
            <span>Daftar Antrean Kerja</span>
          </a>
          <a class="nav-link <%= isActive('/manual-reports') ? 'active' : '' %>" href="/manual-reports">
            <i class="bi bi-pencil-square"></i>
            <span>Laporan Manual</span>
          </a>

          <div class="app-sidebar-section-title mt-2">Otorisasi</div>
          <a class="nav-link <%= isActive('/region-switch/pending') ? 'active' : '' %> d-flex align-items-center justify-content-between" href="/region-switch/pending">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-shield-check"></i>
              <span>Approval Switch Region</span>
            </div>
            <% if (typeof pendingSwitchCount !== 'undefined' && pendingSwitchCount > 0) { %>
              <span class="badge rounded-pill text-bg-warning font-monospace px-2" title="<%= pendingSwitchCount %> pengajuan menunggu persetujuan"><%= pendingSwitchCount %></span>
            <% } %>
          </a>
        <% } %>
      </nav>
    </div>
  </aside>
<% } %>
