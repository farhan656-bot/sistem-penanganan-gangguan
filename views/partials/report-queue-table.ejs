<%
  const selectedFilters = filters || {};
  const queueRole = String(currentUser && currentUser.role ? currentUser.role : '').trim().toLowerCase();
  const isOperationalQueue = queueRole === 'eksekutor' || queueRole === 'koordinator';
%>

<div class="card app-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th class="app-col-num">No</th>
            <th>Ticket ID</th>
            <th>Order ID</th>
            <th>Jenis Layanan</th>
            <th>Provider</th>
            <th>Branch</th>
            <th>Cluster</th>
            <th>STO</th>
            <th>Ringkasan</th>
            <th>Wilayah</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th class="app-table-actions">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!reports || reports.length === 0) { %>
            <tr>
              <td colspan="13" class="text-center text-muted app-table-empty">
                Tidak ada tiket pada tab <strong><%= activeWorkStatusTab.label %></strong> untuk filter yang dipilih.
              </td>
            </tr>
          <% } %>

          <% (reports || []).forEach((report, index) => { %>
            <tr>
              <td class="app-col-num <%= isOperationalQueue ? '' : 'text-muted' %>">
                <span class="small <%= isOperationalQueue ? 'fw-medium' : 'text-muted' %>"><%= pagination.offset + index + 1 %></span>
              </td>
              <td class="fw-semibold font-monospace"><%= report.ticket_id %></td>
              <td><span class="text-secondary small"><%= report.order_id || '-' %></span></td>
              <td><%= report.service_type || '-' %></td>
              <td><%= report.provider || '-' %></td>
              <td><%= report.branch_name || '-' %></td>
              <td><%= report.cluster_name || '-' %></td>
              <td><%= report.sto || '-' %></td>
              <td>
                <div
                  class="<%= isOperationalQueue ? 'app-truncate-lg' : 'app-truncate' %>"
                  title="<%= report.summary || '-' %>"
                ><%= report.summary || '-' %></div>
              </td>
              <td>
                <span class="badge text-bg-light border"><%= report.region_code || '-' %></span>
                <% if (report.is_region_switch) { %>
                  <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle d-block mt-1" style="font-size: 0.7rem;" title="Dikerjakan via Perbantuan Switch Region">Perbantuan</span>
                <% } else if (report.is_delegated && report.is_cross_region) { %>
                  <span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle d-block mt-1" style="font-size: 0.7rem;" title="Tiket didelegasikan lintas wilayah">Lintas Wilayah</span>
                <% } %>
              </td>
              <td>
                <%- include('./status-badge', { type: 'ticket', value: report.status_internal }) %>
              </td>
              <td>
                <div class="<%= report.assigned_user_name ? 'fw-semibold' : 'text-muted' %>">
                  <%= report.assigned_user_name || '-' %>
                </div>

                <% if (currentUser && currentUser.role === 'koordinator' && report.assigned_to_user_id === currentUser.id) { %>
                  <div class="mt-1">
                    <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle" title="Tiket ini sedang Anda tangani langsung">Ditangani Anda</span>
                  </div>
                <% } %>

                <% if (report.status_internal === 'didelegasikan') { %>
                  <div class="mt-1">
                    <span class="badge text-bg-info">Delegasi Aktif</span>
                  </div>
                <% } else if (report.is_delegated) { %>
                  <div class="mt-1">
                    <span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle" title="Tiket hasil penugasan delegasi koordinator">Delegasi</span>
                  </div>
                <% } else if (report.is_region_switch) { %>
                  <div class="mt-1">
                    <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="Tiket dikerjakan melalui izin perbantuan switch region">Switch Region</span>
                  </div>
                <% } %>
              </td>
              <td class="app-table-actions">
                <%- include('./report-action-buttons', { report }) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('./report-pagination', { pagination, filters: selectedFilters }) %>
  </div>
</div>
