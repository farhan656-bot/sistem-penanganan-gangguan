<%
  function normalizeFlash(value) {
    if (!value) return [];
    if (Array.isArray(value)) return value.filter(Boolean);
    return [value].filter(Boolean);
  }

  const successMessages = normalizeFlash(typeof success_msg !== 'undefined' ? success_msg : null);
  const errorMessages = normalizeFlash(typeof error_msg !== 'undefined' ? error_msg : null);
  const warningMessages = normalizeFlash(typeof warning_msg !== 'undefined' ? warning_msg : null);
  const infoMessages = normalizeFlash(typeof info_msg !== 'undefined' ? info_msg : null);

  const hasFlashMessages = (
    successMessages.length > 0 ||
    errorMessages.length > 0 ||
    warningMessages.length > 0 ||
    infoMessages.length > 0
  );
%>

<% if (hasFlashMessages) { %>
  <div class="app-toast-container" id="appToastContainer" aria-live="polite" aria-atomic="true">
    <%
      function renderToasts(type, messages, iconClass) {
        if (!messages || messages.length === 0) return;
        messages.forEach((msg) => {
    %>
      <div
        class="toast show align-items-center app-toast app-toast-<%= type %>"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
        data-auto-dismiss="true"
        data-auto-dismiss-delay="<%= type === 'danger' ? '6000' : '4000' %>"
      >
        <div class="d-flex align-items-center w-100">
          <div class="app-toast-icon flex-shrink-0">
            <i class="bi <%= iconClass %>"></i>
          </div>
          <div class="toast-body flex-grow-1 text-wrap">
            <%= msg %>
          </div>
          <button
            type="button"
            class="btn-close me-2 m-auto flex-shrink-0"
            data-bs-dismiss="toast"
            aria-label="Tutup"
          ></button>
        </div>
      </div>
    <%
        });
      }

      renderToasts('success', successMessages, 'bi-check-circle-fill text-success');
      renderToasts('danger', errorMessages, 'bi-exclamation-triangle-fill text-danger');
      renderToasts('warning', warningMessages, 'bi-exclamation-circle-fill text-warning');
      renderToasts('info', infoMessages, 'bi-info-circle-fill text-info');
    %>
  </div>
<% } %>

<% if (typeof activeRegionSwitch !== 'undefined' && activeRegionSwitch) { %>
  <div
    id="active-region-switch-banner"
    class="alert alert-success d-none align-items-start gap-3 mb-3 shadow-sm border-success-subtle p-3"
    role="alert"
  >
    <div class="text-success fs-5 pt-1 flex-shrink-0">
      <i class="bi bi-arrow-left-right"></i>
    </div>
    <div class="flex-grow-1 text-dark" style="font-size: 0.925rem; line-height: 1.5;">
      <strong class="text-success-emphasis">Akses Bantuan Wilayah Aktif:</strong>
      Pengajuan switch region ke wilayah <strong><%= activeRegionSwitch.target_region_name || activeRegionSwitch.target_region_code %> (<%= activeRegionSwitch.target_region_code %>)</strong> telah disetujui dan aktif hingga pukul <strong><%= new Date(activeRegionSwitch.end_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</strong>. Anda dapat mengambil dan mengerjakan tiket di wilayah tersebut.
    </div>
    <button
      type="button"
      class="btn-close flex-shrink-0 ms-2 mt-1"
      id="dismiss-region-switch-btn"
      aria-label="Tutup pemberitahuan"
      title="Tutup pemberitahuan"
    ></button>
  </div>
  <script>
    (function() {
      try {
        var switchKey = 'dismissed_region_switch_<%= activeRegionSwitch.id %>';
        var banner = document.getElementById('active-region-switch-banner');
        if (!banner) return;

        if (localStorage.getItem(switchKey) !== 'true') {
          banner.classList.remove('d-none');
          banner.classList.add('d-flex');
        }

        var btn = document.getElementById('dismiss-region-switch-btn');
        if (btn) {
          btn.addEventListener('click', function() {
            try {
              localStorage.setItem(switchKey, 'true');
            } catch (e) {}
            banner.remove();
          });
        }
      } catch (e) {
        if (banner) {
          banner.classList.remove('d-none');
          banner.classList.add('d-flex');
        }
      }
    })();
  </script>
<% } %>
