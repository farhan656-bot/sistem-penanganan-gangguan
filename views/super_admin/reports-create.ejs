<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/reports/create' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: title }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Tambah Laporan Manual',
            pageSubtitle: 'Input laporan fallback operasional sebelum integrasi bot aktif penuh.',
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/dashboard/super-admin" class="btn btn-outline-secondary">Dashboard</a>
                <a href="/reports" class="btn btn-outline-secondary">Antrean Laporan</a>
              </div>
            `
          }) %>

          <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
              <div class="card app-card">
                <div class="card-body">
                  <form action="/reports" method="POST">
                    <div class="row g-4">
                      <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                          <div>
                            <div class="fw-semibold">Informasi Tiket</div>
                            <div class="text-muted small">Identitas tiket dan referensi WFM.</div>
                          </div>
                        </div>
                        <hr class="my-3">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <label class="form-label">Ticket ID <span class="text-danger">*</span></label>
                            <input
                              type="text"
                              name="ticket_id"
                              class="form-control"
                              value="<%= formData.ticket_id %>"
                              required
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Fallout Type</label>
                            <input
                              type="text"
                              name="fallout_type"
                              class="form-control"
                              value="<%= formData.fallout_type %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Order ID</label>
                            <input
                              type="text"
                              name="order_id"
                              class="form-control"
                              value="<%= formData.order_id %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">WO Number</label>
                            <input
                              type="text"
                              name="wo_number"
                              class="form-control"
                              value="<%= formData.wo_number %>"
                            >
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="fw-semibold">Informasi Layanan</div>
                        <div class="text-muted small">Segment layanan, provider, dan status sistem.</div>
                        <hr class="my-3">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <label class="form-label">Service Type</label>
                            <input
                              type="text"
                              name="service_type"
                              class="form-control"
                              value="<%= formData.service_type %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Segment</label>
                            <input
                              type="text"
                              name="segment"
                              class="form-control"
                              value="<%= formData.segment %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Provider</label>
                            <input
                              type="text"
                              name="provider"
                              class="form-control"
                              value="<%= formData.provider %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Service ID</label>
                            <input
                              type="text"
                              name="service_id"
                              class="form-control"
                              value="<%= formData.service_id %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Status WFM</label>
                            <input
                              type="text"
                              name="status_wfm"
                              class="form-control"
                              value="<%= formData.status_wfm %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Status Andalas</label>
                            <input
                              type="text"
                              name="status_andalas"
                              class="form-control"
                              value="<%= formData.status_andalas %>"
                            >
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="fw-semibold">Informasi Lokasi</div>
                        <div class="text-muted small">Area dan identitas lokasi pelanggan.</div>
                        <hr class="my-3">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <label class="form-label">Telkom Area</label>
                            <input
                              type="text"
                              name="telkom_area"
                              class="form-control"
                              value="<%= formData.telkom_area %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Branch Name</label>
                            <input
                              type="text"
                              name="branch_name"
                              class="form-control"
                              value="<%= formData.branch_name %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">Cluster Name</label>
                            <input
                              type="text"
                              name="cluster_name"
                              class="form-control"
                              value="<%= formData.cluster_name %>"
                            >
                          </div>

                          <div class="col-md-4">
                            <label class="form-label">STO</label>
                            <input
                              type="text"
                              name="sto"
                              class="form-control"
                              value="<%= formData.sto %>"
                            >
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="fw-semibold">Detail Gangguan</div>
                        <div class="text-muted small">Ringkasan gangguan wajib diisi untuk kebutuhan penanganan.</div>
                        <hr class="my-3">
                        <div class="row g-3">
                          <div class="col-12">
                            <label class="form-label">Ringkasan Gangguan <span class="text-danger">*</span></label>
                            <textarea
                              name="summary"
                              class="form-control"
                              rows="4"
                              required
                            ><%= formData.summary %></textarea>
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="fw-semibold">Wilayah Penanganan</div>
                        <div class="text-muted small">Wilayah awal sebagai basis penugasan awal.</div>
                        <hr class="my-3">
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label">Wilayah Awal <span class="text-danger">*</span></label>
                            <select name="reported_region_id" class="form-select" required>
                              <option value="">Pilih wilayah</option>
                              <% regions.forEach(region => { %>
                                <option
                                  value="<%= region.id %>"
                                  <%= String(formData.reported_region_id) === String(region.id) ? 'selected' : '' %>
                                >
                                  <%= region.code %> - <%= region.name %>
                                </option>
                              <% }) %>
                            </select>
                            <div class="form-text">Wajib diisi. Delegasi/penugasan mengikuti aturan existing.</div>
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="d-flex gap-2 flex-wrap">
                          <button type="submit" class="btn btn-primary">Simpan Laporan Manual</button>
                          <a href="/dashboard/super-admin" class="btn btn-outline-secondary">Batal</a>
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
