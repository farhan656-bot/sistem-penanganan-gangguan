<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/super-admin' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Super Admin' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Super Admin',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}.`
          }) %>

          <!-- Group 1: Administrasi Pengguna & Akun Sistem -->
          <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <h6 class="fw-bold mb-0 text-dark">Administrasi Pengguna & Akun</h6>
              </div>
              <span class="badge text-bg-light border text-secondary small font-monospace">Master Pengguna</span>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card app-card-clickable h-100 text-decoration-none text-reset" title="Buka data seluruh akun">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Total Pengguna</span>
                      <span class="badge text-bg-light border text-secondary font-monospace">Semua Akun</span>
                    </div>
                    <div class="fs-3 fw-bold text-dark mb-1">
                      <i class="bi bi-people text-primary me-2"></i><%= summary.total_users %>
                    </div>
                    <div class="text-muted small">Seluruh akun internal terdaftar</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card app-card-clickable h-100 text-decoration-none text-reset" title="Buka data akun aktif">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Pengguna Aktif</span>
                      <% const activePercent = Math.round((summary.total_active_users / (summary.total_users || 1)) * 100); %>
                      <span class="badge text-bg-success-subtle text-success border border-success-subtle"><%= activePercent %>% Aktif</span>
                    </div>
                    <div class="fs-3 fw-bold text-success mb-1">
                      <i class="bi bi-person-check text-success me-2"></i><%= summary.total_active_users %>
                    </div>
                    <div class="text-muted small">Dapat login & menjalankan operasional</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card app-card-clickable h-100 text-decoration-none text-reset" title="Buka data akun nonaktif">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Pengguna Nonaktif</span>
                      <span class="badge text-bg-secondary-subtle text-secondary border border-secondary-subtle">Ditangguhkan</span>
                    </div>
                    <div class="fs-3 fw-bold text-secondary mb-1">
                      <i class="bi bi-person-x text-secondary me-2"></i><%= summary.total_inactive_users %>
                    </div>
                    <div class="text-muted small">Akses login ditangguhkan sementara</div>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <!-- Group 2: Cakupan Sistem & Data Operasional -->
          <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-hdd-network-fill text-primary"></i>
                <h6 class="fw-bold mb-0 text-dark">Data Operasional & Lingkup Sistem</h6>
              </div>
              <span class="badge text-bg-light border text-secondary small font-monospace">Agregat Sistem</span>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-4">
                <a href="/reports" class="card app-card app-card-clickable h-100 text-decoration-none text-reset" title="Buka seluruh antrean tiket laporan">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Laporan Gangguan</span>
                      <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle">Tiket Bot</span>
                    </div>
                    <div class="fs-3 fw-bold text-primary mb-1">
                      <i class="bi bi-ticket-detailed text-primary me-2"></i><%= summary.total_reports %>
                    </div>
                    <div class="text-muted small">Total tiket dalam alur monitoring</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/manual-reports" class="card app-card app-card-clickable h-100 text-decoration-none text-reset" title="Buka rekap laporan manual">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Laporan Manual</span>
                      <span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle">Non-Tiket</span>
                    </div>
                    <div class="fs-3 fw-bold text-info mb-1">
                      <i class="bi bi-journal-text text-info me-2"></i><%= summary.total_manual_reports %>
                    </div>
                    <div class="text-muted small">Catatan gangguan non-tiket terdata</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <div class="card app-card h-100">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="text-muted small fw-semibold">Wilayah Operasional</span>
                      <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle font-monospace">PDG & BKT</span>
                    </div>
                    <div class="fs-3 fw-bold text-dark mb-1">
                      <i class="bi bi-geo-alt text-danger me-2"></i><%= summary.total_regions %>
                    </div>
                    <div class="text-muted small">Wilayah kerja operasional terdaftar</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 3: Distribusi Role & Komposisi Pengguna -->
          <div class="row g-3">
            <div class="col-12 col-xl-7">
              <div class="card app-card h-100">
                <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock text-primary"></i>
                    <strong class="text-dark small fw-semibold">Distribusi Pengguna Berdasarkan Peran</strong>
                  </div>
                  <span class="badge text-bg-light border text-secondary font-monospace" style="font-size: 0.72rem;">Total: <%= summary.total_users %> Akun</span>
                </div>
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Peran (Role)</th>
                          <th class="text-center">Total Akun</th>
                          <th class="text-center">Aktif</th>
                          <th class="text-center">Nonaktif</th>
                          <th style="width: 28%;">Distribusi Tim</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!usersByRole || usersByRole.length === 0) { %>
                          <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                              Data peran pengguna belum tersedia.
                            </td>
                          </tr>
                        <% } %>

                        <% (usersByRole || []).forEach(role => { %>
                          <% const rolePct = Math.round((role.total_users / (summary.total_users || 1)) * 100); %>
                          <tr>
                            <td>
                              <%- include('../partials/status-badge', { type: 'role', value: role.role_name }) %>
                            </td>
                            <td class="text-center"><strong><%= role.total_users %></strong></td>
                            <td class="text-center text-success fw-semibold"><%= role.total_active_users %></td>
                            <td class="text-center text-secondary"><%= role.total_inactive_users %></td>
                            <td>
                              <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px;">
                                  <div class="progress-bar bg-primary" role="progressbar" aria-valuenow="<%= rolePct %>" aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div>
                                </div>
                                <span class="text-muted small font-monospace" style="min-width: 32px;"><%= rolePct %>%</span>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                      <tfoot class="table-light fw-semibold small">
                        <tr>
                          <td>Total Keseluruhan</td>
                          <td class="text-center text-dark fw-bold"><%= summary.total_users %></td>
                          <td class="text-center text-success fw-bold"><%= summary.total_active_users %></td>
                          <td class="text-center text-secondary"><%= summary.total_inactive_users %></td>
                          <td class="text-muted">100% Terpetakan</td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-5">
              <div class="card app-card h-100">
                <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                  <strong class="text-dark small fw-semibold">
                    <i class="bi bi-pie-chart text-primary me-1"></i>Komposisi Peran Akun
                  </strong>
                  <span class="badge text-bg-light border text-secondary" style="font-size: 0.72rem;">Visualisasi Tim</span>
                </div>
                <div class="card-body d-flex flex-column p-3">
                  <div style="position: relative; height: 200px; width: 100%;">
                    <canvas id="superAdminRoleChart"></canvas>
                  </div>
                  <div class="mt-auto pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                      <span class="text-muted">Kesiapan Akun Operasional</span>
                      <strong class="text-success"><%= activePercent %>% (<%= summary.total_active_users %>/<%= summary.total_users %> Akun Aktif)</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                      <div class="progress-bar bg-success" role="progressbar" aria-valuenow="<%= activePercent %>" aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
  <script type="application/json" id="superAdminRoleData">
    <%- JSON.stringify(usersByRole || []) %>
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.progress-bar[aria-valuenow]').forEach(function (bar) {
        var val = bar.getAttribute('aria-valuenow');
        if (val !== null) {
          bar.style.width = val + '%';
        }
      });

      var canvas = document.getElementById('superAdminRoleChart');
      if (!canvas || !window.Chart) return;

      var roleDataEl = document.getElementById('superAdminRoleData');
      var roleData = [];
      try {
        roleData = roleDataEl ? JSON.parse(roleDataEl.textContent || '[]') : [];
      } catch (e) {
        roleData = [];
      }
      var labels = roleData.map(function (r) {
        var name = String(r.role_name || '').toLowerCase();
        if (name === 'super_admin') return 'Super Admin';
        if (name === 'supervisor') return 'Supervisor';
        if (name === 'koordinator') return 'Koordinator';
        if (name === 'eksekutor') return 'Eksekutor';
        return r.role_name;
      });
      var counts = roleData.map(function (r) { return Number(r.total_users) || 0; });
      var colors = roleData.map(function (r) {
        var name = String(r.role_name || '').toLowerCase();
        if (name === 'super_admin') return '#dc2626';
        if (name === 'supervisor') return '#64748b';
        if (name === 'koordinator') return '#0284c7';
        if (name === 'eksekutor') return '#2563eb';
        return '#6c757d';
      });

      new window.Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: counts,
            backgroundColor: colors,
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                boxWidth: 10,
                boxHeight: 10,
                usePointStyle: true,
                pointStyle: 'circle',
                padding: 10,
                font: { size: 11 }
              }
            },
            tooltip: {
              backgroundColor: '#0f172a',
              padding: 8,
              cornerRadius: 6,
              callbacks: {
                label: function (context) {
                  var val = context.parsed !== undefined ? context.parsed : 0;
                  var total = counts.reduce(function (a, b) { return a + b; }, 0) || 1;
                  var pct = ((val / total) * 100).toFixed(1);
                  return ' ' + context.label + ': ' + val + ' akun (' + pct + '%)';
                }
              }
            }
          }
        }
      });
    });
  </script>
</body>
</html>
