<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/super-admin' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Super Admin' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Super Admin',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}. Ringkasan administrasi user, region, dan data laporan sistem.`,
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/users" class="btn btn-primary">Manajemen User</a>
                <a href="/users/create" class="btn btn-outline-primary">Tambah User</a>
              </div>
            `
          }) %>

          <!-- Group 1: Administrasi Akun & Pengguna -->
          <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div>
                <h6 class="fw-bold mb-0 text-dark">Administrasi Pengguna & Akun</h6>
                <div class="text-muted small">Status aktivasi akun internal pada sistem penanganan gangguan.</div>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card h-100 text-decoration-none text-reset">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">Total User Terdaftar</div>
                    <div class="fs-4 fw-bold text-dark mb-0"><%= summary.total_users %></div>
                    <div class="text-muted small mt-1">Seluruh akun internal sistem</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card h-100 text-decoration-none text-reset">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">User Aktif</div>
                    <div class="fs-4 fw-bold text-success mb-0"><%= summary.total_active_users %></div>
                    <div class="text-muted small mt-1">Dapat melakukan login & operasional</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/users" class="card app-card h-100 text-decoration-none text-reset">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">User Nonaktif</div>
                    <div class="fs-4 fw-bold text-secondary mb-0"><%= summary.total_inactive_users %></div>
                    <div class="text-muted small mt-1">Akses login ditangguhkan</div>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <!-- Group 2: Cakupan Sistem & Data Operasional -->
          <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div>
                <h6 class="fw-bold mb-0 text-dark">Data Operasional & Lingkup Sistem</h6>
                <div class="text-muted small">Agregat tiket gangguan, laporan manual, dan cakupan wilayah kerja.</div>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-4">
                <a href="/reports" class="card app-card h-100 text-decoration-none text-reset">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">Laporan Ticketing</div>
                    <div class="fs-4 fw-bold text-primary mb-0"><%= summary.total_reports %></div>
                    <div class="text-muted small mt-1">Total tiket dalam alur monitoring</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <a href="/manual-reports" class="card app-card h-100 text-decoration-none text-reset">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">Laporan Manual Non-Ticketing</div>
                    <div class="fs-4 fw-bold text-info mb-0"><%= summary.total_manual_reports %></div>
                    <div class="text-muted small mt-1">Laporan gangguan non-tiket terdata</div>
                  </div>
                </a>
              </div>

              <div class="col-12 col-md-4">
                <div class="card app-card h-100">
                  <div class="card-body">
                    <div class="text-muted small fw-semibold mb-1">Total District/Wilayah</div>
                    <div class="fs-4 fw-bold text-dark mb-0"><%= summary.total_regions %></div>
                    <div class="text-muted small mt-1">Wilayah kerja operasional (PDG / BKT)</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section: Tabel Distribusi Role & Shortcut -->
          <div class="row g-3">
            <div class="col-12 col-xl-8">
              <div class="card app-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <div>
                    <strong>User Berdasarkan Role</strong>
                    <div class="text-muted small">Ringkasan jumlah akun aktif dan nonaktif untuk setiap peran internal.</div>
                  </div>
                </div>
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Peran (Role)</th>
                          <th class="text-center">Total User</th>
                          <th class="text-center">User Aktif</th>
                          <th class="text-center">User Nonaktif</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!usersByRole || usersByRole.length === 0) { %>
                          <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                              Data role belum tersedia.
                            </td>
                          </tr>
                        <% } %>

                        <% (usersByRole || []).forEach(role => { %>
                          <tr>
                            <td>
                              <%- include('../partials/status-badge', { type: 'role', value: role.role_name }) %>
                            </td>
                            <td class="text-center"><strong><%= role.total_users %></strong></td>
                            <td class="text-center text-success fw-semibold"><%= role.total_active_users %></td>
                            <td class="text-center text-secondary"><%= role.total_inactive_users %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-4">
              <div class="card app-card h-100">
                <div class="card-header">
                  <strong>Akses Cepat Administrasi</strong>
                  <div class="text-muted small">Navigasi ke fungsi administratif utama.</div>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                  <div class="d-grid gap-2">
                    <a href="/users" class="btn btn-primary">Manajemen User</a>
                    <a href="/users/create" class="btn btn-outline-primary">Tambah User Baru</a>
                    <a href="/manual-reports" class="btn btn-outline-secondary">Laporan Manual Non-Ticketing</a>
                    <a href="/reports" class="btn btn-outline-secondary">Daftar Antrean Tiket</a>
                  </div>
                  <div class="text-muted small border-top pt-3 mt-3">
                    Akses konfigurasi akun dibatasi khusus bagi peran <span class="fw-semibold text-dark">Super Admin</span>.
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
