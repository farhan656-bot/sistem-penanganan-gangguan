<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/super-admin' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Super Admin' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Super Admin',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}. Kelola user, role, dan status akun sistem.`,
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/users" class="btn btn-primary">Kelola User</a>
                <a href="/reports/create" class="btn btn-outline-primary">Tambah Laporan Manual</a>
                <a href="/reports" class="btn btn-outline-secondary">Antrean Laporan</a>
              </div>
            `
          }) %>

          <div class="row g-3">
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                      <h5 class="card-title mb-1">Manajemen User</h5>
                      <div class="text-muted">Kelola akun internal untuk eksekutor, koordinator, supervisor, dan super admin.</div>
                    </div>
                    <span class="badge text-bg-primary">Admin</span>
                  </div>

                  <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a href="/users" class="btn btn-primary">Buka Kelola User</a>
                    <a href="/users/create" class="btn btn-outline-secondary">Tambah User</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                      <h5 class="card-title mb-1">Laporan Manual</h5>
                      <div class="text-muted">Input laporan manual sebagai fallback operasional dan pantau antrean laporan.</div>
                    </div>
                    <span class="badge text-bg-primary">Operasional</span>
                  </div>

                  <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a href="/reports/create" class="btn btn-primary">Tambah Laporan Manual</a>
                    <a href="/reports" class="btn btn-outline-secondary">Lihat Antrean</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="card app-card">
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="fw-semibold">Catatan akses role</div>
                    <div class="text-muted small">Ringkasan hak akses (read-only vs operasional).</div>
                  </div>
                  <hr class="my-3">
                  <div class="row g-2 small">
                    <div class="col-12 col-md-6 col-xl-3">
                      <div class="d-flex align-items-start gap-2">
                        <%- include('../partials/status-badge', { type: 'role', value: 'super_admin' }) %>
                        <div class="text-muted">Manajemen user dan input laporan manual.</div>
                      </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                      <div class="d-flex align-items-start gap-2">
                        <%- include('../partials/status-badge', { type: 'role', value: 'koordinator' }) %>
                        <div class="text-muted">Delegasi dan pembatalan penugasan.</div>
                      </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                      <div class="d-flex align-items-start gap-2">
                        <%- include('../partials/status-badge', { type: 'role', value: 'eksekutor' }) %>
                        <div class="text-muted">Ambil dan selesaikan tiket sesuai wilayah.</div>
                      </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                      <div class="d-flex align-items-start gap-2">
                        <%- include('../partials/status-badge', { type: 'role', value: 'supervisor' }) %>
                        <div class="text-muted">Monitoring KPI (read-only).</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
