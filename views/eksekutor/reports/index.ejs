<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const selectedFilters = filters || {};
  %>

  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/reports' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Daftar Antrean Kerja' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Daftar Antrean Kerja',
            pageSubtitle: `Wilayah: ${currentUser && currentUser.region_name ? currentUser.region_name : '-'}. Eksekutor secara default hanya dapat melihat tiket sesuai region utama. Tiket dari region lain akan tampil jika temporary region switch telah disetujui Koordinator dan masih aktif.`
          }) %>

          <%- include('../../partials/report-work-status-tabs', { workStatusTabs }) %>

          <div class="card app-card mb-3">
            <div class="card-body">
              <form method="GET" action="/reports" class="row g-2">
                <input type="hidden" name="work_status" value="<%= selectedFilters.workStatus %>">

                <div class="col-12 col-lg-7">
                  <label class="form-label">Pencarian</label>
                  <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Cari ticket ID, order ID, STO, branch, summary..."
                    value="<%= selectedFilters.search || '' %>"
                  >
                </div>

                <div class="col-12 col-md-7 col-lg-3">
                  <label class="form-label">Wilayah</label>
                  <select name="region" class="form-select">
                    <option value="" <%= !selectedFilters.region ? 'selected' : '' %>>Semua</option>
                    <option value="PDG" <%= selectedFilters.region === 'PDG' ? 'selected' : '' %>>Padang (PDG)</option>
                    <option value="BKT" <%= selectedFilters.region === 'BKT' ? 'selected' : '' %>>Bukittinggi (BKT)</option>
                  </select>
                </div>

                <div class="col-12 col-lg-2 d-flex align-items-end justify-content-end">
                  <button type="submit" class="btn btn-primary w-100">Terapkan</button>
                </div>
              </form>
            </div>
          </div>

          <div class="card app-card">
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 64px">No</th>
                      <th>Ticket ID</th>
                      <th>Order ID</th>
                      <th>Jenis Layanan</th>
                      <th>Provider</th>
                      <th>Branch</th>
                      <th>Cluster</th>
                      <th>STO</th>
                      <th>Ringkasan</th>
                      <th>Wilayah</th>
                      <th>Status</th>
                      <th>Assigned To</th>
                      <th class="app-table-actions">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!reports || reports.length === 0) { %>
                      <tr>
                        <td colspan="13" class="text-center text-muted app-table-empty">
                          Tidak ada tiket pada tab <strong><%= activeWorkStatusTab.label %></strong> untuk filter yang dipilih.
                        </td>
                      </tr>
                    <% } %>

                    <% (reports || []).forEach((report, index) => { %>
                      <tr>
                        <td><%= index + 1 %></td>
                        <td><strong><%= report.ticket_id %></strong></td>
                        <td><%= report.order_id || '-' %></td>
                        <td><%= report.service_type || '-' %></td>
                        <td><%= report.provider || '-' %></td>
                        <td><%= report.branch_name || '-' %></td>
                        <td><%= report.cluster_name || '-' %></td>
                        <td><%= report.sto || '-' %></td>
                        <td>
                          <div class="app-truncate-lg" title="<%= report.summary || '-' %>"><%= report.summary || '-' %></div>
                        </td>
                        <td><%= report.region_code || '-' %></td>
                        <td>
                          <%- include('../../partials/status-badge', { type: 'ticket', value: report.status_internal }) %>
                        </td>
                        <td>
                          <% if (report.assigned_user_name) { %>
                            <div class="fw-semibold"><%= report.assigned_user_name %></div>
                          <% } else { %>
                            <div class="text-muted">-</div>
                          <% } %>

                          <% if (report.status_internal === 'didelegasikan') { %>
                            <div class="mt-1">
                              <span class="badge text-bg-info">Delegasi Aktif</span>
                            </div>
                          <% } %>
                        </td>
                        <td class="app-table-actions">
                          <%- include('../../partials/report-action-buttons', { report }) %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <%- include('../../partials/report-detail-modal') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f027-smooth-ticket-action-ux"></script>
</body>
</html>
