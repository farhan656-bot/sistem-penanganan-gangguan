<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/eksekutor' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Eksekutor' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Eksekutor',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'User'}. Wilayah: ${currentUser && currentUser.region_name ? currentUser.region_name : '-'}.`
          }) %>

          <% if (typeof summary !== 'undefined' && summary) { %>
            <div class="row g-3 mb-3">
              <div class="col-12 col-md-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body">
                    <div class="text-muted small">Tiket Tersedia</div>
                    <h3 class="mb-0 text-primary"><%= summary.total_available %></h3>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body">
                    <div class="text-muted small">Sedang Ditangani</div>
                    <h3 class="mb-0 text-warning"><%= summary.total_in_progress %></h3>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body">
                    <div class="text-muted small">Perlu Tindak Lanjut</div>
                    <h3 class="mb-0 text-warning"><%= summary.total_follow_up %></h3>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-xl-3">
                <div class="card app-card h-100">
                  <div class="card-body">
                    <div class="text-muted small">Eskalasi</div>
                    <h3 class="mb-0 text-danger"><%= summary.total_escalated %></h3>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <div class="row g-3">
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                      <h5 class="card-title mb-1">Daftar Antrean Kerja</h5>
                      <div class="text-muted">Lihat tiket yang tersedia, cek status penanganan, lalu ambil tugas sesuai rule wilayah dan status.</div>
                    </div>
                    <span class="badge text-bg-primary">Tugas</span>
                  </div>

                  <div class="mt-3">
                    <a href="/reports" class="btn btn-primary">Buka Antrean Kerja</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                      <h5 class="card-title mb-1">Pengajuan Switch Region</h5>
                      <div class="text-muted">Ajukan akses wilayah tambahan bila diperlukan (sesuai aturan F007). Pantau status pengajuan dan masa aktif.</div>
                    </div>
                    <span class="badge text-bg-primary">F007</span>
                  </div>

                  <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a href="/region-switch/my" class="btn btn-primary">Lihat Pengajuan</a>
                    <a href="/region-switch/create" class="btn btn-outline-primary">Ajukan Switch Region</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
