<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <% function formatRemainingTime(value) { %>
    <% if (!value) { return '-'; } %>
    <% try { %>
      <% const endDate = new Date(value); %>
      <% if (Number.isNaN(endDate.getTime())) { return value; } %>
      <% const now = new Date(); %>
      <% const diffMs = endDate.getTime() - now.getTime(); %>
      <% if (diffMs <= 0) { return 'Expired'; } %>
      <% const totalMinutes = Math.floor(diffMs / 60000); %>
      <% const hours = Math.floor(totalMinutes / 60); %>
      <% const minutes = totalMinutes % 60; %>
      <% if (hours > 0) { return `${hours} jam ${minutes} menit`; } %>
      <% return `${minutes} menit`; %>
    <% } catch (error) { return value; } %>
  <% } %>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/my' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Pengajuan Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Pengajuan Switch Region',
            pageSubtitle: 'Pantau status pengajuan switch region (F007).',
            pageActions: `
              <a href="/region-switch/create" class="btn btn-primary">Ajukan Switch Region</a>
            `
          }) %>

          <div class="card app-card">
            <div class="card-body">
              <% if (!requests || requests.length === 0) { %>
                <div class="text-muted">Belum ada pengajuan switch region.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th style="width: 64px">No</th>
                        <th>Region Asal</th>
                        <th>Region Tujuan</th>
                        <th>Alasan</th>
                        <th>Status</th>
                        <th>Diajukan</th>
                        <th>Disetujui Oleh</th>
                        <th>Disetujui</th>
                        <th>Mulai</th>
                        <th>Berakhir</th>
                        <th class="text-nowrap">Sisa Waktu</th>
                        <th>Catatan</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% requests.forEach((request, index) => { %>
                        <tr>
                          <td><%= index + 1 %></td>
                          <td><%= request.home_region_name || '-' %></td>
                          <td><%= request.target_region_name || '-' %></td>
                          <td>
                            <div class="app-truncate" title="<%= request.reason || '-' %>"><%= request.reason || '-' %></div>
                          </td>
                          <td>
                            <%- include('../../partials/status-badge', { type: 'region_switch', value: request.status }) %>
                          </td>
                          <td><span class="text-muted"><%= formatDateTime(request.requested_at) %></span></td>
                          <td><%= request.approved_by_name || '-' %></td>
                          <td><span class="text-muted"><%= formatDateTime(request.approved_at) %></span></td>
                          <td><span class="text-muted"><%= formatDateTime(request.start_at) %></span></td>
                          <td><span class="text-muted"><%= formatDateTime(request.end_at) %></span></td>
                          <td class="text-nowrap"><%= formatRemainingTime(request.end_at) %></td>
                          <td>
                            <div class="app-truncate" title="<%= request.rejection_reason || '-' %>"><%= request.rejection_reason || '-' %></div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
