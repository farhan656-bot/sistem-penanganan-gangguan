<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <% function formatRemainingTime(value) { %>
    <% if (!value) { return '-'; } %>
    <% try { %>
      <% const endDate = new Date(value); %>
      <% if (Number.isNaN(endDate.getTime())) { return value; } %>
      <% const now = new Date(); %>
      <% const diffMs = endDate.getTime() - now.getTime(); %>
      <% if (diffMs <= 0) { return 'Expired'; } %>
      <% const totalMinutes = Math.floor(diffMs / 60000); %>
      <% const hours = Math.floor(totalMinutes / 60); %>
      <% const minutes = totalMinutes % 60; %>
      <% if (hours > 0) { return `${hours} jam ${minutes} menit`; } %>
      <% return `${minutes} menit`; %>
    <% } catch (error) { return value; } %>
  <% } %>

  <%
    const activeSwitch = (requests || []).find((r) => {
      if (r.status !== 'approved') return false;
      if (!r.end_at) return true;
      const end = new Date(r.end_at);
      return !Number.isNaN(end.getTime()) && end.getTime() > Date.now();
    });
  %>

  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/my' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Pengajuan Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Pengajuan Switch Region',
            pageSubtitle: 'Akses region sementara digunakan untuk mendukung kebutuhan operasional lintas region berdasarkan persetujuan Koordinator.',
            pageActions: `
              <a href="/region-switch/create" class="btn btn-primary">Ajukan Switch Region</a>
            `
          }) %>

          <!-- Ringkasan Akses Sementara Aktif -->
          <% if (activeSwitch) { %>
            <div class="card app-card mb-4 border-success">
              <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 bg-success-subtle">
                <div class="d-flex align-items-center gap-2">
                  <strong class="text-success-emphasis">Status Akses Wilayah Sementara: Aktif</strong>
                  <span class="badge text-bg-success">Aktif</span>
                </div>
                <div class="text-muted small">
                  Sisa Waktu: <strong class="text-success-emphasis font-monospace"><%= formatRemainingTime(activeSwitch.end_at) %></strong>
                </div>
              </div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-sm-6 col-md-3">
                    <div class="text-muted small">Region Asal (Utama)</div>
                    <div class="fw-semibold text-dark">
                      <% if (activeSwitch.home_region_code) { %>
                        <span class="badge text-bg-light border font-monospace me-1"><%= activeSwitch.home_region_code %></span>
                      <% } %>
                      <%= activeSwitch.home_region_name || '-' %>
                    </div>
                  </div>
                  <div class="col-12 col-sm-6 col-md-3">
                    <div class="text-muted small">Region Tujuan (Akses Sementara)</div>
                    <div class="fw-semibold text-dark">
                      <% if (activeSwitch.target_region_code) { %>
                        <span class="badge text-bg-primary font-monospace me-1"><%= activeSwitch.target_region_code %></span>
                      <% } %>
                      <%= activeSwitch.target_region_name || '-' %>
                    </div>
                  </div>
                  <div class="col-12 col-sm-6 col-md-3">
                    <div class="text-muted small">Periode Akses</div>
                    <div class="small">
                      <div>Mulai: <span class="fw-medium text-dark"><%= formatDateTime(activeSwitch.start_at) %></span></div>
                      <div>Berakhir: <span class="fw-medium text-dark"><%= formatDateTime(activeSwitch.end_at) %></span></div>
                    </div>
                  </div>
                  <div class="col-12 col-sm-6 col-md-3">
                    <div class="text-muted small">Disetujui Oleh</div>
                    <div class="fw-semibold text-dark"><%= activeSwitch.approved_by_name || '-' %></div>
                    <div class="text-muted small"><%= formatDateTime(activeSwitch.approved_at) %></div>
                  </div>
                  <% if (activeSwitch.reason) { %>
                    <div class="col-12 pt-2 border-top">
                      <div class="text-muted small">Alasan Pengajuan:</div>
                      <div class="text-dark small"><%= activeSwitch.reason %></div>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="card app-card mb-4">
              <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div>
                    <div class="text-muted small">Status Akses Wilayah Saat Ini</div>
                    <div class="fw-semibold text-dark">
                      Wilayah Utama: <span class="badge text-bg-light border font-monospace me-1"><%= currentUser.region_name || '-' %></span>
                      <span class="text-muted fw-normal ms-2 small">Tidak ada akses region sementara yang sedang aktif.</span>
                    </div>
                  </div>
                  <span class="badge text-bg-secondary">Standar Operasional</span>
                </div>
              </div>
            </div>
          <% } %>

          <!-- Riwayat Pengajuan Switch Region -->
          <div class="card app-card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <strong>Riwayat Pengajuan Switch Region</strong>
                <div class="text-muted small">Catatan seluruh permohonan akses wilayah sementara yang telah diajukan.</div>
              </div>
              <span class="badge text-bg-light border">Total: <%= (requests || []).length %> pengajuan</span>
            </div>
            <div class="card-body p-0">
              <% if (!requests || requests.length === 0) { %>
                <div class="text-center text-muted p-4 app-table-empty">Belum ada pengajuan switch region.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead>
                      <tr>
                        <th class="app-col-num">No</th>
                        <th>Region Asal</th>
                        <th>Region Tujuan</th>
                        <th>Alasan Pengajuan</th>
                        <th>Status</th>
                        <th class="app-col-time">Waktu Pengajuan</th>
                        <th>Disetujui Oleh</th>
                        <th>Mulai Akses</th>
                        <th>Berakhir Akses</th>
                        <th class="text-nowrap">Sisa Waktu</th>
                        <th>Catatan Penolakan</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% requests.forEach((request, index) => { %>
                        <tr>
                          <td class="app-col-num text-muted"><%= index + 1 %></td>
                          <td>
                            <% if (request.home_region_code) { %>
                              <span class="badge text-bg-light border font-monospace me-1"><%= request.home_region_code %></span>
                            <% } %>
                            <span class="fw-medium text-dark"><%= request.home_region_name || '-' %></span>
                          </td>
                          <td>
                            <% if (request.target_region_code) { %>
                              <span class="badge text-bg-light border font-monospace me-1"><%= request.target_region_code %></span>
                            <% } %>
                            <span class="fw-semibold text-dark"><%= request.target_region_name || '-' %></span>
                          </td>
                          <td>
                            <div class="app-truncate" title="<%= request.reason || '-' %>"><%= request.reason || '-' %></div>
                          </td>
                          <td>
                            <%- include('../../partials/status-badge', { type: 'region_switch', value: request.status }) %>
                          </td>
                          <td class="text-muted small"><%= formatDateTime(request.requested_at) %></td>
                          <td>
                            <span class="text-secondary"><%= request.approved_by_name || '-' %></span>
                          </td>
                          <td class="text-muted small"><%= formatDateTime(request.start_at) %></td>
                          <td class="text-muted small"><%= formatDateTime(request.end_at) %></td>
                          <td class="text-nowrap">
                            <% if (request.status === 'approved') { %>
                              <span class="font-monospace fw-semibold <%= formatRemainingTime(request.end_at) === 'Expired' ? 'text-secondary' : 'text-primary' %>">
                                <%= formatRemainingTime(request.end_at) %>
                              </span>
                            <% } else { %>
                              <span class="text-muted">-</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (request.rejection_reason) { %>
                              <div class="app-truncate text-danger small" title="<%= request.rejection_reason %>"><%= request.rejection_reason %></div>
                            <% } else { %>
                              <span class="text-muted small">-</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
