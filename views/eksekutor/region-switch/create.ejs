<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/my' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Form Pengajuan Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Form Pengajuan Switch Region',
            pageSubtitle: 'Akses region sementara digunakan untuk mendukung kebutuhan operasional lintas region berdasarkan persetujuan Koordinator.',
            pageActions: `
              <a href="/region-switch/my" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <div class="card app-card mb-4">
            <div class="card-header">
              <strong>Formulir Permohonan Akses Region Sementara</strong>
              <div class="text-muted small">Lengkapi data wilayah tujuan dan alasan permohonan akses operasional.</div>
            </div>
            <div class="card-body">
              <form action="/region-switch" method="POST">
                <div class="row g-3">
                  <!-- Region Utama (Asal) -->
                  <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-secondary" for="homeRegionInput">
                      Region Utama (Asal)
                    </label>
                    <input
                      type="text"
                      id="homeRegionInput"
                      class="form-control bg-light"
                      value="<%= currentUser.region_name || '-' %>"
                      readonly
                    >
                    <div class="form-text">Wilayah kerja penugasan utama berdasarkan data profil akun Anda.</div>
                  </div>

                  <!-- Region Tujuan -->
                  <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-secondary" for="targetRegionSelect">
                      Region Tujuan <span class="app-required">*</span>
                    </label>
                    <select
                      id="targetRegionSelect"
                      name="target_region_id"
                      class="form-select"
                      required
                    >
                      <option value="">Pilih region tujuan...</option>
                      <% regions.forEach((region) => { %>
                        <% if (Number(region.id) !== Number(homeRegionId)) { %>
                          <option
                            value="<%= region.id %>"
                            <%= String(formData.target_region_id) === String(region.id) ? 'selected' : '' %>
                          >
                            <%= region.name %> (<%= region.code %>)
                          </option>
                        <% } %>
                      <% }) %>
                    </select>
                    <div class="form-text">Pilih wilayah kerja operasional yang berbeda dari wilayah utama Anda.</div>
                  </div>

                  <!-- Alasan Pengajuan -->
                  <div class="col-12">
                    <label class="form-label small fw-semibold text-secondary" for="regionSwitchReason">
                      Alasan Pengajuan <span class="app-required">*</span>
                    </label>
                    <textarea
                      id="regionSwitchReason"
                      name="reason"
                      class="form-control"
                      rows="4"
                      placeholder="Jelaskan kebutuhan penanganan gangguan atau bantuan operasional di wilayah tujuan..."
                      required
                    ><%= formData.reason %></textarea>
                    <div class="form-text">Uraikan alasan secara ringkas dan jelas agar memudahkan proses verifikasi Koordinator.</div>
                  </div>
                </div>

                <!-- Tombol Aksi Form -->
                <div class="d-flex gap-2 justify-content-end mt-4">
                  <a href="/region-switch/my" class="btn btn-outline-secondary">Batal</a>
                  <button type="submit" class="btn btn-primary">Kirim Pengajuan</button>
                </div>
              </form>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
