<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/my' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Form Pengajuan Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Form Pengajuan Switch Region',
            pageSubtitle: 'Ajukan akses wilayah tambahan untuk penanganan tiket (F007).',
            pageActions: `
              <a href="/region-switch/my" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <div class="card app-card">
            <div class="card-body">
              <form action="/region-switch" method="POST">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label">Region Utama</label>
                    <input
                      type="text"
                      class="form-control"
                      value="<%= currentUser.region_name || '-' %>"
                      readonly
                    >
                    <div class="form-text">Wilayah ini berasal dari profil akun eksekutor.</div>
                  </div>

                  <div class="col-12">
                    <label class="form-label">Region Tujuan</label>
                    <select name="target_region_id" class="form-select" required>
                      <option value="">Pilih region tujuan</option>
                      <% regions.forEach((region) => { %>
                        <% if (Number(region.id) !== Number(homeRegionId)) { %>
                          <option
                            value="<%= region.id %>"
                            <%= String(formData.target_region_id) === String(region.id) ? 'selected' : '' %>
                          >
                            <%= region.name %> (<%= region.code %>)
                          </option>
                        <% } %>
                      <% }) %>
                    </select>
                    <div class="form-text">Pilih wilayah tujuan yang berbeda dari region utama.</div>
                  </div>

                  <div class="col-12">
                    <label class="form-label">Alasan Pengajuan</label>
                    <textarea
                      name="reason"
                      class="form-control"
                      rows="4"
                      placeholder="Jelaskan alasan kebutuhan akses region tambahan..."
                      required
                    ><%= formData.reason %></textarea>
                    <div class="form-text">Tulis alasan singkat dan jelas agar memudahkan proses review koordinator.</div>
                  </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                  <button type="submit" class="btn btn-primary">Kirim Pengajuan</button>
                  <a href="/region-switch/my" class="btn btn-outline-secondary">Batal</a>
                </div>
              </form>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
