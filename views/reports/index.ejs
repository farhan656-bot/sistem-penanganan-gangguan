<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/reports' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Daftar Antrean Kerja' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Daftar Antrean Kerja',
            pageSubtitle: 'Pantau antrean laporan dan lakukan aksi sesuai hak akses.',
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                ${(currentUser && (currentUser.role === 'koordinator' || currentUser.role === 'super_admin'))
                  ? '<a href="/reports/create" class="btn btn-primary">Tambah Laporan Manual</a>'
                  : ''
                }
              </div>
            `
          }) %>

          <div class="card app-card mb-3">
            <div class="card-body">
              <form method="GET" action="/reports" class="row g-3">
                <div class="col-12 col-lg-4">
                  <label class="form-label">Pencarian</label>
                  <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Cari ticket ID, order ID, STO, branch, summary..."
                    value="<%= filters.search %>"
                  >
                </div>

                <div class="col-12 col-lg-3">
                  <label class="form-label">Status Internal</label>
                  <select name="status" class="form-select">
                    <option value="">Semua</option>
                    <option value="tersedia" <%= filters.status === 'tersedia' ? 'selected' : '' %>>Tersedia</option>
                    <option value="diambil" <%= filters.status === 'diambil' ? 'selected' : '' %>>Diambil</option>
                    <option value="didelegasikan" <%= filters.status === 'didelegasikan' ? 'selected' : '' %>>Didelegasikan</option>
                    <option value="selesai" <%= filters.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                    <option value="perlu_tindak_lanjut" <%= filters.status === 'perlu_tindak_lanjut' ? 'selected' : '' %>>Perlu Tindak Lanjut</option>
                    <option value="eskalasi" <%= filters.status === 'eskalasi' ? 'selected' : '' %>>Eskalasi</option>
                  </select>
                </div>

                <div class="col-12 col-lg-3">
                  <label class="form-label">Wilayah</label>
                  <select name="region" class="form-select">
                    <option value="">Semua</option>
                    <option value="PDG" <%= filters.region === 'PDG' ? 'selected' : '' %>>Padang (PDG)</option>
                    <option value="BKT" <%= filters.region === 'BKT' ? 'selected' : '' %>>Bukittinggi (BKT)</option>
                  </select>
                </div>

                <div class="col-12 col-lg-2 d-flex align-items-end">
                  <button type="submit" class="btn btn-outline-primary w-100">Terapkan</button>
                </div>
              </form>
            </div>
          </div>

          <div class="card app-card">
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 64px">No</th>
                      <th>Ticket ID</th>
                      <th>Order ID</th>
                      <th>Jenis Layanan</th>
                      <th>Provider</th>
                      <th>Branch</th>
                      <th>Cluster</th>
                      <th>STO</th>
                      <th>Ringkasan</th>
                      <th>Wilayah</th>
                      <th style="width: 160px">Status</th>
                      <th style="width: 200px">Assigned To</th>
                      <th style="width: 170px" class="text-center">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!reports || reports.length === 0) { %>
                      <tr>
                        <td colspan="13" class="text-center text-muted app-table-empty">Belum ada data laporan.</td>
                      </tr>
                    <% } %>

                    <% (reports || []).forEach((report, index) => { %>
                      <tr>
                        <td class="text-muted"><%= index + 1 %></td>
                        <td class="fw-semibold"><%= report.ticket_id %></td>
                        <td><%= report.order_id || '-' %></td>
                        <td><%= report.service_type || '-' %></td>
                        <td><%= report.provider || '-' %></td>
                        <td><%= report.branch_name || '-' %></td>
                        <td><%= report.cluster_name || '-' %></td>
                        <td><%= report.sto || '-' %></td>
                        <td>
                          <div class="app-truncate" title="<%= report.summary || '-' %>"><%= report.summary || '-' %></div>
                        </td>
                        <td><%= report.region_code || '-' %></td>
                        <td>
                          <%- include('../partials/status-badge', { type: 'ticket', value: report.status_internal }) %>
                        </td>
                        <td>
                          <div class="fw-semibold"><%= report.assigned_user_name || '-' %></div>
                          <% if (report.status_internal === 'didelegasikan') { %>
                            <div class="mt-1"><span class="badge text-bg-info">Delegasi Aktif</span></div>
                          <% } %>
                        </td>
                        <td class="text-center app-table-actions">
                          <div class="d-flex gap-1 justify-content-center">
                            <a href="/reports/<%= report.id %>" class="btn btn-sm btn-outline-secondary">Detail</a>

                            <% if (currentUser.role === 'eksekutor' && report.status_internal === 'tersedia') { %>
                              <form action="/reports/<%= report.id %>/take" method="POST" class="m-0" onsubmit="return confirm('Ambil laporan ini?');">
                                <button type="submit" class="btn btn-sm btn-primary">Ambil</button>
                              </form>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>