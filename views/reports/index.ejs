<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .summary-cell {
      max-width: 320px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
</head>
<body class="bg-light">
  <div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="mb-1">Daftar Antrean Kerja</h3>
        <p class="mb-0 text-muted">
          Login sebagai: <strong><%= currentUser.full_name %></strong>
          (<%= currentUser.role %>)
          <% if (currentUser.region_name) { %>
            - Wilayah <strong><%= currentUser.region_name %></strong>
          <% } %>
        </p>
      </div>

      <div class="d-flex gap-2">
        <% if (currentUser.role === 'eksekutor') { %>
          <a href="/dashboard/eksekutor" class="btn btn-outline-secondary">Dashboard</a>
        <% } %>
        <% if (currentUser.role === 'koordinator') { %>
          <a href="/dashboard/koordinator" class="btn btn-outline-secondary">Dashboard</a>
        <% } %>

        <form action="/auth/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger">Logout</button>
        </form>
      </div>
    </div>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg[0] %></div>
    <% } %>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg[0] %></div>
    <% } %>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <form method="GET" action="/reports" class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Pencarian</label>
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="Cari ticket ID, order ID, STO, branch, summary..."
              value="<%= filters.search %>"
            >
          </div>

          <div class="col-md-3">
            <label class="form-label">Status Internal</label>
            <select name="status" class="form-select">
              <option value="">Semua</option>
              <option value="baru" <%= filters.status === 'baru' ? 'selected' : '' %>>Baru</option>
              <option value="tersedia" <%= filters.status === 'tersedia' ? 'selected' : '' %>>Tersedia</option>
              <option value="diambil" <%= filters.status === 'diambil' ? 'selected' : '' %>>Diambil</option>
              <option value="didelegasikan" <%= filters.status === 'didelegasikan' ? 'selected' : '' %>>Didelegasikan</option>
              <option value="selesai" <%= filters.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Wilayah</label>
            <select name="region" class="form-select" <%= currentUser.role === 'eksekutor' ? 'disabled' : '' %>>
              <option value="">Semua</option>
              <option value="PDG" <%= filters.region === 'PDG' ? 'selected' : '' %>>Padang (PDG)</option>
              <option value="BKT" <%= filters.region === 'BKT' ? 'selected' : '' %>>Bukittinggi (BKT)</option>
            </select>

            <% if (currentUser.role === 'eksekutor') { %>
              <input type="hidden" name="region" value="<%= currentUser.region_code %>">
            <% } %>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>No</th>
                <th>Ticket ID</th>
                <th>Order ID</th>
                <th>Jenis Layanan</th>
                <th>Provider</th>
                <th>Branch</th>
                <th>Cluster</th>
                <th>STO</th>
                <th>Ringkasan</th>
                <th>Wilayah</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (reports.length === 0) { %>
                <tr>
                  <td colspan="13" class="text-center text-muted">Belum ada data laporan.</td>
                </tr>
              <% } %>

              <% reports.forEach((report, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><strong><%= report.ticket_id %></strong></td>
                  <td><%= report.order_id || '-' %></td>
                  <td><%= report.service_type || '-' %></td>
                  <td><%= report.provider || '-' %></td>
                  <td><%= report.branch_name || '-' %></td>
                  <td><%= report.cluster_name || '-' %></td>
                  <td><%= report.sto || '-' %></td>
                  <td class="summary-cell" title="<%= report.summary %>"><%= report.summary %></td>
                  <td><%= report.region_code || '-' %></td>
                  <td>
                    <% if (report.status_internal === 'baru') { %>
                      <span class="badge bg-secondary">Baru</span>
                    <% } else if (report.status_internal === 'tersedia') { %>
                      <span class="badge bg-primary">Tersedia</span>
                    <% } else if (report.status_internal === 'diambil') { %>
                      <span class="badge bg-warning text-dark">Diambil</span>
                    <% } else if (report.status_internal === 'didelegasikan') { %>
                      <span class="badge bg-info text-dark">Didelegasikan</span>
                    <% } else if (report.status_internal === 'selesai') { %>
                      <span class="badge bg-success">Selesai</span>
                    <% } else { %>
                      <span class="badge bg-dark">-</span>
                    <% } %>
                  </td>
                  <td><%= report.assigned_user_name || '-' %></td>
                <td>
                  <div class="d-flex gap-1 flex-wrap">
                    <a href="/reports/<%= report.id %>" class="btn btn-sm btn-outline-secondary">Detail</a>

                    <% if (currentUser.role === 'eksekutor' && report.status_internal === 'tersedia') { %>
                      <form action="/reports/<%= report.id %>/take" method="POST" onsubmit="return confirm('Ambil laporan ini?');">
                        <button type="submit" class="btn btn-sm btn-primary">Ambil Tugas</button>
                      </form>
                    <% } %>
                  </div>
                </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</body>
</html>