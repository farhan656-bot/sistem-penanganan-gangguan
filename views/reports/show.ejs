<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="mb-1">Detail Laporan</h3>
        <p class="mb-0 text-muted">
          Ticket ID: <strong><%= report.ticket_id %></strong>
        </p>
      </div>

      <div class="d-flex gap-2">
        <a href="/reports" class="btn btn-outline-secondary">Kembali</a>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger">Logout</button>
        </form>
      </div>
    </div>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger"><%= error_msg[0] %></div>
    <% } %>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success"><%= success_msg[0] %></div>
    <% } %>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label fw-bold">Ticket ID</label>
            <div><%= report.ticket_id %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Order ID</label>
            <div><%= report.order_id || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Jenis Layanan</label>
            <div><%= report.service_type || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Provider</label>
            <div><%= report.provider || '-' %></div>
          </div>

          <div class="col-md-3">
            <label class="form-label fw-bold">Branch</label>
            <div><%= report.branch_name || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Cluster</label>
            <div><%= report.cluster_name || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">STO</label>
            <div><%= report.sto || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Wilayah Laporan</label>
            <div><%= report.current_region_code || '-' %></div>
          </div>

          <div class="col-md-12">
            <label class="form-label fw-bold">Ringkasan</label>
            <div><%= report.summary || '-' %></div>
          </div>

          <div class="col-md-3">
            <label class="form-label fw-bold">Status Internal</label>
            <div><%= report.status_internal %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Assigned To</label>
            <div><%= report.assigned_user_name || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Waktu Ambil</label>
            <div><%= report.taken_at || '-' %></div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Waktu Selesai</label>
            <div><%= report.resolved_at || '-' %></div>
          </div>

          <div class="col-md-12">
            <label class="form-label fw-bold">Catatan Penyelesaian</label>
            <div><%= report.completion_notes || '-' %></div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-bold">Status Akhir</label>
            <div><%= report.completion_status || '-' %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-header">
        <strong>Bukti Penyelesaian</strong>
      </div>
      <div class="card-body">
        <% if (attachments.length === 0) { %>
          <p class="text-muted mb-0">Belum ada file bukti.</p>
        <% } %>

        <% attachments.forEach(file => { %>
          <div class="mb-2">
            <a href="<%= file.file_path %>" target="_blank"><%= file.file_name %></a>
            <span class="text-muted small">- diunggah oleh <%= file.uploaded_by_name %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <% if (
      currentUser.role === 'eksekutor' &&
      ['diambil', 'didelegasikan'].includes(report.status_internal) &&
      Number(report.current_assigned_user_id) === Number(currentUser.id)
    ) { %>
      <div class="card shadow-sm mb-4">
        <div class="card-header">
          <strong>Konfirmasi Penyelesaian</strong>
        </div>
        <div class="card-body">
          <form action="/reports/<%= report.id %>/complete" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label">Catatan Penyelesaian</label>
              <textarea name="completion_notes" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Status Akhir</label>
              <select name="completion_status" class="form-select" required>
                <option value="">Pilih status akhir</option>
                <option value="Selesai">Selesai</option>
                <option value="Selesai Sebagian">Selesai Sebagian</option>
                <option value="Perlu Tindak Lanjut">Perlu Tindak Lanjut</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label">Upload Bukti</label>
              <input type="file" name="proof_file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" required>
              <div class="form-text">Format: JPG, PNG, WEBP, atau PDF. Maksimal 5 MB.</div>
            </div>

            <button type="submit" class="btn btn-success" onclick="return confirm('Yakin ingin menyelesaikan laporan ini?');">
              Konfirmasi Selesai
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (
      currentUser.role === 'koordinator' &&
      ['tersedia', 'diambil', 'didelegasikan'].includes(report.status_internal)
    ) { %>
      <div class="card shadow-sm mb-4">
        <div class="card-header">
          <strong>Delegasi Penanggung Jawab Lintas Wilayah</strong>
        </div>
        <div class="card-body">
          <form action="/reports/<%= report.id %>/delegate" method="POST">
            <div class="mb-3">
              <label class="form-label">Pilih Pegawai Tujuan</label>
              <select name="target_user_id" class="form-select" required>
                <option value="">Pilih pegawai eksekutor</option>
                <% eksekutorUsers.forEach(user => { %>
                  <% if (Number(user.id) !== Number(report.current_assigned_user_id)) { %>
                    <option value="<%= user.id %>">
                      <%= user.full_name %> - <%= user.region_code || '-' %>
                    </option>
                  <% } %>
                <% }) %>
              </select>
              <div class="form-text">
                Pilihan pegawai hanya ditampilkan dari wilayah lawan.
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Alasan Delegasi</label>
              <textarea name="delegation_notes" class="form-control" rows="3" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" onclick="return confirm('Yakin ingin mendelegasikan laporan ini?');">
              Delegasikan
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (
      currentUser.role === 'koordinator' &&
      ['diambil', 'didelegasikan'].includes(report.status_internal) &&
      report.current_assigned_user_id
    ) { %>
      <div class="card shadow-sm">
        <div class="card-header">
          <strong>Batalkan Penugasan</strong>
        </div>
        <div class="card-body">
          <form action="/reports/<%= report.id %>/cancel-assignment" method="POST">
            <div class="mb-3">
              <label class="form-label">Alasan Pembatalan</label>
              <textarea name="cancel_notes" class="form-control" rows="3" required></textarea>
            </div>

            <button type="submit" class="btn btn-danger" onclick="return confirm('Yakin ingin membatalkan penugasan ini?');">
              Batalkan Tugas
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>