<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Login Sistem' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-page">
  <div class="container">
    <div class="row justify-content-center align-items-center app-login-row">
      <div class="col-12 col-md-7 col-lg-5">
        <div class="app-card p-4 p-md-4">
          <div class="text-center mb-4">
            <div class="app-brand-login mb-3 text-center">
              <img src="/images/telkom-logo.png" alt="PT Telkom Indonesia" class="app-brand-logo-login">
            </div>

            <h1 class="h4 mb-1">Sistem Informasi Pengelolaan dan Monitoring Penanganan Gangguan</h1>
            <div class="text-muted small">Divisi Data Management</div>
            <div class="text-muted small">PT Telkom Sumbar Witel Padang</div>
          </div>

          <div class="mb-3">
            <h2 class="h6 mb-1">Login Sistem</h2>
            <div class="text-muted small">Masukkan username dan password untuk melanjutkan.</div>
          </div>

          <% if (error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show app-flash" role="alert">
              <%= error_msg[0] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show app-flash" role="alert" data-auto-dismiss="true" data-auto-dismiss-delay="4000">
              <%= success_msg[0] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <form action="/auth/login" method="POST">
            <div class="mb-3">
              <label for="usernameInput" class="form-label fw-semibold">Username</label>
              <input id="usernameInput" type="text" name="username" class="form-control" autocomplete="username" autofocus required>
            </div>

            <div class="mb-3">
              <label for="passwordInput" class="form-label fw-semibold">Password</label>
              <div class="input-group">
                <input id="passwordInput" type="password" name="password" class="form-control" autocomplete="current-password" required>
                <button id="togglePasswordBtn" class="btn btn-outline-secondary" type="button" aria-label="Tampilkan password">
                  Lihat
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Login</button>
          </form>

          <div class="mt-3 text-muted small">
            Gunakan akun yang telah didaftarkan oleh administrator. Jika mengalami kendala login, hubungi Superadmin Divisi Data Management.
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
  <script>
    (function () {
      var passwordInput = document.getElementById('passwordInput');
      var toggleButton = document.getElementById('togglePasswordBtn');
      if (!passwordInput || !toggleButton) return;

      toggleButton.addEventListener('click', function () {
        var isHidden = passwordInput.type === 'password';
        passwordInput.type = isHidden ? 'text' : 'password';
        toggleButton.textContent = isHidden ? 'Sembunyikan' : 'Lihat';
        toggleButton.setAttribute('aria-label', isHidden ? 'Sembunyikan password' : 'Tampilkan password');
      });
    })();
  </script>
</body>
</html>
