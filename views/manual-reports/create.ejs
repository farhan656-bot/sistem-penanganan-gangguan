<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/manual-reports' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Tambah Laporan Manual' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Tambah Laporan Manual',
            pageSubtitle: 'Input pekerjaan non-ticketing ke tabel laporan manual.',
            pageActions: `
              <a href="/manual-reports" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <form action="/manual-reports" method="POST">
            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Informasi Utama</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Tanggal <span class="app-required">*</span></label>
                    <input
                      type="date"
                      name="report_date"
                      class="form-control"
                      value="<%= formData.report_date %>"
                      required
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Aktivitas</label>
                    <input
                      type="text"
                      name="activity"
                      class="form-control"
                      value="<%= formData.activity %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Pengerjaan</label>
                    <input
                      type="text"
                      name="work_type"
                      class="form-control"
                      value="<%= formData.work_type %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">S/E</label>
                    <input
                      type="text"
                      name="se_status"
                      class="form-control"
                      value="<%= formData.se_status %>"
                    >
                  </div>

                  <div class="col-12">
                    <label class="form-label">Details <span class="app-required">*</span></label>
                    <textarea
                      name="details"
                      class="form-control"
                      rows="4"
                      required
                    ><%= formData.details %></textarea>
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Data Order dan Pelanggan</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">OrderID OSM</label>
                    <input
                      type="text"
                      name="osm_order_id"
                      class="form-control"
                      value="<%= formData.osm_order_id %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">STO</label>
                    <input
                      type="text"
                      name="sto"
                      class="form-control"
                      value="<%= formData.sto %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">SC</label>
                    <input
                      type="text"
                      name="sc"
                      class="form-control"
                      value="<%= formData.sc %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">OrderID / NCX-ID</label>
                    <input
                      type="text"
                      name="order_ncx_id"
                      class="form-control"
                      value="<%= formData.order_ncx_id %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">NCLI</label>
                    <input
                      type="text"
                      name="ncli"
                      class="form-control"
                      value="<%= formData.ncli %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Nama Customer</label>
                    <input
                      type="text"
                      name="customer_name"
                      class="form-control"
                      value="<%= formData.customer_name %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Witel</label>
                    <input
                      type="text"
                      name="witel"
                      class="form-control"
                      value="<%= formData.witel %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">K-Kontak</label>
                    <input
                      type="text"
                      name="k_kontak"
                      class="form-control"
                      value="<%= formData.k_kontak %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">User ID</label>
                    <input
                      type="text"
                      name="user_id_text"
                      class="form-control"
                      value="<%= formData.user_id_text %>"
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Data Alpro dan Incident</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Nama Alpro Before</label>
                    <input
                      type="text"
                      name="alpro_before"
                      class="form-control"
                      value="<%= formData.alpro_before %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Nama Alpro</label>
                    <input
                      type="text"
                      name="alpro_name"
                      class="form-control"
                      value="<%= formData.alpro_name %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Ticket Incident</label>
                    <input
                      type="text"
                      name="ticket_incident"
                      class="form-control"
                      value="<%= formData.ticket_incident %>"
                    >
                  </div>

                  <div class="col-12">
                    <label class="form-label">Incident</label>
                    <textarea
                      name="incident"
                      class="form-control"
                      rows="3"
                    ><%= formData.incident %></textarea>
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Transaksi dan Resolved</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Tipe Transaksi</label>
                    <input
                      type="text"
                      name="transaction_type"
                      class="form-control"
                      value="<%= formData.transaction_type %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Jenis Fallout</label>
                    <input
                      type="text"
                      name="fallout_type"
                      class="form-control"
                      value="<%= formData.fallout_type %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Ticket Resolved</label>
                    <input
                      type="text"
                      name="ticket_resolved"
                      class="form-control"
                      value="<%= formData.ticket_resolved %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Ticket Resolved 2</label>
                    <input
                      type="text"
                      name="ticket_resolved_2"
                      class="form-control"
                      value="<%= formData.ticket_resolved_2 %>"
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button type="submit" class="btn btn-primary">Simpan Laporan Manual</button>
              <a href="/manual-reports" class="btn btn-outline-secondary">Batal</a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f017-manual-report"></script>
</body>
</html>
