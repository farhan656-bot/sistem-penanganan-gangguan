<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const report = manualReport || {};
    const display = (value) => value ? value : '-';
  %>

  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/manual-reports' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Detail Laporan Manual' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Detail Laporan Manual',
            pageSubtitle: `Tanggal: ${formatDate(report.report_date)}`,
            pageActions: `
              <a href="/manual-reports" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <div class="card app-card mb-3">
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Tanggal</div>
                  <div class="fw-semibold"><%= formatDate(report.report_date) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Region</div>
                  <div><%= report.region_code || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Dibuat Oleh</div>
                  <div class="fw-semibold"><%= report.created_by_name || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Waktu Input</div>
                  <div><%= formatDateTime(report.created_at) %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="card app-card mb-3">
            <div class="card-header fw-semibold">Informasi Utama</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-md-4">
                  <div class="text-muted small">Aktivitas</div>
                  <div><%= display(report.activity) %></div>
                </div>
                <div class="col-12 col-md-4">
                  <div class="text-muted small">Pengerjaan</div>
                  <div><%= display(report.work_type) %></div>
                </div>
                <div class="col-12 col-md-4">
                  <div class="text-muted small">S/E</div>
                  <div><%= display(report.se_status) %></div>
                </div>
                <div class="col-12">
                  <div class="text-muted small">Details</div>
                  <div class="app-modal-prewrap mt-1"><%= display(report.details) %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold">Data Order dan Pelanggan</div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">OrderID OSM</div>
                      <div><%= display(report.osm_order_id) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">STO</div>
                      <div><%= display(report.sto) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">SC</div>
                      <div><%= display(report.sc) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">OrderID / NCX-ID</div>
                      <div><%= display(report.order_ncx_id) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">NCLI</div>
                      <div><%= display(report.ncli) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">Nama Customer</div>
                      <div class="fw-semibold"><%= display(report.customer_name) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">Witel</div>
                      <div><%= display(report.witel) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">K-Kontak</div>
                      <div><%= display(report.k_kontak) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">User ID</div>
                      <div><%= display(report.user_id_text) %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold">Data Alpro dan Incident</div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">Nama Alpro Before</div>
                      <div><%= display(report.alpro_before) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">Nama Alpro</div>
                      <div><%= display(report.alpro_name) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="text-muted small">Ticket Incident</div>
                      <div><%= display(report.ticket_incident) %></div>
                    </div>
                    <div class="col-12">
                      <div class="text-muted small">Incident</div>
                      <div class="app-modal-prewrap mt-1"><%= display(report.incident) %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="card app-card">
            <div class="card-header fw-semibold">Transaksi dan Resolved</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Tipe Transaksi</div>
                  <div><%= display(report.transaction_type) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Jenis Fallout</div>
                  <div><%= display(report.fallout_type) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Ticket Resolved</div>
                  <div><%= display(report.ticket_resolved) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Ticket Resolved 2</div>
                  <div><%= display(report.ticket_resolved_2) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Updated Oleh</div>
                  <div><%= display(report.updated_by_name) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Waktu Update</div>
                  <div><%= formatDateTime(report.updated_at) %></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f017-manual-report"></script>
</body>
</html>
