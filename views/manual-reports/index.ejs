<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const selectedFilters = filters || {};
    const canCreateManualReport = currentUser && ['eksekutor', 'koordinator'].includes(currentUser.role);
  %>

  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/manual-reports' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Laporan Manual' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Laporan Manual',
            pageSubtitle: 'Catatan pekerjaan non-ticketing yang terpisah dari antrean tiket Telegram.',
            pageActions: canCreateManualReport ? `
              <a href="/manual-reports/create" class="btn btn-primary">Tambah Laporan Manual</a>
            ` : null
          }) %>

          <div class="card app-card mb-3">
            <div class="card-body">
              <form method="GET" action="/manual-reports" class="row g-2">
                <div class="col-12 col-lg-4">
                  <label class="form-label">Pencarian</label>
                  <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Cari details, order, pelanggan, incident..."
                    value="<%= selectedFilters.search || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">Dari Tanggal</label>
                  <input
                    type="date"
                    name="date_from"
                    class="form-control"
                    value="<%= selectedFilters.date_from || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">Sampai Tanggal</label>
                  <input
                    type="date"
                    name="date_to"
                    class="form-control"
                    value="<%= selectedFilters.date_to || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">STO</label>
                  <input
                    type="text"
                    name="sto"
                    class="form-control"
                    value="<%= selectedFilters.sto || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">Aktivitas</label>
                  <input
                    type="text"
                    name="activity"
                    class="form-control"
                    value="<%= selectedFilters.activity || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">Pengerjaan</label>
                  <input
                    type="text"
                    name="work_type"
                    class="form-control"
                    value="<%= selectedFilters.work_type || '' %>"
                  >
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                  <label class="form-label">S/E</label>
                  <input
                    type="text"
                    name="se_status"
                    class="form-control"
                    value="<%= selectedFilters.se_status || '' %>"
                  >
                </div>

                <div class="col-12 col-lg-4 d-flex align-items-end gap-2">
                  <button type="submit" class="btn btn-primary">Terapkan</button>
                  <a href="/manual-reports" class="btn btn-outline-secondary">Reset</a>
                </div>
              </form>
            </div>
          </div>

          <div class="card app-card">
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 64px">No</th>
                      <th>Tanggal</th>
                      <th>STO</th>
                      <th>Pelanggan</th>
                      <th>Aktivitas</th>
                      <th>Pengerjaan</th>
                      <th>S/E</th>
                      <th>Details</th>
                      <th>Dibuat Oleh</th>
                      <th class="app-table-actions">Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!manualReports || manualReports.length === 0) { %>
                      <tr>
                        <td colspan="10" class="text-center text-muted app-table-empty">Belum ada laporan manual non-ticketing.</td>
                      </tr>
                    <% } %>

                    <% (manualReports || []).forEach((report, index) => { %>
                      <tr>
                        <td class="text-muted"><%= index + 1 %></td>
                        <td><%= formatDate(report.report_date) %></td>
                        <td><%= report.sto || '-' %></td>
                        <td>
                          <div class="fw-semibold"><%= report.customer_name || '-' %></div>
                          <div class="small text-muted"><%= report.ncli || report.sc || '-' %></div>
                        </td>
                        <td><%= report.activity || '-' %></td>
                        <td><%= report.work_type || '-' %></td>
                        <td><%= report.se_status || '-' %></td>
                        <td>
                          <div class="app-truncate-lg" title="<%= report.details || '-' %>"><%= report.details || '-' %></div>
                        </td>
                        <td><%= report.created_by_name || '-' %></td>
                        <td class="app-table-actions">
                          <a href="/manual-reports/<%= report.id %>" class="btn btn-sm btn-outline-secondary">Detail</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f017-manual-report"></script>
</body>
</html>
