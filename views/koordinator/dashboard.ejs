<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/koordinator' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Koordinator' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Koordinator',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'Koordinator'}.`
          }) %>

          <!-- Tingkat 1: Ringkasan Metrik Terpadu (2 Card Berkelompok Symmetrical) -->
          <div class="row g-3 mb-3">
            <!-- Grup 1: Status Operasional Aktif -->
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between">
                  <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                    <i class="bi bi-activity text-primary"></i>
                    <span>Beban Operasional Berjalan</span>
                  </div>
                  <span class="text-muted small" style="font-size: 0.72rem;">Tiket Aktif</span>
                </div>
                <div class="card-body p-0">
                  <div class="row g-0 text-center">
                    <div class="col-6 col-sm-3 border-end border-bottom border-sm-bottom-0">
                      <a href="/reports?work_status=available" class="app-kpi-item" title="Buka antrean tiket tersedia">
                        <span class="app-kpi-label">Tersedia</span>
                        <span class="app-kpi-value text-status-available"><%= summary.total_available %></span>
                        <span class="app-kpi-subtext">Menunggu tim</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3 border-end-0 border-sm-end border-bottom border-sm-bottom-0">
                      <a href="/reports?work_status=team_in_progress" class="app-kpi-item" title="Buka tiket dikerjakan teknisi">
                        <span class="app-kpi-label">Tim Lapangan</span>
                        <span class="app-kpi-value text-status-in-progress"><%= summary.total_team_in_progress %></span>
                        <span class="app-kpi-subtext">Monitoring tim</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3 border-end">
                      <a href="/reports?work_status=my_in_progress" class="app-kpi-item" title="Buka tiket ditangani Anda">
                        <span class="app-kpi-label">Ditangani Anda</span>
                        <span class="app-kpi-value text-primary"><%= summary.total_my_in_progress %></span>
                        <span class="app-kpi-subtext">Langsung Anda</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3">
                      <a href="/reports?work_status=delegated" class="app-kpi-item" title="Buka tiket didelegasikan">
                        <span class="app-kpi-label">Delegasi</span>
                        <span class="app-kpi-value text-status-delegated"><%= summary.total_delegated %></span>
                        <span class="app-kpi-subtext">Penugasan tim</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Grup 2: Penyelesaian & Akumulasi -->
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between">
                  <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                    <i class="bi bi-check2-circle text-success"></i>
                    <span>Penyelesaian &amp; Akumulasi</span>
                  </div>
                  <span class="text-muted small" style="font-size: 0.72rem;">Akumulasi Wilayah</span>
                </div>
                <div class="card-body p-0">
                  <div class="row g-0 text-center">
                    <div class="col-6 col-sm-3 border-end border-bottom border-sm-bottom-0">
                      <a href="/reports?work_status=completed" class="app-kpi-item" title="Buka tiket selesai">
                        <span class="app-kpi-label">Selesai</span>
                        <span class="app-kpi-value text-status-completed"><%= summary.total_completed %></span>
                        <span class="app-kpi-subtext">Tuntas ditangani</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3 border-end-0 border-sm-end border-bottom border-sm-bottom-0">
                      <a href="/reports?work_status=follow_up" class="app-kpi-item" title="Buka tiket perlu tindak lanjut">
                        <span class="app-kpi-label">Tindak Lanjut</span>
                        <span class="app-kpi-value text-status-follow-up"><%= summary.total_follow_up %></span>
                        <span class="app-kpi-subtext">Perlu perbaikan</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3 border-end">
                      <a href="/reports?work_status=escalated" class="app-kpi-item" title="Buka tiket eskalasi">
                        <span class="app-kpi-label">Eskalasi</span>
                        <span class="app-kpi-value text-status-escalated"><%= summary.total_escalated %></span>
                        <span class="app-kpi-subtext">Kendala DIIT</span>
                      </a>
                    </div>

                    <div class="col-6 col-sm-3">
                      <a href="/reports?work_status=all" class="app-kpi-item" title="Buka seluruh antrean tiket">
                        <span class="app-kpi-label">Total Tiket</span>
                        <span class="app-kpi-value text-dark"><%= summary.total_reports %></span>
                        <span class="app-kpi-subtext">Seluruh status</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tingkat 2: Inti Koordinasi & Penugasan Tim (Balanced Two-Column Hub) -->
          <div class="row g-3 mb-3">
            <!-- Kolom Kiri: Beban Antrean Wilayah & Tiket Ditangani Anda -->
            <div class="col-12 col-xl-5 d-flex flex-column gap-3">
              <!-- Card: Beban Antrean Wilayah -->
              <div class="card app-card">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
                  <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt text-primary"></i>
                    <span>Beban Antrean Wilayah</span>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Filter Periode Beban Kerja">
                      <a href="/dashboard/koordinator?period=today" class="btn btn-outline-secondary <%= filters && filters.period === 'today' ? 'active fw-semibold' : '' %>">Hari Ini</a>
                      <a href="/dashboard/koordinator?period=this_week" class="btn btn-outline-secondary <%= filters && (filters.period === 'this_week' || filters.period === 'last_7_days') ? 'active fw-semibold' : '' %>">Minggu Ini</a>
                      <a href="/dashboard/koordinator?period=all" class="btn btn-outline-secondary <%= !filters || filters.period === 'all' || !filters.period ? 'active fw-semibold' : '' %>">Semua</a>
                      <button type="button" class="btn btn-outline-secondary <%= filters && filters.period === 'custom' ? 'active fw-semibold' : '' %>" data-bs-toggle="collapse" data-bs-target="#customDateFilterCollapse" aria-expanded="<%= filters && filters.period === 'custom' ? 'true' : 'false' %>">
                        Kustom
                      </button>
                    </div>
                  </div>
                </div>

                <div class="collapse <%= filters && filters.period === 'custom' ? 'show' : '' %> bg-light border-bottom px-3 py-2" id="customDateFilterCollapse">
                  <form action="/dashboard/koordinator" method="GET" class="row g-2 align-items-center">
                    <input type="hidden" name="period" value="custom">
                    <div class="col-auto">
                      <label for="startDateInput" class="col-form-label col-form-label-sm fw-medium">Mulai:</label>
                    </div>
                    <div class="col-auto">
                      <input type="date" id="startDateInput" name="startDate" class="form-control form-control-sm" value="<%= filters && filters.startDate ? filters.startDate : '' %>" required>
                    </div>
                    <div class="col-auto">
                      <label for="endDateInput" class="col-form-label col-form-label-sm fw-medium">Sampai:</label>
                    </div>
                    <div class="col-auto">
                      <input type="date" id="endDateInput" name="endDate" class="form-control form-control-sm" value="<%= filters && filters.endDate ? filters.endDate : '' %>" required>
                    </div>
                    <div class="col-auto">
                      <button type="submit" class="btn btn-sm btn-primary">Terapkan</button>
                      <a href="/dashboard/koordinator?period=all" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                  </form>
                </div>

                <div class="card-body p-3">
                  <% if (disparityAlert) { %>
                    <div class="alert alert-warning border-warning-subtle d-flex align-items-start gap-2 py-2 px-3 mb-2 rounded-2" role="alert">
                      <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-1"></i>
                      <div class="small">
                        <strong class="d-block text-warning-emphasis">Peringatan Disparitas:</strong>
                        <span class="text-dark"><%= disparityAlert.message %></span>
                      </div>
                    </div>
                  <% } %>

                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Wilayah</th>
                          <th class="text-center">Tersedia</th>
                          <th class="text-center">Dikerjakan</th>
                          <th class="text-center">Delegasi</th>
                          <th class="text-center">Selesai</th>
                          <th class="text-center">Total</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!regionSummary || regionSummary.length === 0) { %>
                          <tr>
                            <td colspan="6" class="text-center text-muted py-3">Data wilayah PDG dan BKT belum tersedia.</td>
                          </tr>
                        <% } %>

                        <% (regionSummary || []).forEach(region => { %>
                          <tr>
                            <td>
                              <div class="d-flex align-items-center gap-2">
                                <% if (region.is_overloaded) { %>
                                  <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle font-monospace fw-semibold fs-6 d-inline-flex align-items-center" title="Ketimpangan antrean tinggi terdeteksi!">
                                    <span class="pulsing-dot bg-danger me-1"></span>
                                    <%= region.region_code || '-' %>
                                  </span>
                                <% } else { %>
                                  <span class="badge text-bg-light border font-monospace fw-semibold fs-6"><%= region.region_code || '-' %></span>
                                <% } %>
                                <div>
                                  <div class="fw-semibold text-dark"><%= region.region_name || '-' %></div>
                                  <% if (region.is_overloaded) { %>
                                    <span class="badge text-bg-danger small fw-normal" style="font-size: 0.65rem;">Antrean Tinggi</span>
                                  <% } %>
                                </div>
                              </div>
                            </td>
                            <td class="text-center">
                              <a href="/reports?region=<%= region.region_code %>&work_status=available" class="text-decoration-none text-status-available fw-bold" title="Lihat tiket tersedia <%= region.region_code %>">
                                <%= region.total_available %>
                              </a>
                            </td>
                            <td class="text-center">
                              <a href="/reports?region=<%= region.region_code %>&work_status=team_in_progress" class="text-decoration-none text-status-in-progress fw-semibold" title="Monitoring Tim <%= region.region_code %>">
                                <%= region.total_team_in_progress %>
                              </a>
                              <% if (region.total_my_in_progress > 0) { %>
                                <div class="small text-primary" style="font-size: 0.7rem;">(+<%= region.total_my_in_progress %> Anda)</div>
                              <% } %>
                            </td>
                            <td class="text-center">
                              <a href="/reports?region=<%= region.region_code %>&work_status=delegated" class="text-decoration-none text-status-delegated fw-semibold">
                                <%= region.total_delegated %>
                              </a>
                            </td>
                            <td class="text-center">
                              <a href="/reports?region=<%= region.region_code %>&work_status=completed" class="text-decoration-none text-status-completed fw-semibold">
                                <%= region.total_completed %>
                              </a>
                            </td>
                            <td class="text-center">
                              <a href="/reports?region=<%= region.region_code %>&work_status=all" class="text-decoration-none text-dark fw-bold">
                                <%= region.total_reports %>
                              </a>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- Card: Tiket Aktif Sedang Ditangani Anda / Status Mandiri -->
              <% if (myActiveReports && myActiveReports.length > 0) { %>
                <div class="card app-card">
                  <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between">
                    <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                      <i class="bi bi-person-workspace text-primary"></i>
                      <span>Tiket Ditangani Anda</span>
                      <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;"><%= myActiveReports.length %> Tiket</span>
                    </div>
                    <a href="/reports?work_status=my_in_progress" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;">Antrean Saya</a>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                      <table class="table table-hover align-middle mb-0">
                        <thead>
                          <tr>
                            <th>Tiket</th>
                            <th>Ringkasan &amp; Status</th>
                            <th class="text-center">Wilayah</th>
                            <th class="text-end pe-3">Aksi</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% myActiveReports.forEach(report => { %>
                            <tr>
                              <td>
                                <div class="fw-semibold font-monospace small"><%= report.ticket_id %></div>
                                <% if (report.order_id) { %>
                                  <div class="text-muted" style="font-size: 0.7rem;"><%= report.order_id %></div>
                                <% } %>
                              </td>
                              <td>
                                <div class="text-truncate small fw-medium" style="max-width: 170px;" title="<%= report.summary || '-' %>"><%= report.summary || '-' %></div>
                                <div class="mt-1">
                                  <%- include('../partials/status-badge', { type: 'ticket', value: report.status_internal }) %>
                                  <% if (report.is_resubmitted) { %>
                                    <span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle d-block mt-1" style="font-size: 0.7rem;" title="Laporan telah diperbaiki dan dikirim ulang oleh pelapor"><i class="bi bi-arrow-repeat me-1"></i>Resubmit</span>
                                  <% } %>
                                </div>
                              </td>
                              <td class="text-center">
                                <span class="badge text-bg-light border font-monospace"><%= report.region_code || '-' %></span>
                              </td>
                              <td class="text-end pe-3">
                                <a href="/reports/<%= report.ticket_id %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;" data-report-detail-url="/reports/<%= report.ticket_id %>/detail-json">Proses</a>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <div class="card app-card">
                  <div class="card-body py-3 px-3 d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-person-check text-muted fs-4"></i>
                      <div>
                        <div class="fw-semibold text-dark small">Tugas Mandiri Koordinator</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Tidak ada tiket aktif langsung. Fokus pada pemantauan dan delegasi tim.</div>
                      </div>
                    </div>
                    <a href="/reports?work_status=available" class="btn btn-sm btn-outline-secondary text-nowrap" style="font-size: 0.75rem;">Buka Antrean</a>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Kolom Kanan: Rincian Beban Kerja Eksekutor & Rekomendasi Delegasi -->
            <div class="col-12 col-xl-7">
              <div class="card app-card h-100 d-flex flex-column">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
                  <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                    <i class="bi bi-people text-primary"></i>
                    <span>Beban Kerja Eksekutor</span>
                  </div>
                  <div class="btn-group btn-group-sm" role="group" id="eksekutorRegionFilter">
                    <button type="button" class="btn btn-outline-secondary active" data-eksekutor-filter="all">Semua Eksekutor</button>
                    <button type="button" class="btn btn-outline-secondary" data-eksekutor-filter="PDG">Padang (PDG)</button>
                    <button type="button" class="btn btn-outline-secondary" data-eksekutor-filter="BKT">Bukittinggi (BKT)</button>
                  </div>
                </div>

                <div class="card-body p-0 flex-grow-1">
                  <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="eksekutorWorkloadTable">
                      <thead class="sticky-top bg-light">
                        <tr>
                          <th>Eksekutor</th>
                          <th>Wilayah</th>
                          <th class="text-center">Beban Aktif</th>
                          <th class="text-center">Selesai</th>
                          <th class="text-center">Kategori</th>
                          <th class="text-center">Rekomendasi Delegasi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!eksekutorWorkload || eksekutorWorkload.length === 0) { %>
                          <tr>
                            <td colspan="6" class="text-center text-muted py-4">Belum ada data teknisi eksekutor aktif.</td>
                          </tr>
                        <% } %>
                        <% (eksekutorWorkload || []).forEach(tek => { %>
                          <tr data-region="<%= tek.region_code %>">
                            <td>
                              <div class="fw-semibold text-dark"><%= tek.full_name %></div>
                              <div class="text-muted small font-monospace">@<%= tek.username %></div>
                            </td>
                            <td>
                              <span class="badge text-bg-light border font-monospace"><%= tek.region_code %></span>
                            </td>
                            <td class="text-center">
                              <span class="fw-bold fs-6 <%= tek.active_tickets > 2 ? 'text-danger' : (tek.active_tickets === 0 ? 'text-success' : 'text-dark') %>">
                                <%= tek.active_tickets %>
                              </span>
                            </td>
                            <td class="text-center fw-medium text-success"><%= tek.period_completed %></td>
                            <td class="text-center">
                              <span class="badge <%= tek.load_badge.badgeClass %>">
                                <%= tek.load_badge.label %>
                              </span>
                            </td>
                            <td class="text-center">
                              <% if (tek.load_badge.canDelegate) { %>
                                <span class="badge text-bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                  <i class="bi bi-check-circle-fill" style="font-size: 0.75rem;"></i> <%= tek.load_badge.recommendation %>
                                </span>
                              <% } else if (tek.active_tickets >= 4) { %>
                                <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                                  <i class="bi bi-exclamation-triangle-fill" style="font-size: 0.75rem;"></i> <%= tek.load_badge.recommendation %>
                                </span>
                              <% } else { %>
                                <span class="badge text-bg-light border text-muted">
                                  <%= tek.load_badge.recommendation %>
                                </span>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tingkat 3: Log Aktivitas Ticketing Terbaru (Full Width Linear Stream) -->
          <div class="card app-card mb-3">
            <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between">
              <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-secondary"></i>
                <span>Aktivitas Ticketing Terbaru</span>
              </div>
              <span class="badge text-bg-light border text-secondary" style="font-size: 0.7rem;">Terkini</span>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                  <thead class="sticky-top bg-light">
                    <tr>
                      <th class="app-col-time ps-3">Waktu</th>
                      <th>Pelaku</th>
                      <th>Tiket</th>
                      <th>Wilayah</th>
                      <th>Keterangan</th>
                      <th class="text-end pe-3">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!latestActivities || latestActivities.length === 0) { %>
                      <tr>
                        <td colspan="6" class="text-center text-muted py-4">Belum ada aktivitas ticketing yang tercatat.</td>
                      </tr>
                    <% } %>

                    <% (latestActivities || []).forEach(activity => { %>
                      <tr>
                        <td class="ps-3"><span class="text-muted small"><%= formatDateTime(activity.created_at) %></span></td>
                        <td><span class="fw-medium text-dark small"><%= activity.actor_name || 'Sistem' %></span></td>
                        <td>
                          <a href="/reports/<%= activity.ticket_id %>" class="fw-semibold font-monospace text-decoration-none small">
                            <%= activity.ticket_id || '-' %>
                          </a>
                          <% if (activity.order_id) { %>
                            <div class="text-muted" style="font-size: 0.7rem;">Order: <%= activity.order_id %></div>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge text-bg-light border font-monospace"><%= activity.region_code || '-' %></span>
                        </td>
                        <td>
                          <div class="small text-dark text-break" style="max-width: 500px;"><%= activity.description || '-' %></div>
                        </td>
                        <td class="text-end pe-3">
                          <%- include('../partials/status-badge', { type: 'ticket', value: activity.status_internal }) %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/report-detail-modal') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const filterButtons = document.querySelectorAll('[data-eksekutor-filter]');
      const rows = document.querySelectorAll('#eksekutorWorkloadTable tbody tr[data-region]');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', function () {
          filterButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          const targetRegion = this.getAttribute('data-eksekutor-filter');
          rows.forEach(row => {
            if (targetRegion === 'all' || row.getAttribute('data-region') === targetRegion) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</body>
</html>
