<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { activePath: '/dashboard/koordinator' }) %>

    <div class="app-main">
      <%- include('../partials/topbar', { pageTitle: 'Dashboard Koordinator' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../partials/flash') %>

          <%- include('../partials/page-header', {
            pageTitle: 'Dashboard Koordinator',
            pageSubtitle: `Selamat datang, ${currentUser && currentUser.full_name ? currentUser.full_name : 'Koordinator'}. Monitoring terpadu dan koordinasi operasional tiket wilayah PDG dan BKT.`,
            pageActions: `
              <div class="d-flex gap-2 flex-wrap">
                <a href="/reports" class="btn btn-primary fw-semibold px-3">Daftar Antrean Kerja</a>
                <a href="/manual-reports" class="btn btn-outline-primary fw-medium">Laporan Manual</a>
              </div>
            `
          }) %>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Total Tiket (PDG & BKT)</div>
                  <h3 class="mb-1 fw-bold text-dark"><%= summary.total_reports %></h3>
                  <div class="small text-muted">Seluruh status laporan</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Tiket Tersedia</div>
                  <h3 class="mb-1 fw-bold text-status-available"><%= summary.total_available %></h3>
                  <div class="small text-muted">Menunggu penanganan</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Sedang Dikerjakan</div>
                  <h3 class="mb-1 fw-bold text-status-in-progress"><%= summary.total_in_progress %></h3>
                  <div class="small text-muted">Status diambil</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Didelegasikan</div>
                  <h3 class="mb-1 fw-bold text-status-delegated"><%= summary.total_delegated %></h3>
                  <div class="small text-muted">Penugasan lintas wilayah</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Tiket Selesai</div>
                  <h3 class="mb-1 fw-bold text-status-completed"><%= summary.total_completed %></h3>
                  <div class="small text-muted">Tuntas ditangani</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Perlu Tindak Lanjut</div>
                  <h3 class="mb-1 fw-bold text-status-follow-up"><%= summary.total_follow_up %></h3>
                  <div class="small text-muted">Butuh penanganan ulang</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Eskalasi</div>
                  <h3 class="mb-1 fw-bold text-status-escalated"><%= summary.total_escalated %></h3>
                  <div class="small text-muted">Kendala eksternal / DIIT</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card app-card h-100">
                <div class="card-body">
                  <div class="text-muted small fw-medium">Cakupan Monitoring</div>
                  <h4 class="mb-1 fw-bold text-dark">PDG & BKT</h4>
                  <div class="small text-muted">Padang & Bukittinggi</div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-xl-8">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div>
                    <div>Ringkasan Beban Kerja per Wilayah</div>
                    <div class="text-muted small fw-normal">Perbandingan distribusi status tiket antara wilayah Padang (PDG) dan Bukittinggi (BKT).</div>
                  </div>
                  <span class="badge text-bg-light border text-muted">2 Wilayah Kerja</span>
                </div>
                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Wilayah</th>
                          <th class="text-center">Total</th>
                          <th class="text-center">Tersedia</th>
                          <th class="text-center">Dikerjakan</th>
                          <th class="text-center">Delegasi</th>
                          <th class="text-center">Selesai</th>
                          <th class="text-center">Tindak Lanjut</th>
                          <th class="text-center">Eskalasi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!regionSummary || regionSummary.length === 0) { %>
                          <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                              Data wilayah PDG dan BKT belum tersedia.
                            </td>
                          </tr>
                        <% } %>

                        <% (regionSummary || []).forEach(region => { %>
                          <tr>
                            <td>
                              <div class="d-flex align-items-center gap-2">
                                <span class="badge text-bg-light border font-monospace fw-semibold fs-6"><%= region.region_code || '-' %></span>
                                <div class="fw-semibold text-dark"><%= region.region_name || '-' %></div>
                              </div>
                            </td>
                            <td class="text-center"><strong class="text-dark"><%= region.total_reports %></strong></td>
                            <td class="text-center"><span class="text-status-available fw-semibold"><%= region.total_available %></span></td>
                            <td class="text-center"><span class="text-status-in-progress fw-semibold"><%= region.total_in_progress %></span></td>
                            <td class="text-center"><span class="text-status-delegated fw-semibold"><%= region.total_delegated %></span></td>
                            <td class="text-center"><span class="text-status-completed fw-semibold"><%= region.total_completed %></span></td>
                            <td class="text-center"><span class="text-status-follow-up fw-semibold"><%= region.total_follow_up %></span></td>
                            <td class="text-center"><span class="text-status-escalated fw-semibold"><%= region.total_escalated %></span></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-4">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold">
                  <div>Aksi Cepat Koordinasi</div>
                  <div class="text-muted small fw-normal">Akses langsung ke alur kerja operasional utama.</div>
                </div>
                <div class="card-body">
                  <div class="d-grid gap-2">
                    <a href="/reports" class="btn btn-primary fw-semibold text-start p-3 d-flex justify-content-between align-items-center">
                      <div>
                        <div class="fw-bold">Daftar Antrean Kerja</div>
                        <div class="small text-white-50">Monitoring dan pengelolaan tiket</div>
                      </div>
                      <span>&rarr;</span>
                    </a>
                    <a href="/manual-reports" class="btn btn-outline-primary text-start p-3 d-flex justify-content-between align-items-center">
                      <div>
                        <div class="fw-semibold text-dark">Laporan Manual</div>
                        <div class="small text-muted">Input laporan di luar bot Telegram</div>
                      </div>
                      <span>&rarr;</span>
                    </a>
                    <a href="/region-switch/pending" class="btn btn-outline-secondary text-start p-3 d-flex justify-content-between align-items-center">
                      <div>
                        <div class="fw-semibold text-dark">Approval Switch Region</div>
                        <div class="small text-muted">Persetujuan alih wilayah teknisi</div>
                      </div>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="card app-card">
            <div class="card-header fw-semibold">
              <div>Aktivitas Ticketing Terbaru</div>
              <div class="text-muted small fw-normal">Riwayat 8 catatan aktivitas terkini pada wilayah kerja PDG dan BKT.</div>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th class="app-col-time">Waktu</th>
                      <th>Pelaku</th>
                      <th>Tiket</th>
                      <th>Wilayah</th>
                      <th>Keterangan & Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!latestActivities || latestActivities.length === 0) { %>
                      <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                          Belum ada aktivitas ticketing yang tercatat.
                        </td>
                      </tr>
                    <% } %>

                    <% (latestActivities || []).forEach(activity => { %>
                      <tr>
                        <td><span class="text-muted small"><%= formatDateTime(activity.created_at) %></span></td>
                        <td><span class="fw-medium text-dark"><%= activity.actor_name || 'Sistem' %></span></td>
                        <td>
                          <a href="/reports/<%= activity.ticket_id %>" class="fw-semibold font-monospace text-decoration-none">
                            <%= activity.ticket_id || '-' %>
                          </a>
                          <% if (activity.order_id) { %>
                            <div class="text-muted small">Order: <%= activity.order_id %></div>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge text-bg-light border font-monospace"><%= activity.region_code || '-' %></span>
                        </td>
                        <td>
                          <div class="text-break"><%= activity.description || '-' %></div>
                          <div class="mt-1">
                            <%- include('../partials/status-badge', { type: 'ticket', value: activity.status_internal }) %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
