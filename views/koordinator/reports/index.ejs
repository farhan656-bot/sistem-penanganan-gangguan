<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%
    const selectedFilters = filters || {};
  %>

  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/reports' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Daftar Antrean Kerja' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Daftar Antrean Kerja',
            pageSubtitle: 'Pantau status tiket dan penanggung jawab aktif. Pembagian region digunakan untuk membantu manajemen pelaporan dan monitoring wilayah.'
          }) %>

          <div
            data-report-queue-auto-refresh
            data-check-url="/reports/check-new"
            data-fragment-url="/reports/queue-fragment"
            data-latest-report-id="<%= Number(latestReportId) || 0 %>"
            data-received-at="<%= (reports && reports.length > 0 && reports[0].received_at) ? new Date(reports[0].received_at).toISOString() : '' %>"
            data-ticket-id="<%= (reports && reports.length > 0 && reports[0].ticket_id) ? reports[0].ticket_id : '' %>"
            data-active-poll-interval="10000"
            data-inactive-poll-interval="60000"
          >
            <div data-report-tabs-target>
              <%- include('../../partials/report-work-status-tabs', { workStatusTabs }) %>
            </div>

            <div class="card app-card mb-3">
              <div class="card-body">
                <form method="GET" action="/reports" class="row g-3">
                  <input type="hidden" name="work_status" value="<%= selectedFilters.workStatus %>">
                  <input type="hidden" name="page" value="1">
                  <input type="hidden" name="per_page" value="<%= pagination.perPage %>">

                  <div class="col-12 col-lg-6">
                    <label for="reportSearchInput" class="form-label small fw-semibold text-secondary">Pencarian</label>
                    <input
                      type="text"
                      id="reportSearchInput"
                      name="search"
                      class="form-control"
                      placeholder="Cari ticket ID, order ID, STO, branch, summary..."
                      value="<%= selectedFilters.search || '' %>"
                    >
                  </div>

                  <div class="col-12 col-lg-3">
                    <label for="reportRegionSelect" class="form-label small fw-semibold text-secondary">Wilayah</label>
                    <select id="reportRegionSelect" name="region" class="form-select">
                      <option value="" <%= !selectedFilters.region ? 'selected' : '' %>>Semua Wilayah</option>
                      <option value="PDG" <%= selectedFilters.region === 'PDG' ? 'selected' : '' %>>Padang (PDG)</option>
                      <option value="BKT" <%= selectedFilters.region === 'BKT' ? 'selected' : '' %>>Bukittinggi (BKT)</option>
                    </select>
                  </div>

                  <div class="col-12 col-lg-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold">Terapkan</button>
                    <% if (selectedFilters.search || selectedFilters.region) { %>
                      <a href="/reports?work_status=<%= selectedFilters.workStatus || '' %>" class="btn btn-outline-secondary" title="Reset filter">Reset</a>
                    <% } %>
                  </div>
                </form>
              </div>
            </div>

            <div data-report-list-target>
              <%- include('../../partials/report-queue-table', {
                reports,
                filters: selectedFilters,
                pagination,
                activeWorkStatusTab
              }) %>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <%- include('../../partials/report-detail-modal') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f031-adaptive-polling-10s"></script>
</body>
</html>
