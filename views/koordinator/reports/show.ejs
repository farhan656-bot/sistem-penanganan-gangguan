<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=f016-evidence-paste">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/reports' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Detail Laporan' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Detail Laporan',
            pageSubtitle: `Ticket ID: ${report && report.ticket_id ? report.ticket_id : '-'}` ,
            pageActions: `
              <a href="/reports" class="btn btn-outline-secondary">Kembali</a>
            `
          }) %>

          <div class="card app-card mb-3">
            <div class="card-body">
              <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                <div>
                  <div class="text-muted small">Status Internal</div>
                  <div class="mt-1">
                    <%- include('../../partials/status-badge', { type: 'ticket', value: report.status_internal }) %>
                    <% if (report.status_internal === 'didelegasikan') { %>
                      <span class="badge text-bg-info ms-1">Delegasi Aktif</span>
                    <% } %>
                  </div>
                </div>

                <div class="text-end">
                  <div class="text-muted small">Wilayah Laporan</div>
                  <div class="fw-semibold"><%= report.current_region_code || '-' %></div>
                </div>
              </div>

              <hr class="my-3">

              <div class="row g-3">
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Ticket ID</div>
                  <div class="fw-semibold"><%= report.ticket_id %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Order ID</div>
                  <div><%= report.order_id || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Jenis Layanan</div>
                  <div><%= report.service_type || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Provider</div>
                  <div><%= report.provider || '-' %></div>
                </div>

                <div class="col-12 col-md-3">
                  <div class="text-muted small">Branch</div>
                  <div><%= report.branch_name || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Cluster</div>
                  <div><%= report.cluster_name || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">STO</div>
                  <div><%= report.sto || '-' %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Assigned To</div>
                  <div class="fw-semibold"><%= report.assigned_user_name || '-' %></div>
                </div>

                <div class="col-12">
                  <div class="text-muted small">Ringkasan</div>
                  <div class="mt-1"><%= report.summary || '-' %></div>
                </div>

                <div class="col-12 col-md-3">
                  <div class="text-muted small">Waktu Ambil</div>
                  <div><%= formatDateTime(report.taken_at) %></div>
                </div>
                <div class="col-12 col-md-3">
                  <div class="text-muted small">Waktu Selesai</div>
                  <div><%= formatDateTime(report.resolved_at) %></div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="text-muted small">Status Akhir</div>
                  <div><%= report.completion_status || '-' %></div>
                </div>

                <% if (report.diit_code) { %>
                  <div class="col-12 col-md-6">
                    <div class="text-muted small">Kode DIIT</div>
                    <div class="fw-semibold"><%= report.diit_code %></div>
                  </div>
                <% } %>

                <div class="col-12">
                  <div class="text-muted small">Catatan Penyelesaian</div>
                  <div class="mt-1"><%= report.completion_notes || '-' %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold">Bukti Penyelesaian</div>
                <div class="card-body">
                  <% const completionOnly = typeof completionAttachments !== 'undefined' ? completionAttachments : (attachments || []); %>

                  <% if (completionOnly.length === 0) { %>
                    <div class="text-muted">Belum ada bukti penyelesaian yang diunggah.</div>
                  <% } else { %>
                    <div class="list-group list-group-flush">
                      <% completionOnly.forEach(file => { %>
                        <% const completionFileName = file.file_name || file.original_name || file.stored_name || 'Bukti Penyelesaian'; %>
                        <div class="list-group-item px-0">
                          <div class="d-flex align-items-start justify-content-between gap-3">
                            <div class="min-w-0">
                              <div class="fw-semibold">
                                <a href="<%= file.file_path %>" target="_blank" class="text-decoration-none"><%= completionFileName %></a>
                              </div>
                              <div class="small text-muted">Diunggah oleh <%= file.uploaded_by_name || '-' %></div>
                            </div>
                            <a href="<%= file.file_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">Buka</a>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-6">
              <div class="card app-card h-100">
                <div class="card-header fw-semibold">Media Tambahan Telegram</div>
                <div class="card-body">
                  <% const telegramOnly = typeof telegramAttachments !== 'undefined' ? telegramAttachments : []; %>

                  <% if (telegramOnly.length === 0) { %>
                    <div class="text-muted">Belum ada media tambahan Telegram untuk tiket ini.</div>
                  <% } else { %>
                    <div class="row g-3">
                      <% telegramOnly.forEach(item => { %>
                        <% const isImage = item.mime_type && item.mime_type.startsWith('image/'); %>
                        <div class="col-12">
                          <div class="border rounded p-3 bg-white">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                              <div class="min-w-0">
                                <div class="fw-semibold"><%= item.original_name || item.stored_name || 'Media Telegram' %></div>
                                <div class="small text-muted">Waktu: <%= formatDateTime(item.created_at) %></div>
                              </div>
                              <a href="<%= item.file_path %>" target="_blank" class="btn btn-sm btn-outline-primary">Buka</a>
                            </div>

                            <% if (isImage) { %>
                              <a href="<%= item.file_path %>" target="_blank" class="text-decoration-none">
                                <img
                                  src="<%= item.file_path %>"
                                  alt="Telegram media <%= item.id %>"
                                  class="img-fluid rounded border mt-2"
                                  style="max-height: 280px; object-fit: cover; width: 100%;"
                                >
                              </a>
                            <% } %>

                            <div class="row g-2 mt-2 small text-muted">
                              <div class="col-12 col-md-6">Tipe: <%= item.file_type || '-' %></div>
                              <div class="col-12 col-md-6">MIME: <%= item.mime_type || '-' %></div>
                            </div>

                            <% if (item.caption) { %>
                              <div class="small mt-2"><strong>Caption:</strong> <%= item.caption %></div>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <% if (
            currentUser.role === 'koordinator' &&
            report.status_internal === 'tersedia'
          ) { %>
            <div class="card app-card mt-3">
              <div class="card-header fw-semibold">Ambil Tugas</div>
              <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                <p class="mb-0 text-muted">Ambil tiket ini agar Koordinator menjadi penanggung jawab aktif dan dapat membantu proses pengerjaan.</p>
                <form action="/reports/<%= report.id %>/take" method="POST" class="m-0">
                  <button type="submit" class="btn btn-primary" onclick="return confirm('Ambil tugas ini?');">
                    Ambil Tugas
                  </button>
                </form>
              </div>
            </div>
          <% } %>

          <% if (
            currentUser.role === 'koordinator' &&
            ['diambil', 'didelegasikan'].includes(report.status_internal)
          ) { %>
            <div class="card app-card mt-3">
              <div class="card-header fw-semibold">Update Pengerjaan</div>
              <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                <p class="mb-0 text-muted">Gunakan tombol ini saat tiket sudah mulai dikerjakan agar pelapor menerima update status.</p>
                <form action="/reports/<%= report.id %>/in-progress" method="POST" class="m-0">
                  <button type="submit" class="btn btn-warning" onclick="return confirm('Tandai tiket sedang dikerjakan?');">
                    Tandai In Progress
                  </button>
                </form>
              </div>
            </div>

            <div class="card app-card mt-3">
              <div class="card-header fw-semibold">Konfirmasi Penyelesaian</div>
              <div class="card-body">
                <form action="/reports/<%= report.id %>/complete" method="POST" enctype="multipart/form-data" data-completion-form>
                  <div class="mb-3">
                    <label class="form-label" for="completion_notes">
                      Catatan
                      <span class="app-required d-none" data-completion-notes-required>*</span>
                    </label>
                    <textarea id="completion_notes" name="completion_notes" class="form-control" rows="4" data-completion-notes></textarea>
                    <div class="form-text">Opsional untuk selesai dan eskalasi. Wajib untuk return/perlu tindak lanjut agar feedback Telegram jelas.</div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label" for="completion_status">Status Akhir <span class="app-required">*</span></label>
                    <select id="completion_status" name="completion_status" class="form-select" required data-completion-status>
                      <option value="">Pilih status akhir</option>
                      <option value="selesai">Selesai</option>
                      <option value="perlu_tindak_lanjut">Perlu Tindak Lanjut</option>
                      <option value="eskalasi">Eskalasi</option>
                    </select>
                  </div>

                  <div class="mb-3 d-none" data-diit-code-group>
                    <label class="form-label" for="diit_code">Kode DIIT <span class="app-required">*</span></label>
                    <input
                      type="text"
                      id="diit_code"
                      name="diit_code"
                      class="form-control"
                      maxlength="100"
                      autocomplete="off"
                      data-diit-code
                    >
                    <div class="form-text">Masukkan kode rujukan DIIT dari proses eksternal.</div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Upload Bukti (Opsional)</label>
                    <input
                      type="file"
                      name="proof_file"
                      class="form-control"
                      accept=".jpg,.jpeg,.png,.webp,.pdf"
                      data-proof-file-input
                    >
                    <div class="form-text">
                      Unggah file bukti atau klik area ini lalu tekan Ctrl + V untuk menempel screenshot.
                      Format: JPG, PNG, WEBP, atau PDF. Maksimal 5 MB.
                    </div>

                    <div
                      class="completion-evidence-paste mt-3"
                      tabindex="0"
                      role="button"
                      aria-label="Area paste screenshot bukti penyelesaian"
                      data-evidence-paste-area
                    >
                      <div class="fw-semibold">Paste Screenshot</div>
                      <div class="small text-muted">
                        Klik area ini lalu tekan Ctrl + V. Screenshot akan masuk ke upload bukti penyelesaian.
                      </div>
                      <div class="small mt-2 text-muted" aria-live="polite" data-evidence-paste-status>
                        Belum ada screenshot yang ditempel.
                      </div>

                      <div class="completion-evidence-preview d-none mt-3" data-evidence-preview>
                        <div class="d-flex align-items-start gap-3">
                          <img
                            src=""
                            alt="Preview bukti penyelesaian"
                            class="completion-evidence-preview-image d-none"
                            data-evidence-preview-image
                          >
                          <div class="min-w-0 flex-grow-1">
                            <div class="fw-semibold text-truncate" data-evidence-file-name></div>
                            <div class="small text-muted" data-evidence-file-size></div>
                            <div class="small text-muted" data-evidence-file-note></div>
                          </div>
                          <button type="button" class="btn btn-sm btn-outline-secondary" data-evidence-clear>
                            Hapus
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <button type="submit" class="btn btn-success" onclick="return confirm('Yakin ingin memproses status akhir laporan ini?');">
                    Proses Status Akhir
                  </button>
                </form>
              </div>
            </div>
          <% } %>

          <% if (
            currentUser.role === 'koordinator' &&
            ['tersedia', 'diambil', 'didelegasikan'].includes(report.status_internal)
          ) { %>
            <div class="card app-card mt-3">
              <div class="card-header fw-semibold d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span>Delegasi Penanggung Jawab (Opsional)</span>
                <span class="badge text-bg-secondary">Non-dominan</span>
              </div>
              <div class="card-body">
                <div class="text-muted mb-3">
                  Gunakan delegasi hanya jika memang dibutuhkan untuk penanganan lintas wilayah. Akses region sementara digunakan untuk mendukung kebutuhan operasional lintas region berdasarkan persetujuan Koordinator.
                </div>

                <form action="/reports/<%= report.id %>/delegate" method="POST">
                  <div class="row g-3">
                    <div class="col-12 col-lg-6">
                      <label class="form-label">Pilih Pegawai Tujuan</label>
                      <select name="target_user_id" class="form-select" required>
                        <option value="">Pilih pegawai eksekutor</option>
                        <% (eksekutorUsers || []).forEach(user => { %>
                          <% if (Number(user.id) !== Number(report.current_assigned_user_id)) { %>
                            <option value="<%= user.id %>">
                              <%= user.full_name %> - <%= user.region_code || '-' %>
                            </option>
                          <% } %>
                        <% }) %>
                      </select>
                      <div class="form-text">Aturan delegasi: tiket PDG hanya ke eksekutor BKT, tiket BKT hanya ke eksekutor PDG.</div>

                      <% if ((eksekutorUsers || []).length === 0) { %>
                        <div class="text-danger small mt-2">Tidak ada eksekutor aktif pada wilayah lawan untuk tiket ini.</div>
                      <% } %>
                    </div>

                    <div class="col-12 col-lg-6">
                      <label class="form-label">Alasan Delegasi</label>
                      <textarea name="delegation_notes" class="form-control" rows="3" required></textarea>
                    </div>
                  </div>

                  <div class="mt-3">
                    <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Yakin ingin mendelegasikan laporan ini?');">Delegasikan</button>
                  </div>
                </form>
              </div>
            </div>
          <% } %>

          <% if (
            currentUser.role === 'koordinator' &&
            ['diambil', 'didelegasikan'].includes(report.status_internal) &&
            report.current_assigned_user_id
          ) { %>
            <div class="card app-card mt-3">
              <div class="card-header fw-semibold">Batalkan Penugasan</div>
              <div class="card-body">
                <div class="text-muted mb-3">Gunakan pembatalan penugasan bila penanggung jawab aktif perlu diganti dan tiket harus kembali tersedia sesuai rule yang ada.</div>

                <form action="/reports/<%= report.id %>/cancel-assignment" method="POST">
                  <div class="mb-3">
                    <label class="form-label">Alasan Pembatalan</label>
                    <textarea name="cancel_notes" class="form-control" rows="3" required></textarea>
                  </div>

                  <button type="submit" class="btn btn-danger" onclick="return confirm('Yakin ingin membatalkan penugasan ini?');">Batalkan Tugas</button>
                </form>
              </div>
            </div>
          <% } %>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=f016-evidence-paste"></script>
  <script>
    (function () {
      var form = document.querySelector('[data-completion-form]');
      if (!form) return;

      var statusField = form.querySelector('[data-completion-status]');
      var notesField = form.querySelector('[data-completion-notes]');
      var notesRequiredIndicator = form.querySelector('[data-completion-notes-required]');
      var diitCodeGroup = form.querySelector('[data-diit-code-group]');
      var diitCodeField = form.querySelector('[data-diit-code]');
      if (!statusField || !notesField) return;

      function syncCompletionRequirements() {
        var requiresNotes = statusField.value === 'perlu_tindak_lanjut';
        var requiresDiitCode = statusField.value === 'eskalasi';

        notesField.required = Boolean(requiresNotes);
        if (notesRequiredIndicator) {
          notesRequiredIndicator.classList.toggle('d-none', !requiresNotes);
        }

        if (diitCodeGroup && diitCodeField) {
          diitCodeGroup.classList.toggle('d-none', !requiresDiitCode);
          diitCodeField.required = requiresDiitCode;
          diitCodeField.disabled = !requiresDiitCode;

          if (!requiresDiitCode) {
            diitCodeField.value = '';
          }
        }
      }

      statusField.addEventListener('change', syncCompletionRequirements);
      syncCompletionRequirements();
    })();
  </script>
</body>
</html>
