<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/reports/create' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Tambah Laporan Manual' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Tambah Laporan Manual',
            pageSubtitle: 'Input fallback operasional sebelum integrasi bot aktif penuh. Pastikan Ticket ID, Ringkasan, dan Wilayah awal diisi.',
            pageActions: `
              <a href="/reports" class="btn btn-outline-secondary">Kembali ke Antrean</a>
            `
          }) %>

          <form action="/reports" method="POST">
            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Informasi Tiket</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Ticket ID <span class="text-danger">*</span></label>
                    <input
                      type="text"
                      name="ticket_id"
                      class="form-control"
                      value="<%= formData.ticket_id %>"
                      required
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Order ID</label>
                    <input
                      type="text"
                      name="order_id"
                      class="form-control"
                      value="<%= formData.order_id %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">WO Number</label>
                    <input
                      type="text"
                      name="wo_number"
                      class="form-control"
                      value="<%= formData.wo_number %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Fallout Type</label>
                    <input
                      type="text"
                      name="fallout_type"
                      class="form-control"
                      value="<%= formData.fallout_type %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Service ID</label>
                    <input
                      type="text"
                      name="service_id"
                      class="form-control"
                      value="<%= formData.service_id %>"
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Informasi Layanan</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Service Type</label>
                    <input
                      type="text"
                      name="service_type"
                      class="form-control"
                      value="<%= formData.service_type %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Segment</label>
                    <input
                      type="text"
                      name="segment"
                      class="form-control"
                      value="<%= formData.segment %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Provider</label>
                    <input
                      type="text"
                      name="provider"
                      class="form-control"
                      value="<%= formData.provider %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Status WFM</label>
                    <input
                      type="text"
                      name="status_wfm"
                      class="form-control"
                      value="<%= formData.status_wfm %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Status Andalas</label>
                    <input
                      type="text"
                      name="status_andalas"
                      class="form-control"
                      value="<%= formData.status_andalas %>"
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Informasi Lokasi</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label class="form-label">Telkom Area</label>
                    <input
                      type="text"
                      name="telkom_area"
                      class="form-control"
                      value="<%= formData.telkom_area %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Branch Name</label>
                    <input
                      type="text"
                      name="branch_name"
                      class="form-control"
                      value="<%= formData.branch_name %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">Cluster Name</label>
                    <input
                      type="text"
                      name="cluster_name"
                      class="form-control"
                      value="<%= formData.cluster_name %>"
                    >
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label">STO</label>
                    <input
                      type="text"
                      name="sto"
                      class="form-control"
                      value="<%= formData.sto %>"
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Detail Gangguan</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label">Ringkasan Gangguan <span class="text-danger">*</span></label>
                    <textarea
                      name="summary"
                      class="form-control"
                      rows="4"
                      required
                    ><%= formData.summary %></textarea>
                    <div class="form-text">Isi ringkasan sejelas mungkin (contoh: indikasi, lokasi, gejala, dan info relevan lainnya).</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="card app-card mb-3">
              <div class="card-header fw-semibold">Wilayah Penanganan</div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <label class="form-label">Wilayah Awal <span class="text-danger">*</span></label>
                    <select name="reported_region_id" class="form-select" required>
                      <option value="">Pilih wilayah</option>
                      <% regions.forEach(region => { %>
                        <option
                          value="<%= region.id %>"
                          <%= String(formData.reported_region_id) === String(region.id) ? 'selected' : '' %>
                        >
                          <%= region.code %> - <%= region.name %>
                        </option>
                      <% }) %>
                    </select>
                    <div class="form-text">Wilayah awal tidak berubah saat terjadi delegasi (hanya penanggung jawab aktif yang berubah).</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button type="submit" class="btn btn-primary">Simpan Laporan Manual</button>
              <a href="/reports" class="btn btn-outline-secondary">Batal</a>
            </div>
          </form>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
