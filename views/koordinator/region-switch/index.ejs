<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/pending' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Approval Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Approval Switch Region',
            pageSubtitle: 'Persetujuan permohonan akses wilayah operasional sementara bagi teknisi eksekutor lintas region.'
          }) %>

          <div class="card app-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <strong>Daftar Permohonan Menunggu Persetujuan</strong>
                <div class="text-muted small">Tinjau permohonan akses wilayah sementara dari teknisi eksekutor.</div>
              </div>
              <span class="badge text-bg-warning">Pending: <%= (requests || []).length %></span>
            </div>
            <div class="card-body p-0">
              <% if (!requests || requests.length === 0) { %>
                <div class="text-center text-muted p-4 app-table-empty">Tidak ada pengajuan switch region yang menunggu persetujuan.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead>
                      <tr>
                        <th class="app-col-num">No</th>
                        <th>Pemohon (Requester)</th>
                        <th>Region Asal</th>
                        <th>Region Tujuan</th>
                        <th>Alasan Pengajuan</th>
                        <th class="app-col-time">Waktu Pengajuan</th>
                        <th class="app-table-actions">Keputusan</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% (requests || []).forEach((request, index) => { %>
                        <tr>
                          <td class="app-col-num text-muted"><%= index + 1 %></td>
                          <td>
                            <div class="fw-semibold text-dark"><%= request.requester_name || '-' %></div>
                          </td>
                          <td>
                            <% if (request.home_region_code) { %>
                              <span class="badge text-bg-light border font-monospace me-1"><%= request.home_region_code %></span>
                            <% } %>
                            <span class="text-dark"><%= request.home_region_name || '-' %></span>
                          </td>
                          <td>
                            <% if (request.target_region_code) { %>
                              <span class="badge text-bg-primary font-monospace me-1"><%= request.target_region_code %></span>
                            <% } %>
                            <span class="fw-semibold text-dark"><%= request.target_region_name || '-' %></span>
                          </td>
                          <td>
                            <div class="app-truncate" title="<%= request.reason || '-' %>"><%= request.reason || '-' %></div>
                          </td>
                          <td class="text-nowrap">
                            <span class="text-muted small"><%= formatDateTime(request.requested_at) %></span>
                          </td>
                          <td class="app-table-actions text-nowrap">
                            <div class="d-flex gap-2">
                              <button
                                type="button"
                                class="btn btn-sm btn-success"
                                data-bs-toggle="modal"
                                data-bs-target="#approveModal<%= request.id %>"
                              >
                                Setujui
                              </button>
                              <button
                                type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectModal<%= request.id %>"
                              >
                                Tolak
                              </button>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>

                <!-- Modal Konfirmasi Persetujuan & Penolakan untuk Setiap Request -->
                <% (requests || []).forEach((request) => { %>
                  <!-- Modal Setujui (Approve) -->
                  <div
                    class="modal fade"
                    id="approveModal<%= request.id %>"
                    tabindex="-1"
                    aria-labelledby="approveModalLabel<%= request.id %>"
                    aria-hidden="true"
                  >
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title fs-6 fw-bold" id="approveModalLabel<%= request.id %>">
                            Konfirmasi Persetujuan Switch Region
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                        </div>
                        <div class="modal-body">
                          <p class="text-muted small mb-3">
                            Pastikan rincian permohonan akses wilayah sementara telah sesuai dengan kebutuhan operasional sebelum menyetujui.
                          </p>

                          <div class="border rounded p-3 bg-light mb-3">
                            <div class="row g-2 small">
                              <div class="col-4 text-muted">Pemohon</div>
                              <div class="col-8 fw-semibold text-dark"><%= request.requester_name || '-' %></div>

                              <div class="col-4 text-muted">Region Asal</div>
                              <div class="col-8">
                                <% if (request.home_region_code) { %>
                                  <span class="badge text-bg-light border font-monospace me-1"><%= request.home_region_code %></span>
                                <% } %>
                                <%= request.home_region_name || '-' %>
                              </div>

                              <div class="col-4 text-muted">Region Tujuan</div>
                              <div class="col-8">
                                <% if (request.target_region_code) { %>
                                  <span class="badge text-bg-primary font-monospace me-1"><%= request.target_region_code %></span>
                                <% } %>
                                <span class="fw-semibold text-dark"><%= request.target_region_name || '-' %></span>
                              </div>

                              <div class="col-4 text-muted">Waktu Pengajuan</div>
                              <div class="col-8 text-secondary"><%= formatDateTime(request.requested_at) %></div>

                              <div class="col-4 text-muted">Alasan Pengajuan</div>
                              <div class="col-8 text-break"><%= request.reason || '-' %></div>
                            </div>
                          </div>

                          <div class="small text-secondary">
                            Akses sementara akan segera diaktifkan untuk teknisi pemohon setelah persetujuan ini diproses.
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                          <form action="/region-switch/<%= request.id %>/approve" method="POST" class="m-0">
                            <button type="submit" class="btn btn-success">Ya, Setujui Pengajuan</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Modal Tolak (Reject) -->
                  <div
                    class="modal fade"
                    id="rejectModal<%= request.id %>"
                    tabindex="-1"
                    aria-labelledby="rejectModalLabel<%= request.id %>"
                    aria-hidden="true"
                  >
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <form action="/region-switch/<%= request.id %>/reject" method="POST" class="m-0">
                          <div class="modal-header">
                            <h5 class="modal-title fs-6 fw-bold text-danger" id="rejectModalLabel<%= request.id %>">
                              Konfirmasi Penolakan Switch Region
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                          </div>
                          <div class="modal-body">
                            <p class="text-muted small mb-3">
                              Permohonan yang ditolak tidak dapat diproses kembali. Berikan alasan penolakan yang jelas agar dapat dipahami oleh teknisi pemohon.
                            </p>

                            <div class="border rounded p-3 bg-light mb-3">
                              <div class="row g-2 small">
                                <div class="col-4 text-muted">Pemohon</div>
                                <div class="col-8 fw-semibold text-dark"><%= request.requester_name || '-' %></div>

                                <div class="col-4 text-muted">Pengalihan</div>
                                <div class="col-8">
                                  <%= request.home_region_name || '-' %> &rarr; <span class="fw-semibold"><%= request.target_region_name || '-' %></span>
                                </div>

                                <div class="col-4 text-muted">Alasan Awal</div>
                                <div class="col-8 text-break text-muted"><%= request.reason || '-' %></div>
                              </div>
                            </div>

                            <div class="mb-2">
                              <label for="rejectionReason<%= request.id %>" class="form-label small fw-semibold text-secondary">
                                Alasan Penolakan <span class="app-required">*</span>
                              </label>
                              <textarea
                                id="rejectionReason<%= request.id %>"
                                name="rejection_reason"
                                class="form-control"
                                rows="3"
                                placeholder="Tuliskan alasan penolakan permohonan..."
                                required
                              ></textarea>
                              <div class="form-text">Alasan penolakan wajib dicantumkan dan akan tampil pada riwayat pemohon.</div>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-danger">Tolak Pengajuan</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
