<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../../partials/sidebar', { activePath: '/region-switch/pending' }) %>

    <div class="app-main">
      <%- include('../../partials/topbar', { pageTitle: 'Approval Switch Region' }) %>

      <main class="app-page">
        <div class="app-page-content">
          <%- include('../../partials/flash') %>

          <%- include('../../partials/page-header', {
            pageTitle: 'Approval Switch Region',
            pageSubtitle: 'Proses pengajuan switch region (F007) yang masih pending. Approve/Reject akan mengubah status sesuai aturan yang sudah ada.'
          }) %>

          <div class="card app-card">
            <div class="card-body">
              <% if (!requests || requests.length === 0) { %>
                <div class="text-muted">Tidak ada pengajuan pending.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th style="width: 64px">No</th>
                        <th>Requester</th>
                        <th>Region Asal</th>
                        <th>Region Tujuan</th>
                        <th>Alasan</th>
                        <th class="text-nowrap">Requested At</th>
                        <th class="text-nowrap" style="width: 260px">Aksi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% (requests || []).forEach((request, index) => { %>
                        <tr>
                          <td><%= index + 1 %></td>
                          <td>
                            <div class="fw-semibold"><%= request.requester_name || '-' %></div>
                          </td>
                          <td><%= request.home_region_name || '-' %></td>
                          <td><%= request.target_region_name || '-' %></td>
                          <td>
                            <div class="app-truncate" title="<%= request.reason || '-' %>"><%= request.reason || '-' %></div>
                          </td>
                          <td class="text-nowrap">
                            <span class="text-muted"><%= formatDateTime(request.requested_at) %></span>
                          </td>
                          <td class="text-nowrap">
                            <div class="d-flex flex-wrap gap-2">
                              <form action="/region-switch/<%= request.id %>/approve" method="POST" class="m-0" onsubmit="return confirm('Approve pengajuan ini?');">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                              </form>

                              <form action="/region-switch/<%= request.id %>/reject" method="POST" class="m-0 d-flex gap-2 align-items-start flex-wrap">
                                <input
                                  type="text"
                                  name="rejection_reason"
                                  class="form-control form-control-sm"
                                  placeholder="Alasan penolakan"
                                  required
                                  style="min-width: 180px"
                                >
                                <button
                                  type="submit"
                                  class="btn btn-sm btn-danger"
                                  onclick="return confirm('Reject pengajuan ini?')"
                                >Reject</button>
                              </form>
                            </div>
                            <div class="form-text mt-2">Reject wajib menyertakan alasan.</div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js?v=flash-auto-dismiss-20260505-2"></script>
</body>
</html>
