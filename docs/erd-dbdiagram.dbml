Project "Sistem Penanganan Gangguan" {
  database_type: 'MySQL'
  Note: 'ERD inferred from the active Node.js models, Spec Kit feature docs, and available SQL migrations. Live database introspection was unavailable because local MySQL refused connection.'
}

Enum report_source_channel {
  telegram
  manual
}

Enum report_status_internal {
  baru
  tersedia
  diambil
  didelegasikan
  selesai
  perlu_tindak_lanjut
  eskalasi
}

Enum report_assignment_type {
  self_take
  delegation
}

Enum attachment_source {
  telegram
  completion
}

Enum telegram_media_status {
  pending
  linked
}

Enum region_switch_status {
  pending
  approved
  rejected
  expired
}

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique, note: "Expected values: pelapor, eksekutor, koordinator, supervisor, super_admin"]
}

Table regions {
  id int [pk, increment]
  code varchar(20) [not null, unique, note: "Example: PDG, BKT"]
  name varchar(100) [not null]
}

Table users {
  id int [pk, increment]
  full_name varchar(150) [not null]
  username varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  role_id int [not null]
  region_id int [note: "Required for eksekutor, nullable for coordinator/supervisor/super_admin"]
  is_active boolean [not null, default: true]
  created_at datetime
  updated_at datetime

  indexes {
    role_id
    region_id
    username [unique]
  }
}

Table reports {
  id int [pk, increment]
  source_channel report_source_channel [not null, default: 'telegram']
  fallout_type varchar(100)
  ticket_id varchar(100) [not null, unique]
  order_id varchar(100)
  wo_number varchar(100)
  service_type varchar(100)
  segment varchar(100)
  provider varchar(100)
  telkom_area varchar(100)
  branch_name varchar(150)
  cluster_name varchar(150)
  sto varchar(50)
  summary text [not null]
  service_id varchar(100)
  status_wfm varchar(100)
  status_andalas varchar(100)
  status_internal report_status_internal [not null, default: 'tersedia', note: 'App aktif membuat laporan baru dengan status tersedia; enum lama masih menyimpan baru']
  reported_region_id int [not null]
  current_region_id int [not null]
  current_assigned_user_id int
  telegram_chat_id varchar(64)
  telegram_message_id varchar(64)
  telegram_sender_id varchar(64)
  telegram_sender_username varchar(100)
  telegram_sender_first_name varchar(100)
  telegram_sender_last_name varchar(100)
  completion_notes text
  completion_status report_status_internal
  diit_code varchar(100)
  received_at datetime [not null]
  taken_at datetime
  resolved_at datetime
  closed_at datetime
  created_at datetime
  updated_at datetime

  indexes {
    ticket_id [unique]
    status_internal
    received_at
    (current_region_id, status_internal, id)
    (current_assigned_user_id, status_internal, id)
  }
}

Table report_assignments {
  id int [pk, increment]
  report_id int [not null]
  assigned_to_user_id int [not null]
  assigned_by_user_id int [not null]
  from_region_id int [not null]
  to_region_id int [not null]
  assignment_type report_assignment_type [not null]
  notes text
  is_active boolean [not null, default: true]
  assigned_at datetime [not null]

  indexes {
    report_id
    assigned_to_user_id
    assigned_by_user_id
    is_active
  }
}

Table report_logs {
  id int [pk, increment]
  report_id int [not null]
  user_id int
  action varchar(100) [not null]
  description text
  created_at datetime [not null]

  indexes {
    report_id
    user_id
    (report_id, created_at)
  }
}

Table report_attachments {
  id int [pk, increment]
  report_id int [not null]
  source attachment_source [not null, default: 'telegram', note: 'telegram = media pelapor, completion = bukti penyelesaian']
  telegram_file_id varchar(255)
  telegram_file_unique_id varchar(255)
  file_type varchar(50)
  mime_type varchar(120)
  original_name varchar(255)
  stored_name varchar(255)
  file_name varchar(255) [note: "Used by completion evidence upload"]
  file_path varchar(500)
  file_size bigint
  caption text
  uploaded_by_user_id int
  created_at datetime [not null]

  indexes {
    report_id
    source
    uploaded_by_user_id
  }
}

Table telegram_pending_media {
  id int [pk, increment]
  chat_id varchar(64) [not null]
  telegram_message_id varchar(64) [not null]
  telegram_file_id varchar(255)
  telegram_file_unique_id varchar(255)
  file_type varchar(50)
  mime_type varchar(120)
  original_name varchar(255)
  stored_name varchar(255)
  file_path varchar(500)
  file_size bigint
  caption text
  status telegram_media_status [not null, default: 'pending']
  linked_report_id int
  created_at datetime [not null]
  linked_at datetime

  indexes {
    chat_id
    status
    linked_report_id
    (chat_id, status, created_at)
  }
}

Table region_switch_requests {
  id int [pk, increment]
  requester_user_id int [not null]
  home_region_id int [not null]
  target_region_id int [not null]
  reason text [not null]
  status region_switch_status [not null, default: 'pending']
  requested_at datetime [not null]
  approved_by_user_id int
  approved_at datetime
  start_at datetime
  end_at datetime
  rejection_reason text
  created_at datetime
  updated_at datetime

  indexes {
    requester_user_id
    home_region_id
    target_region_id
    status
    (requester_user_id, target_region_id, status)
  }
}

Table manual_non_ticketing_reports {
  id int [pk, increment]
  report_date date
  details text
  osm_order_id varchar(100)
  sto varchar(50)
  sc varchar(100)
  order_ncx_id varchar(100)
  ncli varchar(100)
  customer_name varchar(150)
  alpro_before varchar(255)
  alpro_name varchar(255)
  ticket_incident varchar(100)
  incident text
  witel varchar(100)
  k_kontak varchar(100)
  user_id_text varchar(100)
  transaction_type varchar(100)
  fallout_type varchar(100)
  activity varchar(150)
  work_type varchar(150)
  ticket_resolved varchar(100)
  ticket_resolved_2 varchar(100)
  se_status varchar(100)
  region_id int
  created_by int
  updated_by int
  created_at datetime
  updated_at datetime

  indexes {
    report_date
    region_id
    created_by
    updated_by
  }
}

Table sessions {
  session_id varchar(128) [pk, note: "Created/used by express-mysql-session"]
  expires int [not null]
  data mediumtext
}

Ref: users.role_id > roles.id
Ref: users.region_id > regions.id

Ref: reports.reported_region_id > regions.id
Ref: reports.current_region_id > regions.id
Ref: reports.current_assigned_user_id > users.id

Ref: report_assignments.report_id > reports.id
Ref: report_assignments.assigned_to_user_id > users.id
Ref: report_assignments.assigned_by_user_id > users.id
Ref: report_assignments.from_region_id > regions.id
Ref: report_assignments.to_region_id > regions.id

Ref: report_logs.report_id > reports.id
Ref: report_logs.user_id > users.id

Ref: report_attachments.report_id > reports.id
Ref: report_attachments.uploaded_by_user_id > users.id

Ref: telegram_pending_media.linked_report_id > reports.id

Ref: region_switch_requests.requester_user_id > users.id
Ref: region_switch_requests.approved_by_user_id > users.id
Ref: region_switch_requests.home_region_id > regions.id
Ref: region_switch_requests.target_region_id > regions.id

Ref: manual_non_ticketing_reports.region_id > regions.id
Ref: manual_non_ticketing_reports.created_by > users.id
Ref: manual_non_ticketing_reports.updated_by > users.id
